      "text": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ ۝",
      "surah": 1,
      "segments": [
        { "key": "1:1", "text": "بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ ۝" }
      ],
      "width": 1
    },
    {
      "number": 3,
      "type": "ayah",
      "text": "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَ ۝١ۙ الرَّحْمٰنِ",
      "surah": 1,
      "segments": [
        { "key": "1:2", "text": "اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَ ۝١ۙ" },
