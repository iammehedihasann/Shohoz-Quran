      "width": 1
    },
    {
      "number": 6,
      "type": "ayah",
      "text": "اِهْدِنَا الصِّرَاطَ الْمُسْتَقِيْمَ ۝٥ۙ صِرَاطَ",
      "surah": 1,
      "segments": [
        { "key": "1:6", "text": "اِهْدِنَا الصِّرَاطَ الْمُسْتَقِيْمَ ۝٥ۙ" },
