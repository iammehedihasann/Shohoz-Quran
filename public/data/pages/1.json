      ],
      "width": 1
    },
    {
      "number": 4,
      "type": "ayah",
      "text": "الرَّحِيْمِ ۝٢ۙ مٰلِكِ يَوْمِ الدِّيْنِ ۝٣ؕ",
      "surah": 1,
      "segments": [
        { "key": "1:3", "text": "الرَّحِيْمِ ۝٢ۙ" },
        { "key": "1:4", "text": " مٰلِكِ يَوْمِ الدِّيْنِ ۝٣ؕ" }
      ],
      "width": 1
    },
    {
      "number": 5,
      "type": "ayah",
      "text": "اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُ ۝٤ؕ",
      "surah": 1,
      "segments": [
        {
          "key": "1:5",
          "text": "اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُ ۝٤ؕ"
