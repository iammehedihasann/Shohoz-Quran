{"number":599,"lines":[{"number":1,"type":"ayah","text":"وَفِرْعَوْنَ ذِي الْاَوْتَادِ ۝١٠ࣕۙ الَّذِيْنَ طَغَوْا فِي الْبِلَادِ ۝١١ࣕۙ","surah":89,"segments":[{"key":"89:10","text":"وَفِرْعَوْنَ ذِي الْاَوْتَادِ ۝١٠ࣕۙ"},{"key":"89:11","text":" الَّذِيْنَ طَغَوْا فِي الْبِلَادِ ۝١١ࣕۙ"}],"width":1},{"number":2,"type":"ayah","text":"فَاَكْثَرُوْا فِيْهَا الْفَسَادَ ۝١٢ࣕۙ فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ","surah":89,"segments":[{"key":"89:12","text":"فَاَكْثَرُوْا فِيْهَا الْفَسَادَ ۝١٢ࣕۙ"},{"key":"89:13","text":" فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ"}],"width":1},{"number":3,"type":"ayah","text":"عَذَابٍ ۝١٣ۚۙ اِنَّ رَبَّكَ لَبِالْمِرْصَادِ ۝١٤ؕ فَاَمَّا الْاِنْسَانُ اِذَا مَا","surah":89,"segments":[{"key":"89:13","text":"عَذَابٍ ۝١٣ۚۙ"},{"key":"89:14","text":" اِنَّ رَبَّكَ لَبِالْمِرْصَادِ ۝١٤ؕ"},{"key":"89:15","text":" فَاَمَّا الْاِنْسَانُ اِذَا مَا"}],"width":1},{"number":4,"type":"ayah","text":"ابْتَلٰىهُ رَبُّهٗ فَاَكْرَمَهٗ وَنَعَّمَهٗ࣢ۙ فَيَقُوْلُ رَبِّيْٓ اَكْرَمَنِ ۝١٥ؕ","surah":89,"segments":[{"key":"89:15","text":"ابْتَلٰىهُ رَبُّهٗ فَاَكْرَمَهٗ وَنَعَّمَهٗ࣢ۙ فَيَقُوْلُ رَبِّيْٓ اَكْرَمَنِ ۝١٥ؕ"}],"width":1},{"number":5,"type":"ayah","text":"وَاَمَّا͏ٓ اِذَا مَا ابْتَلٰىهُ فَقَدَرَ عَلَيْهِ رِزْقَهٗ࣢ۙ فَيَقُوْلُ","surah":89,"segments":[{"key":"89:16","text":"وَاَمَّا͏ٓ اِذَا مَا ابْتَلٰىهُ فَقَدَرَ عَلَيْهِ رِزْقَهٗ࣢ۙ فَيَقُوْلُ"}],"width":1},{"number":6,"type":"ayah","text":"رَبِّيْٓ اَهَانَنِ ۝١٦ۚ كَلَّا بَلْ لَّا تُكْرِمُوْنَ الْيَتِيْمَ ۝١٧ۙ وَلَا","surah":89,"segments":[{"key":"89:16","text":"رَبِّيْٓ اَهَانَنِ ۝١٦ۚ"},{"key":"89:17","text":" كَلَّا بَلْ لَّا تُكْرِمُوْنَ الْيَتِيْمَ ۝١٧ۙ"},{"key":"89:18","text":" وَلَا"}],"width":1},{"number":7,"type":"ayah","text":"تَحٰ࢜ضُّوْنَ عَلٰي طَعَامِ الْمِسْكِيْنِ ۝١٨ۙ وَتَاْكُلُوْنَ التُّرَاثَ","surah":89,"segments":[{"key":"89:18","text":"تَحٰ࢜ضُّوْنَ عَلٰي طَعَامِ الْمِسْكِيْنِ ۝١٨ۙ"},{"key":"89:19","text":" وَتَاْكُلُوْنَ التُّرَاثَ"}],"width":1},{"number":8,"type":"ayah","text":"اَكْلًا لَّمًّا ۝١٩ۙ وَّتُحِ