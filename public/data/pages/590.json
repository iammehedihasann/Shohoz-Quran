{"number":590,"lines":[{"number":1,"type":"ayah","text":"ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗ ۝٢١ۙ ثُمَّ اِذَا شَا࢜ءَ اَنْشَرَهٗ ۝٢٢ؕ كَلَّا لَمَّا","surah":80,"segments":[{"key":"80:21","text":"ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗ ۝٢١ۙ"},{"key":"80:22","text":" ثُمَّ اِذَا شَا࢜ءَ اَنْشَرَهٗ ۝٢٢ؕ"},{"key":"80:23","text":" كَلَّا لَمَّا"}],"width":1},{"number":2,"type":"ayah","text":"يَقْضِ مَا͏ٓ اَمَرَهٗ ۝٢٣ؕ فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۝٢٤ۙ اَنَّا","surah":80,"segments":[{"key":"80:23","text":"يَقْضِ مَا͏ٓ اَمَرَهٗ ۝٢٣ؕ"},{"key":"80:24","text":" فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۝٢٤ۙ"},{"key":"80:25","text":" اَنَّا"}],"width":1},{"number":3,"type":"ayah","text":"صَبَبْنَا الْمَا࢜ءَ صَبًّا ۝٢٥ۙ ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّا ۝٢٦ۙ فَاَنۢ͏ْبَتْنَا","surah":80,"segments":[{"key":"80:25","text":"صَبَبْنَا الْمَا࢜ءَ صَبًّا ۝٢٥ۙ"},{"key":"80:26","text":" ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّا ۝٢٦ۙ"},{"key":"80:27","text":" فَاَنۢ͏ْبَتْنَا"}],"width":1},{"number":4,"type":"ayah","text":"فِيْهَا حَبًّا ۝٢٧ۙ وَّعِنَبًا وَّقَضْبًا ۝٢٨ۙ وَّزَيْتُوْنًا وَّنَخْلًا ۝٢٩ۙ وَّحَدَا࢜ىِٕقَ","surah":80,"segments":[{"key":"80:27","text":"فِيْهَا حَبًّا ۝٢٧ۙ"},{"key":"80:28","text":" وَّعِنَبًا وَّقَضْبًا ۝٢٨ۙ"},{"key":"80:29","text":" وَّزَيْتُوْنًا وَّنَخْلًا ۝٢٩ۙ"},{"key":"80:30","text":" وَّحَدَا࢜ىِٕقَ"}],"width":1},{"number":5,"type":"ayah","text":"غُلْبًا ۝٣٠ۙ وَّفَاكِهَةً وَّاَبًّا ۝٣١ۙ مَّتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۝٣٢ؕ فَاِذَا","surah":80,"segments":[{"key":"80:30","text":"غُلْبًا ۝٣٠ۙ"},{"key":"80:31","text":" وَّفَاكِهَةً وَّاَبًّا ۝٣١ۙ"},{"key":"80:32","text":" مَّتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۝٣٢ؕ"},{"key":"80:33","text":" فَاِذَا"}],"width":1},{"number":6,"type":"ayah","text":"جَا࢜ءَتِ الصَّا࢜خَّةُ ۝٣٣ؗ يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِ ۝٣٤ۙ وَاُمِّهٖ","surah":80,"segments":[{"key":"80:33","text":"جَا࢜ءَتِ الصَّا࢜خَّةُ ۝٣٣ؗ"},{"key":"80:34","text":" يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِ ۝٣٤ۙ"},{"key":"80:35","text":" وَاُمِّهٖ"}],"width":1},{"number":7,"