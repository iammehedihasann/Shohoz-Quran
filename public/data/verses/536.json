[{"key":"56:52","surah":56,"ayah":52,"page":536,"text":"لَاٰكِلُوْنَ مِنْ شَجَرٍ مِّنْ زَقُّوْمٍ ۝٥٢ۙ"},{"key":"56:53","surah":56,"ayah":53,"page":536,"text":" فَمَالِـٔ͏ُوْنَ مِنْهَا الْبُطُوْنَ ۝٥٣ۚ"},{"key":"56:54","surah":56,"ayah":54,"page":536,"text":"فَشٰرِبُوْنَ عَلَيْهِ مِنَ الْحَمِيْمِ ۝٥٤ۚ"},{"key":"56:55","surah":56,"ayah":55,"page":536,"text":" فَشٰرِبُوْنَ شُرْبَ الْهِيْمِ ۝٥٥ؕ"},{"key":"56:56","surah":56,"ayah":56,"page":536,"text":"هٰذَا نُزُلُهُمْ يَوْمَ الدِّيْنِ ۝٥٦ؕ"},{"key":"56:57","surah":56,"ayah":57,"page":536,"text":" نَحْنُ خَلَقْنٰكُمْ فَلَوْلَا تُصَدِّقُوْنَ ۝٥٧"},{"key":"56:58","surah":56,"ayah":58,"page":536,"text":"اَفَرَءَيْتُمْ مَّا تُمْنُوْنَ ۝٥٨ؕ"},{"key":"56:59","surah":56,"ayah":59,"page":536,"text":" ءَاَنْتُمْ تَخْلُقُوْنَهٗٓ اَمْ نَحْنُ الْخٰلِقُوْنَ ۝٥٩"},{"key":"56:60","surah":56,"ayah":60,"page":536,"text":"نَحْنُ قَدَّرْنَا بَيْنَكُمُ الْمَوْتَ وَمَا نَحْنُ بِمَسْبُوْقِيْنَ ۝٦٠ۙ"},{"key":"56:61","surah":56,"ayah":61,"page":536,"text":" عَلٰٓي اَنْ نُّبَدِّلَ اَمْثَالَكُمْ وَنُنْشِي͏ٔ͏َكُمْ فِيْ مَا لَا تَعْلَمُوْنَ ۝٦١"},{"key":"56:62","surah":56,"ayah":62,"page":536,"text":" وَلَقَدْ عَلِمْتُمُ النَّشْاَةَ الْاُوْلٰي فَلَوْلَا تَذَكَّرُوْنَ ۝٦٢"},{"key":"56:63","surah":56,"ayah":63,"page":536,"text":" اَفَرَءَيْتُمْ مَّا تَحْرُثُوْنَ ۝٦٣ؕ"},{"key":"56:64","surah":56,"ayah":64,"page":536,"text":"ءَاَنْتُمْ تَزْرَعُوْنَهٗٓ اَمْ نَحْنُ الزّٰرِعُوْنَ ۝٦٤"},{"key":"56:65","surah":56,"ayah":65,"page":536,"text":" لَوْ نَشَا࢜ءُ لَجَعَلْنٰهُ حُطَامًا فَظَلْتُمْ تَفَكَّهُوْنَ ۝٦٥"},{"key":"56:66","surah":56,"ayah":66,"page":536,"text":" اِنَّا لَمُغْرَمُوْنَ ۝٦٦ۙ"},{"key":"56:67","surah":56,"ayah":67,"page":536,"text":" بَلْ نَحْنُ مَحْرُوْمُوْنَ ۝٦٧"},{"key":"56:68","surah":56,"ayah":68,"page":536,"text":"اَفَرَءَيْتُمُ الْمَا࢜ءَ الَّذِيْ تَشْرَبُوْنَ ۝٦٨ؕ"},{"key":"56:69","surah":56,"ayah":69,"page":536,"text":" ءَاَنْتُمْ اَنْزَلْتُمُوْهُ مِنَ الْمُزْنِ اَمْ نَحْنُ الْمُنْزِلُوْنَ ۝٦٩"},{"key":"56:70","surah":56,"ayah":70,"page":536,"text":" لَوْ نَشَا࢜ءُ جَعَلْنٰهُ اُجَاجًا فَلَوْلَا تَشْكُرُوْنَ ۝٧٠"},{"key":"56:71","surah":56,"ayah":71,"page":536,"text":" اَفَرَءَيْتُمُ النَّارَ الَّتِيْ تُوْرُوْنَ ۝٧١ؕ"},{"key":"56:72","surah":56,"ayah":72,"page":536,"text":" ءَاَنْتُمْ اَنْشَاْتُمْ شَجَرَتَهَا͏ٓ اَمْ نَحْنُ الْمُنْشِـٔ͏ُوْنَ ۝٧٢"},{"key":"56:73","surah":56,"ayah":73,"page":536,"text":" نَحْنُ جَعَلْنٰهَا تَذْكِرَةً وَّمَتَاعًا لِّلْمُقْوِيْنَ ۝٧٣ۚ"},{"key":"56:74","surah":56,"ayah":74,"page":536,"text":" فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيْمِ ۝٧٤ࣖ"},{"key":"56:75","surah":56,"ayah":75,"page":536,"text":" فَلَا͏ٓ اُقْسِمُ بِمَوٰقِعِ النُّجُوْمِ ۝٧٥ۙ"},{"key":"56:76","surah":56,"ayah":76,"page":536,"text":" وَاِنَّهٗ لَقَسَمٌ لَّوْ تَعْلَمُوْنَ عَظِيْمٌ ۝٧٦ۙ"}]