[{"key":"53:1","surah":53,"ayah":1,"page":526,"text":"وَالنَّجْمِ اِذَا هَوٰي ۝١ۙ"},{"key":"53:2","surah":53,"ayah":2,"page":526,"text":" مَا ضَلَّ صَاحِبُكُمْ وَمَا غَوٰي ۝٢ۚ"},{"key":"53:3","surah":53,"ayah":3,"page":526,"text":" وَمَا يَنْطِقُ عَنِ الْهَوٰي ۝٣ؕ"},{"key":"53:4","surah":53,"ayah":4,"page":526,"text":" اِنْ هُوَ اِلَّا وَحْيٌ يُّوْحٰي ۝٤ۙ"},{"key":"53:5","surah":53,"ayah":5,"page":526,"text":" عَلَّمَهٗ شَدِيْدُ الْقُوٰي ۝٥ۙ"},{"key":"53:6","surah":53,"ayah":6,"page":526,"text":" ذُوْ مِرَّةٍؕ فَاسْتَوٰي ۝٦ۙ"},{"key":"53:7","surah":53,"ayah":7,"page":526,"text":" وَهُوَ بِالْاُفُقِ الْاَعْلٰي ۝٧ؕ"},{"key":"53:8","surah":53,"ayah":8,"page":526,"text":" ثُمَّ دَنَا فَتَدَلّٰي ۝٨ۙ"},{"key":"53:9","surah":53,"ayah":9,"page":526,"text":" فَكَانَ قَابَ قَوْسَيْنِ اَوْ اَدْنٰي ۝٩ۚ"},{"key":"53:10","surah":53,"ayah":10,"page":526,"text":" فَاَوْحٰٓي اِلٰي عَبْدِهٖ مَا͏ٓ اَوْحٰي ۝١٠ؕ"},{"key":"53:11","surah":53,"ayah":11,"page":526,"text":" مَا كَذَبَ الْفُو͏ٔ͏َادُ مَا رَاٰي ۝١١"},{"key":"53:12","surah":53,"ayah":12,"page":526,"text":" اَفَتُمٰرُوْنَهٗ عَلٰي مَا يَرٰي ۝١٢"},{"key":"53:13","surah":53,"ayah":13,"page":526,"text":" وَلَقَدْ رَاٰهُ نَزْلَةً اُخْرٰي ۝١٣ۙ"},{"key":"53:14","surah":53,"ayah":14,"page":526,"text":" عِنْدَ سِدْرَةِ الْمُنْتَهٰي ۝١٤"},{"key":"53:15","surah":53,"ayah":15,"page":526,"text":"عِنْدَهَا جَنَّةُ الْمَاْوٰي ۝١٥ؕ"},{"key":"53:16","surah":53,"ayah":16,"page":526,"text":" اِذْ يَغْشَي السِّدْرَةَ مَا يَغْشٰي ۝١٦ۙ"},{"key":"53:17","surah":53,"ayah":17,"page":526,"text":" مَا زَاغَ الْبَصَرُ وَمَا طَغٰي ۝١٧"},{"key":"53:18","surah":53,"ayah":18,"page":526,"text":" لَقَدْ رَاٰي مِنْ اٰيٰتِ رَبِّهِ الْكُبْرٰي ۝١٨"},{"key":"53:19","surah":53,"ayah":19,"page":526,"text":" اَفَرَءَيْتُمُ اللّٰتَ وَالْعُزّٰي ۝١٩ۙ"},{"key":"53:20","surah":53,"ayah":20,"page":526,"text":" وَمَنٰوةَ الثَّالِثَةَ الْاُخْرٰي ۝٢٠"},{"key":"53:21","surah":53,"ayah":21,"page":526,"text":" اَلَكُمُ الذَّكَرُ وَلَهُ الْاُنْثٰي ۝٢١"},{"key":"53:22","surah":53,"ayah":22,"page":526,"text":" تِلْكَ اِذًا قِسْمَةٌ ضِيْزٰي ۝٢٢"},{"key":"53:23","surah":53,"ayah":23,"page":526,"text":" اِنْ هِيَ اِلَّا͏ٓ اَسْمَا࢜ءٌ سَمَّيْتُمُوْهَا͏ٓ اَنْتُمْ وَاٰبَا࢜و͏ٔ͏ُكُمْ مَّا͏ٓ اَنْزَلَ اللّٰهُ بِهَا مِنْ سُلْطٰنٍؕ اِنْ يَّتَّبِعُوْنَ اِلَّا الظَّنَّ وَمَا تَهْوَي الْاَنْفُسُۚ وَلَقَدْ جَا࢜ءَهُمْ مِّنْ رَّبِّهِمُ الْهُدٰي ۝٢٣ؕ"},{"key":"53:24","surah":53,"ayah":24,"page":526,"text":" اَمْ لِلْاِنْسَانِ مَا تَمَنّٰي ۝٢٤ؗۖ"},{"key":"53:25","surah":53,"ayah":25,"page":526,"text":" فَلِلّٰهِ الْاٰخِرَةُ وَالْاُوْلٰي ۝٢٥ࣖ"}]