[{"key":"70:5","surah":70,"ayah":5,"page":570,"text":"فَاصْبِرْ صَبْرًا جَمِيْلًا ۝٥"},{"key":"70:6","surah":70,"ayah":6,"page":570,"text":" اِنَّهُمْ يَرَوْنَهٗ بَعِيْدًا ۝٦ۙ"},{"key":"70:7","surah":70,"ayah":7,"page":570,"text":" وَّنَرٰىهُ قَرِيْبًا ۝٧ؕ"},{"key":"70:8","surah":70,"ayah":8,"page":570,"text":" يَوْمَ تَكُوْنُ السَّمَا࢜ءُ كَالْمُهْلِ ۝٨ۙ"},{"key":"70:9","surah":70,"ayah":9,"page":570,"text":" وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ ۝٩ۙ"},{"key":"70:10","surah":70,"ayah":10,"page":570,"text":" وَلَا يَسْـٔ͏َلُ حَمِيْمٌ حَمِيْمًا ۝١٠ۚۖ"},{"key":"70:11","surah":70,"ayah":11,"page":570,"text":" يُّبَصَّرُوْنَهُمْؕ يَوَدُّ الْمُجْرِمُ لَوْ يَفْتَدِيْ مِنْ عَذَابِ يَوْمِىِٕذٍۢ بِبَنِيْهِ ۝١١ۙ"},{"key":"70:12","surah":70,"ayah":12,"page":570,"text":" وَصَاحِبَتِهٖ وَاَخِيْهِ ۝١٢ۙ"},{"key":"70:13","surah":70,"ayah":13,"page":570,"text":" وَفَصِيْلَتِهِ الَّتِيْ تُـٔ͏ْوِيْهِ ۝١٣ۙ"},{"key":"70:14","surah":70,"ayah":14,"page":570,"text":" وَمَنْ فِي الْاَرْضِ جَمِيْعًاۙ ثُمَّ يُنْجِيْهِ ۝١٤ۙ"},{"key":"70:15","surah":70,"ayah":15,"page":570,"text":" كَلَّاؕ اِنَّهَا لَظٰي ۝١٥ۙ"},{"key":"70:16","surah":70,"ayah":16,"page":570,"text":" نَزَّاعَةً لِّلشَّوٰي ۝١٦ۚۖ"},{"key":"70:17","surah":70,"ayah":17,"page":570,"text":"تَدْعُوْا مَنْ اَدْبَرَ وَتَوَلّٰي ۝١٧ۙ"},{"key":"70:18","surah":70,"ayah":18,"page":570,"text":" وَجَمَعَ فَاَوْعٰي ۝١٨"},{"key":"70:19","surah":70,"ayah":19,"page":570,"text":" اِنَّ الْاِنْسَانَ خُلِقَ هَلُوْعًا ۝١٩ۙ"},{"key":"70:20","surah":70,"ayah":20,"page":570,"text":" اِذَا مَسَّهُ الشَّرُّ جَزُوْعًا ۝٢٠ۙ"},{"key":"70:21","surah":70,"ayah":21,"page":570,"text":" وَّاِذَا مَسَّهُ الْخَيْرُ مَنُوْعًا ۝٢١ۙ"},{"key":"70:22","surah":70,"ayah":22,"page":570,"text":" اِلَّا الْمُصَلِّيْنَ ۝٢٢ۙ"},{"key":"70:23","surah":70,"ayah":23,"page":570,"text":" الَّذِيْنَ هُمْ عَلٰي صَلَاتِهِمْ دَا࢜ىِٕمُوْنَ ۝٢٣ࣕۙ"},{"key":"70:24","surah":70,"ayah":24,"page":570,"text":" وَالَّذِيْنَ فِيْٓ اَمْوَالِهِمْ حَقٌّ مَّعْلُوْمٌ ۝٢٤ࣕۙ"},{"key":"70:25","surah":70,"ayah":25,"page":570,"text":" لِّلسَّا࢜ىِٕلِ وَالْمَحْرُوْمِ ۝٢٥ࣕۙ"},{"key":"70:26","surah":70,"ayah":26,"page":570,"text":" وَالَّذِيْنَ يُصَدِّقُوْنَ بِيَوْمِ الدِّيْنِ ۝٢٦ࣕۙ"},{"key":"70:27","surah":70,"ayah":27,"page":570,"text":" وَالَّذِيْنَ هُمْ مِّنْ عَذَابِ رَبِّهِمْ مُّشْفِقُوْنَ ۝٢٧ۚ"},{"key":"70:28","surah":70,"ayah":28,"page":570,"text":" اِنَّ عَذَابَ رَبِّهِمْ غَيْرُ مَاْمُوْنٍ ۝٢٨"},{"key":"70:29","surah":70,"ayah":29,"page":570,"text":" وَالَّذِيْنَ هُمْ لِفُرُوْجِهِمْ حٰفِظُوْنَ ۝٢٩ۙ"},{"key":"70:30","surah":70,"ayah":30,"page":570,"text":" اِلَّا عَلٰٓي اَزْوَاجِهِمْ اَوْ مَا مَلَكَتْ اَيْمَانُهُمْ فَاِنَّهُمْ غَيْرُ مَلُوْمِيْنَ ۝٣٠ۚ"},{"key":"70:31","surah":70,"ayah":31,"page":570,"text":"فَمَنِ ابْتَغٰي وَرَا࢜ءَ ذٰلِكَ فَاُولٰ࢜ىِٕكَ هُمُ الْعٰدُوْنَ ۝٣١ۚ"}]