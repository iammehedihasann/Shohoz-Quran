[{"key":"89:10","surah":89,"ayah":10,"page":599,"text":"وَفِرْعَوْنَ ذِي الْاَوْتَادِ ۝١٠ࣕۙ"},{"key":"89:11","surah":89,"ayah":11,"page":599,"text":" الَّذِيْنَ طَغَوْا فِي الْبِلَادِ ۝١١ࣕۙ"},{"key":"89:12","surah":89,"ayah":12,"page":599,"text":"فَاَكْثَرُوْا فِيْهَا الْفَسَادَ ۝١٢ࣕۙ"},{"key":"89:13","surah":89,"ayah":13,"page":599,"text":" فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ ۝١٣ۚۙ"},{"key":"89:14","surah":89,"ayah":14,"page":599,"text":" اِنَّ رَبَّكَ لَبِالْمِرْصَادِ ۝١٤ؕ"},{"key":"89:15","surah":89,"ayah":15,"page":599,"text":" فَاَمَّا الْاِنْسَانُ اِذَا مَا ابْتَلٰىهُ رَبُّهٗ فَاَكْرَمَهٗ وَنَعَّمَهٗ࣢ۙ فَيَقُوْلُ رَبِّيْٓ اَكْرَمَنِ ۝١٥ؕ"},{"key":"89:16","surah":89,"ayah":16,"page":599,"text":"وَاَمَّا͏ٓ اِذَا مَا ابْتَلٰىهُ فَقَدَرَ عَلَيْهِ رِزْقَهٗ࣢ۙ فَيَقُوْلُ رَبِّيْٓ اَهَانَنِ ۝١٦ۚ"},{"key":"89:17","surah":89,"ayah":17,"page":599,"text":" كَلَّا بَلْ لَّا تُكْرِمُوْنَ الْيَتِيْمَ ۝١٧ۙ"},{"key":"89:18","surah":89,"ayah":18,"page":599,"text":" وَلَا تَحٰ࢜ضُّوْنَ عَلٰي طَعَامِ الْمِسْكِيْنِ ۝١٨ۙ"},{"key":"89:19","surah":89,"ayah":19,"page":599,"text":" وَتَاْكُلُوْنَ التُّرَاثَ اَكْلًا لَّمًّا ۝١٩ۙ"},{"key":"89:20","surah":89,"ayah":20,"page":599,"text":" وَّتُحِبُّوْنَ الْمَالَ حُبًّا جَمًّا ۝٢٠ؕ"},{"key":"89:21","surah":89,"ayah":21,"page":599,"text":" كَلَّا͏ٓ اِذَا دُكَّتِ الْاَرْضُ دَكًّا دَكًّا ۝٢١ۙ"},{"key":"89:22","surah":89,"ayah":22,"page":599,"text":" وَّجَا࢜ءَ رَبُّكَ وَالْمَلَكُ صَفًّا صَفًّا ۝٢٢ۚ"},{"key":"89:23","surah":89,"ayah":23,"page":599,"text":" وَجِايْ࢜ءَ يَوْمَىِٕذٍۭ بِجَهَنَّمَ࣢ۙ يَوْمَىِٕذٍ يَّتَذَكَّرُ الْاِنْسَانُ وَاَنّٰي لَهُ الذِّكْرٰي ۝٢٣ؕ"},{"key":"89:24","surah":89,"ayah":24,"page":599,"text":" يَقُوْلُ يٰلَيْتَنِيْ قَدَّمْتُ لِحَيَاتِيْ ۝٢٤ۚ"},{"key":"89:25","surah":89,"ayah":25,"page":599,"text":" فَيَوْمَىِٕذٍ لَّا يُعَذِّبُ عَذَابَهٗٓ اَحَدٌ ۝٢٥ۙ"},{"key":"89:26","surah":89,"ayah":26,"page":599,"text":" وَّلَا يُوْثِقُ وَثَاقَهٗٓ اَحَدٌ ۝٢٦ؕ"},{"key":"89:27","surah":89,"ayah":27,"page":599,"text":" يٰٓاَيَّتُهَا النَّفْسُ الْمُطْمَىِٕنَّةُ ۝٢٧ࣗۖ"},{"key":"89:28","surah":89,"ayah":28,"page":599,"text":"ارْجِعِيْٓ اِلٰي رَبِّكِ رَاضِيَةً مَّرْضِيَّةً ۝٢٨ۚ"},{"key":"89:29","surah":89,"ayah":29,"page":599,"text":" فَادْخُلِيْ فِيْ عِبٰدِيْ ۝٢٩ۙ"},{"key":"89:30","surah":89,"ayah":30,"page":599,"text":" وَادْخُلِيْ جَنَّتِيْ ۝٣٠ࣖ"}]