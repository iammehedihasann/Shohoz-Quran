[{"key":"53:40","surah":53,"ayah":40,"page":528,"text":"وَاَنَّ سَعْيَهٗ سَوْفَ يُرٰي ۝٤٠ࣕ"},{"key":"53:41","surah":53,"ayah":41,"page":528,"text":" ثُمَّ يُجْزٰىهُ الْجَزَا࢜ءَ الْاَوْفٰي ۝٤١ۙ"},{"key":"53:42","surah":53,"ayah":42,"page":528,"text":"وَاَنَّ اِلٰي رَبِّكَ الْمُنْتَهٰي ۝٤٢ۙ"},{"key":"53:43","surah":53,"ayah":43,"page":528,"text":" وَاَنَّهٗ هُوَ اَضْحَكَ وَاَبْكٰي ۝٤٣ۙ"},{"key":"53:44","surah":53,"ayah":44,"page":528,"text":" وَاَنَّهٗ هُوَ اَمَاتَ وَاَحْيَا ۝٤٤ۙ"},{"key":"53:45","surah":53,"ayah":45,"page":528,"text":" وَاَنَّهٗ خَلَقَ الزَّوْجَيْنِ الذَّكَرَ وَالْاُنْثٰي ۝٤٥ۙ"},{"key":"53:46","surah":53,"ayah":46,"page":528,"text":" مِنْ نُّطْفَةٍ اِذَا تُمْنٰي ۝٤٦ࣕ"},{"key":"53:47","surah":53,"ayah":47,"page":528,"text":" وَاَنَّ عَلَيْهِ النَّشْاَةَ الْاُخْرٰي ۝٤٧ۙ"},{"key":"53:48","surah":53,"ayah":48,"page":528,"text":" وَاَنَّهٗ هُوَ اَغْنٰي وَاَقْنٰي ۝٤٨ۙ"},{"key":"53:49","surah":53,"ayah":49,"page":528,"text":" وَاَنَّهٗ هُوَ رَبُّ الشِّعْرٰي ۝٤٩ۙ"},{"key":"53:50","surah":53,"ayah":50,"page":528,"text":" وَاَنَّهٗٓ اَهْلَكَ عَادَا اࣙلْاُوْلٰي ۝٥٠ۙ"},{"key":"53:51","surah":53,"ayah":51,"page":528,"text":" وَثَمُوْدَا۟ فَمَا͏ٓ اَبْقٰي ۝٥١ۙ"},{"key":"53:52","surah":53,"ayah":52,"page":528,"text":" وَقَوْمَ نُوْحٍ مِّنْ قَبْلُؕ اِنَّهُمْ كَانُوْا هُمْ اَظْلَمَ وَاَطْغٰي ۝٥٢ؕ"},{"key":"53:53","surah":53,"ayah":53,"page":528,"text":" وَالْمُو͏ٔ͏ْتَفِكَةَ اَهْوٰي ۝٥٣ۙ"},{"key":"53:54","surah":53,"ayah":54,"page":528,"text":" فَغَشّٰىهَا مَا غَشّٰي ۝٥٤ۚ"},{"key":"53:55","surah":53,"ayah":55,"page":528,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكَ تَتَمَارٰي ۝٥٥"},{"key":"53:56","surah":53,"ayah":56,"page":528,"text":" هٰذَا نَذِيْرٌ مِّنَ النُّذُرِ الْاُوْلٰي ۝٥٦"},{"key":"53:57","surah":53,"ayah":57,"page":528,"text":" اَزِفَتِ الْاٰزِفَةُ ۝٥٧ۚ"},{"key":"53:58","surah":53,"ayah":58,"page":528,"text":" لَيْسَ لَهَا مِنْ دُوْنِ اللّٰهِ كَاشِفَةٌ ۝٥٨ؕ"},{"key":"53:59","surah":53,"ayah":59,"page":528,"text":"اَفَمِنْ هٰذَا الْحَدِيْثِ تَعْجَبُوْنَ ۝٥٩ۙ"},{"key":"53:60","surah":53,"ayah":60,"page":528,"text":" وَتَضْحَكُوْنَ وَلَا تَبْكُوْنَ ۝٦٠ۙ"},{"key":"53:61","surah":53,"ayah":61,"page":528,"text":"وَاَنْتُمْ سٰمِدُوْنَ ۝٦١"},{"key":"53:62","surah":53,"ayah":62,"page":528,"text":" فَاسْجُدُوْا لِلّٰهِ وَاعْبُدُوْا ۝٦٢ࣛࣖ"},{"key":"54:1","surah":54,"ayah":1,"page":528,"text":"اِقْتَرَبَتِ السَّاعَةُ وَانْشَقَّ الْقَمَرُ ۝١"},{"key":"54:2","surah":54,"ayah":2,"page":528,"text":" وَاِنْ يَّرَوْا اٰيَةً يُّعْرِضُوْا وَيَقُوْلُوْا سِحْرٌ مُّسْتَمِرٌّ ۝٢"},{"key":"54:3","surah":54,"ayah":3,"page":528,"text":" وَكَذَّبُوْا وَاتَّبَعُوْٓا اَهْوَا࢜ءَهُمْ وَكُلُّ اَمْرٍ مُّسْتَقِرٌّ ۝٣"}]