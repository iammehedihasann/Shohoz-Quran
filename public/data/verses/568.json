[{"key":"69:13","surah":69,"ayah":13,"page":568,"text":"فَاِذَا نُفِخَ فِي الصُّوْرِ نَفْخَةٌ وَّاحِدَةٌ ۝١٣ۙ"},{"key":"69:14","surah":69,"ayah":14,"page":568,"text":" وَّحُمِلَتِ الْاَرْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةً وَّاحِدَةً ۝١٤ۙ"},{"key":"69:15","surah":69,"ayah":15,"page":568,"text":" فَيَوْمَىِٕذٍ وَّقَعَتِ الْوَاقِعَةُ ۝١٥ۙ"},{"key":"69:16","surah":69,"ayah":16,"page":568,"text":" وَانْشَقَّتِ السَّمَا࢜ءُ فَهِيَ يَوْمَىِٕذٍ وَّاهِيَةٌ ۝١٦ۙ"},{"key":"69:17","surah":69,"ayah":17,"page":568,"text":"وَّالْمَلَكُ عَلٰٓي اَرْجَا࢜ىِٕهَاؕ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَىِٕذٍ ثَمٰنِيَةٌ ۝١٧ؕ"},{"key":"69:18","surah":69,"ayah":18,"page":568,"text":" يَوْمَىِٕذٍ تُعْرَضُوْنَ لَا تَخْفٰي مِنْكُمْ خَافِيَةٌ ۝١٨"},{"key":"69:19","surah":69,"ayah":19,"page":568,"text":"فَاَمَّا مَنْ اُوْتِيَ كِتٰبَهٗ بِيَمِيْنِهٖۙ فَيَقُوْلُ هَا࢜و͏ٔ͏ُمُ اقْرَءُوْا كِتٰبِيَهْ ۝١٩ۚ"},{"key":"69:20","surah":69,"ayah":20,"page":568,"text":" اِنِّيْ ظَنَنْتُ اَنِّيْ مُلٰقٍ حِسَابِيَهْ ۝٢٠ۚ"},{"key":"69:21","surah":69,"ayah":21,"page":568,"text":" فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍ ۝٢١ۙ"},{"key":"69:22","surah":69,"ayah":22,"page":568,"text":" فِيْ جَنَّةٍ عَالِيَةٍ ۝٢٢ۙ"},{"key":"69:23","surah":69,"ayah":23,"page":568,"text":" قُطُوْفُهَا دَانِيَةٌ ۝٢٣"},{"key":"69:24","surah":69,"ayah":24,"page":568,"text":"كُلُوْا وَاشْرَبُوْا هَنِيْ࢜ـٔ͏ًاۢ بِمَا͏ٓ اَسْلَفْتُمْ فِي الْاَيَّامِ الْخَالِيَةِ ۝٢٤"},{"key":"69:25","surah":69,"ayah":25,"page":568,"text":"وَاَمَّا مَنْ اُوْتِيَ كِتٰبَهٗ بِشِمَالِهٖ࣢ۙ فَيَقُوْلُ يٰلَيْتَنِيْ لَمْ اُوْتَ كِتٰبِيَهْ ۝٢٥ۚ"},{"key":"69:26","surah":69,"ayah":26,"page":568,"text":" وَلَمْ اَدْرِ مَا حِسَابِيَهْ ۝٢٦ۚ"},{"key":"69:27","surah":69,"ayah":27,"page":568,"text":" يٰلَيْتَهَا كَانَتِ الْقَاضِيَةَ ۝٢٧ۚ"},{"key":"69:28","surah":69,"ayah":28,"page":568,"text":" مَا͏ٓ اَغْنٰي عَنِّيْ مَالِيَهْ ۝٢٨ۚ"},{"key":"69:29","surah":69,"ayah":29,"page":568,"text":" هَلَكَ عَنِّيْ سُلْطٰنِيَهْ ۝٢٩ۚ"},{"key":"69:30","surah":69,"ayah":30,"page":568,"text":"خُذُوْهُ فَغُلُّوْهُ ۝٣٠ۙ"},{"key":"69:31","surah":69,"ayah":31,"page":568,"text":" ثُمَّ الْجَحِيْمَ صَلُّوْهُ ۝٣١ۙ"},{"key":"69:32","surah":69,"ayah":32,"page":568,"text":" ثُمَّ فِيْ سِلْسِلَةٍ ذَرْعُهَا سَبْعُوْنَ ذِرَاعًا فَاسْلُكُوْهُ ۝٣٢ؕ"},{"key":"69:33","surah":69,"ayah":33,"page":568,"text":" اِنَّهٗ كَانَ لَا يُو͏ٔ͏ْمِنُ بِاللّٰهِ الْعَظِيْمِ ۝٣٣ۙ"},{"key":"69:34","surah":69,"ayah":34,"page":568,"text":" وَلَا يَحُضُّ عَلٰي طَعَامِ الْمِسْكِيْنِ ۝٣٤ؕ"}]