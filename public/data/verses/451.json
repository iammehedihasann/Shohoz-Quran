[{"key":"37:134","surah":37,"ayah":134,"page":451,"text":"اِذْ نَجَّيْنٰهُ وَاَهْلَهٗٓ اَجْمَعِيْنَ ۝١٣٤ۙ"},{"key":"37:135","surah":37,"ayah":135,"page":451,"text":" اِلَّا عَجُوْزًا فِي الْغٰبِرِيْنَ ۝١٣٥"},{"key":"37:136","surah":37,"ayah":136,"page":451,"text":" ثُمَّ دَمَّرْنَا الْاٰخَرِيْنَ ۝١٣٦"},{"key":"37:137","surah":37,"ayah":137,"page":451,"text":" وَاِنَّكُمْ لَتَمُرُّوْنَ عَلَيْهِمْ مُّصْبِحِيْنَ ۝١٣٧ۙ"},{"key":"37:138","surah":37,"ayah":138,"page":451,"text":" وَبِالَّيْلِؕ اَفَلَا تَعْقِلُوْنَ ۝١٣٨ࣖ"},{"key":"37:139","surah":37,"ayah":139,"page":451,"text":" وَاِنَّ يُوْنُسَ لَمِنَ الْمُرْسَلِيْنَ ۝١٣٩ؕ"},{"key":"37:140","surah":37,"ayah":140,"page":451,"text":" اِذْ اَبَقَ اِلَي الْفُلْكِ الْمَشْحُوْنِ ۝١٤٠ۙ"},{"key":"37:141","surah":37,"ayah":141,"page":451,"text":" فَسَاهَمَ فَكَانَ مِنَ الْمُدْحَضِيْنَ ۝١٤١ۚ"},{"key":"37:142","surah":37,"ayah":142,"page":451,"text":" فَالْتَقَمَهُ الْحُوْتُ وَهُوَ مُلِيْمٌ ۝١٤٢"},{"key":"37:143","surah":37,"ayah":143,"page":451,"text":" فَلَوْلَا͏ٓ اَنَّهٗ كَانَ مِنَ الْمُسَبِّحِيْنَ ۝١٤٣ۙ"},{"key":"37:144","surah":37,"ayah":144,"page":451,"text":"لَلَبِثَ فِيْ بَطْنِهٖٓ اِلٰي يَوْمِ يُبْعَثُوْنَ ۝١٤٤ۚ"},{"key":"37:145","surah":37,"ayah":145,"page":451,"text":" فَنَبَذْنٰهُ بِالْعَرَا࢜ءِ وَهُوَ سَقِيْمٌ ۝١٤٥ۚ"},{"key":"37:146","surah":37,"ayah":146,"page":451,"text":" وَاَنۢ͏ْبَتْنَا عَلَيْهِ شَجَرَةً مِّنْ يَّقْطِيْنٍ ۝١٤٦ۚ"},{"key":"37:147","surah":37,"ayah":147,"page":451,"text":" وَاَرْسَلْنٰهُ اِلٰي مِاي͏ٔ͏َةِ اَلْفٍ اَوْ يَزِيْدُوْنَ ۝١٤٧ۚ"},{"key":"37:148","surah":37,"ayah":148,"page":451,"text":" فَاٰمَنُوْا فَمَتَّعْنٰهُمْ اِلٰي حِيْنٍ ۝١٤٨ؕ"},{"key":"37:149","surah":37,"ayah":149,"page":451,"text":"فَاسْتَفْتِهِمْ اَلِرَبِّكَ الْبَنَاتُ وَلَهُمُ الْبَنُوْنَ ۝١٤٩ۙ"},{"key":"37:150","surah":37,"ayah":150,"page":451,"text":" اَمْ خَلَقْنَا الْمَلٰ࢜ىِٕكَةَ اِنَاثًا وَّهُمْ شٰهِدُوْنَ ۝١٥٠"},{"key":"37:151","surah":37,"ayah":151,"page":451,"text":" اَلَا͏ٓ اِنَّهُمْ مِّنْ اِفْكِهِمْ لَيَقُوْلُوْنَ ۝١٥١ۙ"},{"key":"37:152","surah":37,"ayah":152,"page":451,"text":"وَلَدَ اللّٰهُۙ وَاِنَّهُمْ لَكٰذِبُوْنَ ۝١٥٢"},{"key":"37:153","surah":37,"ayah":153,"page":451,"text":" اَصْطَفَي الْبَنَاتِ عَلَي الْبَنِيْنَ ۝١٥٣ؕ"},{"key":"37:154","surah":37,"ayah":154,"page":451,"text":"مَا لَكُمْࣞ كَيْفَ تَحْكُمُوْنَ ۝١٥٤"},{"key":"37:155","surah":37,"ayah":155,"page":451,"text":" اَفَلَا تَذَكَّرُوْنَ ۝١٥٥ۚ"},{"key":"37:156","surah":37,"ayah":156,"page":451,"text":" اَمْ لَكُمْ سُلْطٰنٌ مُّبِيْنٌ ۝١٥٦ۙ"},{"key":"37:157","surah":37,"ayah":157,"page":451,"text":" فَاْتُوْا بِكِتٰبِكُمْ اِنْ كُنْتُمْ صٰدِقِيْنَ ۝١٥٧"},{"key":"37:158","surah":37,"ayah":158,"page":451,"text":" وَجَعَلُوْا بَيْنَهٗ وَبَيْنَ الْجِنَّةِ نَسَبًاؕ وَلَقَدْ عَلِمَتِ الْجِنَّةُ اِنَّهُمْ لَمُحْضَرُوْنَ ۝١٥٨ۙ"},{"key":"37:159","surah":37,"ayah":159,"page":451,"text":"سُبْحٰنَ اللّٰهِ عَمَّا يَصِفُوْنَ ۝١٥٩ۙ"},{"key":"37:160","surah":37,"ayah":160,"page":451,"text":" اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصِيْنَ ۝١٦٠"}]