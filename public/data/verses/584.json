[{"key":"76:31","surah":76,"ayah":31,"page":584,"text":"يُّدْخِلُ مَنْ يَّشَا࢜ءُ فِيْ رَحْمَتِهٖؕ وَالظّٰلِمِيْنَ اَعَدَّ لَهُمْ عَذَابًا اَلِيْمًا ۝٣١ࣖ"},{"key":"77:1","surah":77,"ayah":1,"page":584,"text":"وَالْمُرْسَلٰتِ عُرْفًا ۝١ۙ"},{"key":"77:2","surah":77,"ayah":2,"page":584,"text":" فَالْعٰصِفٰتِ عَصْفًا ۝٢ۙ"},{"key":"77:3","surah":77,"ayah":3,"page":584,"text":" وَّالنّٰشِرٰتِ نَشْرًا ۝٣ۙ"},{"key":"77:4","surah":77,"ayah":4,"page":584,"text":" فَالْفٰرِقٰتِ فَرْقًا ۝٤ۙ"},{"key":"77:5","surah":77,"ayah":5,"page":584,"text":" فَالْمُلْقِيٰتِ ذِكْرًا ۝٥ۙ"},{"key":"77:6","surah":77,"ayah":6,"page":584,"text":" عُذْرًا اَوْ نُذْرًا ۝٦ۙ"},{"key":"77:7","surah":77,"ayah":7,"page":584,"text":" اِنَّمَا تُوْعَدُوْنَ لَوَاقِعٌ ۝٧ؕ"},{"key":"77:8","surah":77,"ayah":8,"page":584,"text":" فَاِذَا النُّجُوْمُ طُمِسَتْ ۝٨ۙ"},{"key":"77:9","surah":77,"ayah":9,"page":584,"text":"وَاِذَا السَّمَا࢜ءُ فُرِجَتْ ۝٩ۙ"},{"key":"77:10","surah":77,"ayah":10,"page":584,"text":" وَاِذَا الْجِبَالُ نُسِفَتْ ۝١٠ۙ"},{"key":"77:11","surah":77,"ayah":11,"page":584,"text":" وَاِذَا الرُّسُلُ اُقِّتَتْ ۝١١ؕ"},{"key":"77:12","surah":77,"ayah":12,"page":584,"text":" لِاَيِّ يَوْمٍ اُجِّلَتْ ۝١٢ؕ"},{"key":"77:13","surah":77,"ayah":13,"page":584,"text":" لِيَوْمِ الْفَصْلِ ۝١٣ۚ"},{"key":"77:14","surah":77,"ayah":14,"page":584,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا يَوْمُ الْفَصْلِ ۝١٤ؕ"},{"key":"77:15","surah":77,"ayah":15,"page":584,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝١٥"},{"key":"77:16","surah":77,"ayah":16,"page":584,"text":"اَلَمْ نُهْلِكِ الْاَوَّلِيْنَ ۝١٦ؕ"},{"key":"77:17","surah":77,"ayah":17,"page":584,"text":" ثُمَّ نُتْبِعُهُمُ الْاٰخِرِيْنَ ۝١٧"},{"key":"77:18","surah":77,"ayah":18,"page":584,"text":" كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمِيْنَ ۝١٨"},{"key":"77:19","surah":77,"ayah":19,"page":584,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝١٩"},{"key":"77:20","surah":77,"ayah":20,"page":584,"text":" اَلَمْ نَخْلُقْكُّمْ مِّنْ مَّا࢜ءٍ مَّهِيْنٍ ۝٢٠ۙ"},{"key":"77:21","surah":77,"ayah":21,"page":584,"text":" فَجَعَلْنٰهُ فِيْ قَرَارٍ مَّكِيْنٍ ۝٢١ۙ"},{"key":"77:22","surah":77,"ayah":22,"page":584,"text":"اِلٰي قَدَرٍ مَّعْلُوْمٍ ۝٢٢ۙ"},{"key":"77:23","surah":77,"ayah":23,"page":584,"text":" فَقَدَرْنَاࣗۖ فَنِعْمَ الْقٰدِرُوْنَ ۝٢٣"},{"key":"77:24","surah":77,"ayah":24,"page":584,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٢٤"},{"key":"77:25","surah":77,"ayah":25,"page":584,"text":" اَلَمْ نَجْعَلِ الْاَرْضَ كِفَاتًا ۝٢٥ۙ"}]