[{"key":"54:45","surah":54,"ayah":45,"page":531,"text":"سَيُهْزَمُ الْجَمْعُ وَيُوَلُّوْنَ الدُّبُرَ ۝٤٥"},{"key":"54:46","surah":54,"ayah":46,"page":531,"text":" بَلِ السَّاعَةُ مَوْعِدُهُمْ وَالسَّاعَةُ اَدْهٰي وَاَمَرُّ ۝٤٦"},{"key":"54:47","surah":54,"ayah":47,"page":531,"text":" اِنَّ الْمُجْرِمِيْنَ فِيْ ضَلٰلٍ وَّسُعُرٍ ۝٤٧ۘ"},{"key":"54:48","surah":54,"ayah":48,"page":531,"text":" يَوْمَ يُسْحَبُوْنَ فِي النَّارِ عَلٰي وُجُوْهِهِمْؕ ذُوْقُوْا مَسَّ سَقَرَ ۝٤٨"},{"key":"54:49","surah":54,"ayah":49,"page":531,"text":" اِنَّا كُلَّ شَيْءٍ خَلَقْنٰهُ بِقَدَرٍ ۝٤٩"},{"key":"54:50","surah":54,"ayah":50,"page":531,"text":" وَمَا͏ٓ اَمْرُنَا͏ٓ اِلَّا وَاحِدَةٌ كَلَمْحٍۢ بِالْبَصَرِ ۝٥٠"},{"key":"54:51","surah":54,"ayah":51,"page":531,"text":"وَلَقَدْ اَهْلَكْنَا͏ٓ اَشْيَاعَكُمْ فَهَلْ مِنْ مُّدَّكِرٍ ۝٥١"},{"key":"54:52","surah":54,"ayah":52,"page":531,"text":" وَكُلُّ شَيْءٍ فَعَلُوْهُ فِي الزُّبُرِ ۝٥٢"},{"key":"54:53","surah":54,"ayah":53,"page":531,"text":" وَكُلُّ صَغِيْرٍ وَّكَبِيْرٍ مُّسْتَطَرٌ ۝٥٣"},{"key":"54:54","surah":54,"ayah":54,"page":531,"text":" اِنَّ الْمُتَّقِيْنَ فِيْ جَنّٰتٍ وَّنَهَرٍ ۝٥٤ۙ"},{"key":"54:55","surah":54,"ayah":55,"page":531,"text":" فِيْ مَقْعَدِ صِدْقٍ عِنْدَ مَلِيْكٍ مُّقْتَدِرٍ ۝٥٥ࣖ"},{"key":"55:1","surah":55,"ayah":1,"page":531,"text":"اَلرَّحْمٰنُ ۝١ۙ"},{"key":"55:2","surah":55,"ayah":2,"page":531,"text":" عَلَّمَ الْقُرْاٰنَ ۝٢ؕ"},{"key":"55:3","surah":55,"ayah":3,"page":531,"text":" خَلَقَ الْاِنْسَانَ ۝٣ۙ"},{"key":"55:4","surah":55,"ayah":4,"page":531,"text":" عَلَّمَهُ الْبَيَانَ ۝٤"},{"key":"55:5","surah":55,"ayah":5,"page":531,"text":"اَلشَّمْسُ وَالْقَمَرُ بِحُسْبَانٍ ۝٥ۙ"},{"key":"55:6","surah":55,"ayah":6,"page":531,"text":" وَّالنَّجْمُ وَالشَّجَرُ يَسْجُدٰنِ ۝٦"},{"key":"55:7","surah":55,"ayah":7,"page":531,"text":"وَالسَّمَا࢜ءَ رَفَعَهَا وَوَضَعَ الْمِيْزَانَ ۝٧ۙ"},{"key":"55:8","surah":55,"ayah":8,"page":531,"text":" اَلَّا تَطْغَوْا فِي الْمِيْزَانِ ۝٨"},{"key":"55:9","surah":55,"ayah":9,"page":531,"text":"وَاَقِيْمُوا الْوَزْنَ بِالْقِسْطِ وَلَا تُخْسِرُوا الْمِيْزَانَ ۝٩"},{"key":"55:10","surah":55,"ayah":10,"page":531,"text":" وَالْاَرْضَ وَضَعَهَا لِلْاَنَامِ ۝١٠ۙ"},{"key":"55:11","surah":55,"ayah":11,"page":531,"text":" فِيْهَا فَاكِهَةٌ وَّالنَّخْلُ ذَاتُ الْاَكْمَامِ ۝١١ۖ"},{"key":"55:12","surah":55,"ayah":12,"page":531,"text":"وَالْحَبُّ ذُو الْعَصْفِ وَالرَّيْحَانُ ۝١٢ۚ"},{"key":"55:13","surah":55,"ayah":13,"page":531,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝١٣"}]