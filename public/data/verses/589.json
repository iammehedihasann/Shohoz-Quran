[{"key":"79:39","surah":79,"ayah":39,"page":589,"text":"فَاِنَّ الْجَحِيْمَ هِيَ الْمَاْوٰي ۝٣٩ؕ"},{"key":"79:40","surah":79,"ayah":40,"page":589,"text":" وَاَمَّا مَنْ خَافَ مَقَامَ رَبِّهٖ وَنَهَي النَّفْسَ عَنِ الْهَوٰي ۝٤٠ۙ"},{"key":"79:41","surah":79,"ayah":41,"page":589,"text":" فَاِنَّ الْجَنَّةَ هِيَ الْمَاْوٰي ۝٤١ؕ"},{"key":"79:42","surah":79,"ayah":42,"page":589,"text":"يَسْـٔ͏َلُوْنَكَ عَنِ السَّاعَةِ اَيَّانَ مُرْسٰىهَا ۝٤٢ؕ"},{"key":"79:43","surah":79,"ayah":43,"page":589,"text":" فِيْمَ اَنْتَ مِنْ ذِكْرٰىهَا ۝٤٣ؕ"},{"key":"79:44","surah":79,"ayah":44,"page":589,"text":" اِلٰي رَبِّكَ مُنْتَهٰىهَا ۝٤٤ؕ"},{"key":"79:45","surah":79,"ayah":45,"page":589,"text":" اِنَّمَا͏ٓ اَنْتَ مُنْذِرُ مَنْ يَّخْشٰىهَا ۝٤٥ؕ"},{"key":"79:46","surah":79,"ayah":46,"page":589,"text":"كَاَنَّهُمْ يَوْمَ يَرَوْنَهَا لَمْ يَلْبَثُوْٓا اِلَّا عَشِيَّةً اَوْ ضُحٰىهَا ۝٤٦ࣖ"},{"key":"80:1","surah":80,"ayah":1,"page":589,"text":"عَبَسَ وَتَوَلّٰٓي ۝١ۙ"},{"key":"80:2","surah":80,"ayah":2,"page":589,"text":" اَنْ جَا࢜ءَهُ الْاَعْمٰى ۝٢ؕ"},{"key":"80:3","surah":80,"ayah":3,"page":589,"text":" وَمَا يُدْرِيْكَ لَعَلَّهٗ يَزَّكّٰٓي ۝٣ۙ"},{"key":"80:4","surah":80,"ayah":4,"page":589,"text":" اَوْ يَذَّكَّرُ فَتَنْفَعَهُ الذِّكْرٰى ۝٤ؕ"},{"key":"80:5","surah":80,"ayah":5,"page":589,"text":" اَمَّا مَنِ اسْتَغْنٰى ۝٥ۙ"},{"key":"80:6","surah":80,"ayah":6,"page":589,"text":"فَاَنْتَ لَهٗ تَصَدّٰى ۝٦ؕ"},{"key":"80:7","surah":80,"ayah":7,"page":589,"text":" وَمَا عَلَيْكَ اَلَّا يَزَّكّٰى ۝٧ؕ"},{"key":"80:8","surah":80,"ayah":8,"page":589,"text":" وَاَمَّا مَنْ جَا࢜ءَكَ يَسْعٰى ۝٨ۙ"},{"key":"80:9","surah":80,"ayah":9,"page":589,"text":" وَهُوَ يَخْشٰى ۝٩ۙ"},{"key":"80:10","surah":80,"ayah":10,"page":589,"text":" فَاَنْتَ عَنْهُ تَلَهّٰى ۝١٠ۚ"},{"key":"80:11","surah":80,"ayah":11,"page":589,"text":" كَلَّا͏ٓ اِنَّهَا تَذْكِرَةٌ ۝١١ۚ"},{"key":"80:12","surah":80,"ayah":12,"page":589,"text":" فَمَنْ شَا࢜ءَ ذَكَرَهٗ ۝١٢ۘ"},{"key":"80:13","surah":80,"ayah":13,"page":589,"text":" فِيْ صُحُفٍ مُّكَرَّمَةٍ ۝١٣ۙ"},{"key":"80:14","surah":80,"ayah":14,"page":589,"text":"مَّرْفُوْعَةٍ مُّطَهَّرَةٍۭ ۝١٤ۙ"},{"key":"80:15","surah":80,"ayah":15,"page":589,"text":" بِاَيْدِيْ سَفَرَةٍ ۝١٥ۙ"},{"key":"80:16","surah":80,"ayah":16,"page":589,"text":" كِرَامٍۭ بَرَرَةٍ ۝١٦ؕ"},{"key":"80:17","surah":80,"ayah":17,"page":589,"text":"قُتِلَ الْاِنْسَانُ مَا͏ٓ اَكْفَرَهٗ ۝١٧ؕ"},{"key":"80:18","surah":80,"ayah":18,"page":589,"text":" مِنْ اَيِّ شَيْءٍ خَلَقَهٗ ۝١٨ؕ"},{"key":"80:19","surah":80,"ayah":19,"page":589,"text":"مِنْ نُّطْفَةٍؕ خَلَقَهٗ فَقَدَّرَهٗ ۝١٩ۙ"},{"key":"80:20","surah":80,"ayah":20,"page":589,"text":" ثُمَّ السَّبِيْلَ يَسَّرَهٗ ۝٢٠ۙ"}]