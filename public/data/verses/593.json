[{"key":"83:11","surah":83,"ayah":11,"page":593,"text":"الَّذِيْنَ يُكَذِّبُوْنَ بِيَوْمِ الدِّيْنِ ۝١١ؕ"},{"key":"83:12","surah":83,"ayah":12,"page":593,"text":" وَمَا يُكَذِّبُ بِهٖٓ اِلَّا كُلُّ مُعْتَدٍ اَثِيْمٍ ۝١٢ۙ"},{"key":"83:13","surah":83,"ayah":13,"page":593,"text":" اِذَا تُتْلٰي عَلَيْهِ اٰيٰتُنَا قَالَ اَسَاطِيْرُ الْاَوَّلِيْنَ ۝١٣ؕ"},{"key":"83:14","surah":83,"ayah":14,"page":593,"text":" كَلَّا بَلْࣝ رَانَ عَلٰي قُلُوْبِهِمْ مَّا كَانُوْا يَكْسِبُوْنَ ۝١٤"},{"key":"83:15","surah":83,"ayah":15,"page":593,"text":" كَلَّا͏ٓ اِنَّهُمْ عَنْ رَّبِّهِمْ يَوْمَىِٕذٍ لَّمَحْجُوْبُوْنَ ۝١٥ؕ"},{"key":"83:16","surah":83,"ayah":16,"page":593,"text":"ثُمَّ اِنَّهُمْ لَصَالُوا الْجَحِيْمِ ۝١٦ؕ"},{"key":"83:17","surah":83,"ayah":17,"page":593,"text":" ثُمَّ يُقَالُ هٰذَا الَّذِيْ كُنْتُمْ بِهٖ تُكَذِّبُوْنَ ۝١٧ؕ"},{"key":"83:18","surah":83,"ayah":18,"page":593,"text":" كَلَّا͏ٓ اِنَّ كِتٰبَ الْاَبْرَارِ لَفِيْ عِلِّيِّيْنَ ۝١٨ؕ"},{"key":"83:19","surah":83,"ayah":19,"page":593,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا عِلِّيُّوْنَ ۝١٩ؕ"},{"key":"83:20","surah":83,"ayah":20,"page":593,"text":" كِتٰبٌ مَّرْقُوْمٌ ۝٢٠ۙ"},{"key":"83:21","surah":83,"ayah":21,"page":593,"text":" يَّشْهَدُهُ الْمُقَرَّبُوْنَ ۝٢١ؕ"},{"key":"83:22","surah":83,"ayah":22,"page":593,"text":"اِنَّ الْاَبْرَارَ لَفِيْ نَعِيْمٍ ۝٢٢ۙ"},{"key":"83:23","surah":83,"ayah":23,"page":593,"text":" عَلَي الْاَرَا࢜ىِٕكِ يَنْظُرُوْنَ ۝٢٣ۙ"},{"key":"83:24","surah":83,"ayah":24,"page":593,"text":"تَعْرِفُ فِيْ وُجُوْهِهِمْ نَضْرَةَ النَّعِيْمِ ۝٢٤ۚ"},{"key":"83:25","surah":83,"ayah":25,"page":593,"text":" يُسْقَوْنَ مِنْ رَّحِيْقٍ مَّخْتُوْمٍ ۝٢٥ۙ"},{"key":"83:26","surah":83,"ayah":26,"page":593,"text":" خِتٰمُهٗ مِسْكٌؕ وَفِيْ ذٰلِكَ فَلْيَتَنَافَسِ الْمُتَنَافِسُوْنَ ۝٢٦ؕ"},{"key":"83:27","surah":83,"ayah":27,"page":593,"text":" وَمِزَاجُهٗ مِنْ تَسْنِيْمٍ ۝٢٧ۙ"},{"key":"83:28","surah":83,"ayah":28,"page":593,"text":" عَيْنًا يَّشْرَبُ بِهَا الْمُقَرَّبُوْنَ ۝٢٨ؕ"},{"key":"83:29","surah":83,"ayah":29,"page":593,"text":" اِنَّ الَّذِيْنَ اَجْرَمُوْا كَانُوْا مِنَ الَّذِيْنَ اٰمَنُوْا يَضْحَكُوْنَ ۝٢٩ؗۖ"},{"key":"83:30","surah":83,"ayah":30,"page":593,"text":" وَاِذَا مَرُّوْا بِهِمْ يَتَغَامَزُوْنَ ۝٣٠ؗۖ"},{"key":"83:31","surah":83,"ayah":31,"page":593,"text":" وَاِذَا انْقَلَبُوْٓا اِلٰٓي اَهْلِهِمُ انْقَلَبُوْا فَكِهِيْنَ ۝٣١ؗۖ"},{"key":"83:32","surah":83,"ayah":32,"page":593,"text":" وَاِذَا رَاَوْهُمْ قَالُوْٓا اِنَّ هٰٓو͏ٔ͏ُلَا࢜ءِ لَضَا࢜لُّوْنَ ۝٣٢ۙ"},{"key":"83:33","surah":83,"ayah":33,"page":593,"text":" وَمَا͏ٓ اُرْسِلُوْا عَلَيْهِمْ حٰفِظِيْنَ ۝٣٣ؕ"}]