[{"key":"95:1","surah":95,"ayah":1,"page":603,"text":"وَالتِّيْنِ وَالزَّيْتُوْنِ ۝١ۙ"},{"key":"95:2","surah":95,"ayah":2,"page":603,"text":" وَطُوْرِ سِيْنِيْنَ ۝٢ۙ"},{"key":"95:3","surah":95,"ayah":3,"page":603,"text":" وَهٰذَا الْبَلَدِ الْاَمِيْنِ ۝٣ۙ"},{"key":"95:4","surah":95,"ayah":4,"page":603,"text":" لَقَدْ خَلَقْنَا الْاِنْسَانَ فِيْٓ اَحْسَنِ تَقْوِيْمٍ ۝٤ؗ"},{"key":"95:5","surah":95,"ayah":5,"page":603,"text":" ثُمَّ رَدَدْنٰهُ اَسْفَلَ سٰفِلِيْنَ ۝٥ۙ"},{"key":"95:6","surah":95,"ayah":6,"page":603,"text":"اِلَّا الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ فَلَهُمْ اَجْرٌ غَيْرُ مَمْنُوْنٍ ۝٦ؕ"},{"key":"95:7","surah":95,"ayah":7,"page":603,"text":"فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّيْنِ ۝٧ؕ"},{"key":"95:8","surah":95,"ayah":8,"page":603,"text":" اَلَيْسَ اللّٰهُ بِاَحْكَمِ الْحٰكِمِيْنَ ۝٨ࣖ"},{"key":"96:1","surah":96,"ayah":1,"page":603,"text":"اِقْرَاْ بِاسْمِ رَبِّكَ الَّذِيْ خَلَقَ ۝١ۚ"},{"key":"96:2","surah":96,"ayah":2,"page":603,"text":" خَلَقَ الْاِنْسَانَ مِنْ عَلَقٍ ۝٢ۚ"},{"key":"96:3","surah":96,"ayah":3,"page":603,"text":"اِقْرَاْ وَرَبُّكَ الْاَكْرَمُ ۝٣ۙ"},{"key":"96:4","surah":96,"ayah":4,"page":603,"text":" الَّذِيْ عَلَّمَ بِالْقَلَمِ ۝٤ۙ"},{"key":"96:5","surah":96,"ayah":5,"page":603,"text":" عَلَّمَ الْاِنْسَانَ مَا لَمْ يَعْلَمْ ۝٥ؕ"},{"key":"96:6","surah":96,"ayah":6,"page":603,"text":" كَلَّا͏ٓ اِنَّ الْاِنْسَانَ لَيَطْغٰٓي ۝٦ۙ"},{"key":"96:7","surah":96,"ayah":7,"page":603,"text":" اَنْ رَّاٰهُ اسْتَغْنٰي ۝٧ؕ"},{"key":"96:8","surah":96,"ayah":8,"page":603,"text":" اِنَّ اِلٰي رَبِّكَ الرُّجْعٰي ۝٨ؕ"},{"key":"96:9","surah":96,"ayah":9,"page":603,"text":" اَرَءَيْتَ الَّذِيْ يَنْهٰي ۝٩ۙ"},{"key":"96:10","surah":96,"ayah":10,"page":603,"text":" عَبْدًا اِذَا صَلّٰي ۝١٠ؕ"},{"key":"96:11","surah":96,"ayah":11,"page":603,"text":" اَرَءَيْتَ اِنْ كَانَ عَلَي الْهُدٰٓي ۝١١ۙ"},{"key":"96:12","surah":96,"ayah":12,"page":603,"text":" اَوْ اَمَرَ بِالتَّقْوٰي ۝١٢ؕ"},{"key":"96:13","surah":96,"ayah":13,"page":603,"text":" اَرَءَيْتَ اِنْ كَذَّبَ وَتَوَلّٰي ۝١٣ؕ"},{"key":"96:14","surah":96,"ayah":14,"page":603,"text":" اَلَمْ يَعْلَمْ بِاَنَّ اللّٰهَ يَرٰي ۝١٤ؕ"},{"key":"96:15","surah":96,"ayah":15,"page":603,"text":" كَلَّا لَىِٕنْ لَّمْ يَنْتَهِ࣢ۙ لَنَسْفَعًاۢ بِالنَّاصِيَةِ ۝١٥ۙ"},{"key":"96:16","surah":96,"ayah":16,"page":603,"text":" نَاصِيَةٍ كَاذِبَةٍ خَاطِي͏ٔ͏َةٍ ۝١٦ۚ"},{"key":"96:17","surah":96,"ayah":17,"page":603,"text":" فَلْيَدْعُ نَادِيَهٗ ۝١٧ۙ"}]