[{"key":"26:91","surah":26,"ayah":91,"page":371,"text":"وَبُرِّزَتِ الْجَحِيْمُ لِلْغٰوِيْنَ ۝٩١ۙ"},{"key":"26:92","surah":26,"ayah":92,"page":371,"text":" وَقِيْلَ لَهُمْ اَيْنَ مَا كُنْتُمْ تَعْبُدُوْنَ ۝٩٢ۙ"},{"key":"26:93","surah":26,"ayah":93,"page":371,"text":"مِنْ دُوْنِ اللّٰهِؕ هَلْ يَنْصُرُوْنَكُمْ اَوْ يَنْتَصِرُوْنَ ۝٩٣ؕ"},{"key":"26:94","surah":26,"ayah":94,"page":371,"text":" فَكُبْكِبُوْا فِيْهَا هُمْ وَالْغَاوٗنَ ۝٩٤ۙ"},{"key":"26:95","surah":26,"ayah":95,"page":371,"text":" وَجُنُوْدُ اِبْلِيْسَ اَجْمَعُوْنَ ۝٩٥ؕ"},{"key":"26:96","surah":26,"ayah":96,"page":371,"text":" قَالُوْا وَهُمْ فِيْهَا يَخْتَصِمُوْنَ ۝٩٦ۙ"},{"key":"26:97","surah":26,"ayah":97,"page":371,"text":" تَاللّٰهِ اِنْ كُنَّا لَفِيْ ضَلٰلٍ مُّبِيْنٍ ۝٩٧ۙ"},{"key":"26:98","surah":26,"ayah":98,"page":371,"text":" اِذْ نُسَوِّيْكُمْ بِرَبِّ الْعٰلَمِيْنَ ۝٩٨"},{"key":"26:99","surah":26,"ayah":99,"page":371,"text":" وَمَا͏ٓ اَضَلَّنَا͏ٓ اِلَّا الْمُجْرِمُوْنَ ۝٩٩"},{"key":"26:100","surah":26,"ayah":100,"page":371,"text":" فَمَا لَنَا مِنْ شَافِعِيْنَ ۝١٠٠ۙ"},{"key":"26:101","surah":26,"ayah":101,"page":371,"text":" وَلَا صَدِيْقٍ حَمِيْمٍ ۝١٠١"},{"key":"26:102","surah":26,"ayah":102,"page":371,"text":" فَلَوْ اَنَّ لَنَا كَرَّةً فَنَكُوْنَ مِنَ الْمُو͏ٔ͏ْمِنِيْنَ ۝١٠٢"},{"key":"26:103","surah":26,"ayah":103,"page":371,"text":" اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝١٠٣"},{"key":"26:104","surah":26,"ayah":104,"page":371,"text":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝١٠٤ࣖ"},{"key":"26:105","surah":26,"ayah":105,"page":371,"text":" كَذَّبَتْ قَوْمُ نُوْحِ اࣙلْمُرْسَلِيْنَ ۝١٠٥ۚۖ"},{"key":"26:106","surah":26,"ayah":106,"page":371,"text":"اِذْ قَالَ لَهُمْ اَخُوْهُمْ نُوْحٌ اَلَا تَتَّقُوْنَ ۝١٠٦ۚ"},{"key":"26:107","surah":26,"ayah":107,"page":371,"text":" اِنِّيْ لَكُمْ رَسُوْلٌ اَمِيْنٌ ۝١٠٧ۙ"},{"key":"26:108","surah":26,"ayah":108,"page":371,"text":"فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١٠٨ۚ"},{"key":"26:109","surah":26,"ayah":109,"page":371,"text":" وَمَا͏ٓ اَسْـٔ͏َلُكُمْ عَلَيْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِيَ اِلَّا عَلٰي رَبِّ الْعٰلَمِيْنَ ۝١٠٩ۚ"},{"key":"26:110","surah":26,"ayah":110,"page":371,"text":" فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١١٠ؕ"},{"key":"26:111","surah":26,"ayah":111,"page":371,"text":" قَالُوْٓا اَنُو͏ٔ͏ْمِنُ لَكَ وَاتَّبَعَكَ الْاَرْذَلُوْنَ ۝١١١ؕ"},{"key":"26:112","surah":26,"ayah":112,"page":371,"text":" قَالَ وَمَا عِلْمِيْ بِمَا كَانُوْا يَعْمَلُوْنَ ۝١١٢ۚ"},{"key":"26:113","surah":26,"ayah":113,"page":371,"text":"اِنْ حِسَابُهُمْ اِلَّا عَلٰي رَبِّيْ لَوْ تَشْعُرُوْنَ ۝١١٣ۚ"},{"key":"26:114","surah":26,"ayah":114,"page":371,"text":" وَمَا͏ٓ اَنَا بِطَارِدِ الْمُو͏ٔ͏ْمِنِيْنَ ۝١١٤ۚ"},{"key":"26:115","surah":26,"ayah":115,"page":371,"text":"اِنْ اَنَا اِلَّا نَذِيْرٌ مُّبِيْنٌ ۝١١٥ؕ"},{"key":"26:116","surah":26,"ayah":116,"page":371,"text":" قَالُوْا لَىِٕنْ لَّمْ تَنْتَهِ يٰنُوْحُ لَتَكُوْنَنَّ مِنَ الْمَرْجُوْمِيْنَ ۝١١٦ؕ"},{"key":"26:117","surah":26,"ayah":117,"page":371,"text":" قَالَ رَبِّ اِنَّ قَوْمِيْ كَذَّبُوْنِ ۝١١٧ۚۖ"}]