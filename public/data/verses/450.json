[{"key":"37:108","surah":37,"ayah":108,"page":450,"text":"وَتَرَكْنَا عَلَيْهِ فِي الْاٰخِرِيْنَ ۝١٠٨ۖ"},{"key":"37:109","surah":37,"ayah":109,"page":450,"text":" سَلٰمٌ عَلٰٓي اِبْرٰهِيْمَ ۝١٠٩"},{"key":"37:110","surah":37,"ayah":110,"page":450,"text":" كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝١١٠"},{"key":"37:111","surah":37,"ayah":111,"page":450,"text":" اِنَّهٗ مِنْ عِبَادِنَا الْمُو͏ٔ͏ْمِنِيْنَ ۝١١١"},{"key":"37:112","surah":37,"ayah":112,"page":450,"text":" وَبَشَّرْنٰهُ بِاِسْحٰقَ نَبِيًّا مِّنَ الصّٰلِحِيْنَ ۝١١٢"},{"key":"37:113","surah":37,"ayah":113,"page":450,"text":" وَبٰرَكْنَا عَلَيْهِ وَعَلٰٓي اِسْحٰقَؕ وَمِنْ ذُرِّيَّتِهِمَا مُحْسِنٌ وَّظَالِمٌ لِّنَفْسِهٖ مُبِيْنٌ ۝١١٣ࣖ"},{"key":"37:114","surah":37,"ayah":114,"page":450,"text":" وَلَقَدْ مَنَنَّا عَلٰي مُوْسٰي وَهٰرُوْنَ ۝١١٤ۚ"},{"key":"37:115","surah":37,"ayah":115,"page":450,"text":" وَنَجَّيْنٰهُمَا وَقَوْمَهُمَا مِنَ الْكَرْبِ الْعَظِيْمِ ۝١١٥ۚ"},{"key":"37:116","surah":37,"ayah":116,"page":450,"text":" وَنَصَرْنٰهُمْ فَكَانُوْا هُمُ الْغٰلِبِيْنَ ۝١١٦ۚ"},{"key":"37:117","surah":37,"ayah":117,"page":450,"text":" وَاٰتَيْنٰهُمَا الْكِتٰبَ الْمُسْتَبِيْنَ ۝١١٧ۚ"},{"key":"37:118","surah":37,"ayah":118,"page":450,"text":" وَهَدَيْنٰهُمَا الصِّرَاطَ الْمُسْتَقِيْمَ ۝١١٨ۚ"},{"key":"37:119","surah":37,"ayah":119,"page":450,"text":" وَتَرَكْنَا عَلَيْهِمَا فِي الْاٰخِرِيْنَ ۝١١٩ۙ"},{"key":"37:120","surah":37,"ayah":120,"page":450,"text":" سَلٰمٌ عَلٰي مُوْسٰي وَهٰرُوْنَ ۝١٢٠"},{"key":"37:121","surah":37,"ayah":121,"page":450,"text":" اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝١٢١"},{"key":"37:122","surah":37,"ayah":122,"page":450,"text":" اِنَّهُمَا مِنْ عِبَادِنَا الْمُو͏ٔ͏ْمِنِيْنَ ۝١٢٢"},{"key":"37:123","surah":37,"ayah":123,"page":450,"text":" وَاِنَّ اِلْيَاسَ لَمِنَ الْمُرْسَلِيْنَ ۝١٢٣ؕ"},{"key":"37:124","surah":37,"ayah":124,"page":450,"text":" اِذْ قَالَ لِقَوْمِهٖٓ اَلَا تَتَّقُوْنَ ۝١٢٤"},{"key":"37:125","surah":37,"ayah":125,"page":450,"text":" اَتَدْعُوْنَ بَعْلًا وَّتَذَرُوْنَ اَحْسَنَ الْخَالِقِيْنَ ۝١٢٥ۙ"},{"key":"37:126","surah":37,"ayah":126,"page":450,"text":" اللّٰهَ رَبَّكُمْ وَرَبَّ اٰبَا࢜ىِٕكُمُ الْاَوَّلِيْنَ ۝١٢٦"},{"key":"37:127","surah":37,"ayah":127,"page":450,"text":" فَكَذَّبُوْهُ فَاِنَّهُمْ لَمُحْضَرُوْنَ ۝١٢٧ۙ"},{"key":"37:128","surah":37,"ayah":128,"page":450,"text":" اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصِيْنَ ۝١٢٨"},{"key":"37:129","surah":37,"ayah":129,"page":450,"text":" وَتَرَكْنَا عَلَيْهِ فِي الْاٰخِرِيْنَ ۝١٢٩ۙ"},{"key":"37:130","surah":37,"ayah":130,"page":450,"text":" سَلٰمٌ عَلٰٓي اِلْيَاسِيْنَ ۝١٣٠"},{"key":"37:131","surah":37,"ayah":131,"page":450,"text":" اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝١٣١"},{"key":"37:132","surah":37,"ayah":132,"page":450,"text":" اِنَّهٗ مِنْ عِبَادِنَا الْمُو͏ٔ͏ْمِنِيْنَ ۝١٣٢"},{"key":"37:133","surah":37,"ayah":133,"page":450,"text":" وَاِنَّ لُوْطًا لَّمِنَ الْمُرْسَلِيْنَ ۝١٣٣ؕ"}]