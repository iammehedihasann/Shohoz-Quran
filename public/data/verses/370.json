[{"key":"26:65","surah":26,"ayah":65,"page":370,"text":"وَاَنْجَيْنَا مُوْسٰي وَمَنْ مَّعَهٗٓ اَجْمَعِيْنَ ۝٦٥ۚ"},{"key":"26:66","surah":26,"ayah":66,"page":370,"text":" ثُمَّ اَغْرَقْنَا الْاٰخَرِيْنَ ۝٦٦ؕ"},{"key":"26:67","surah":26,"ayah":67,"page":370,"text":"اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝٦٧"},{"key":"26:68","surah":26,"ayah":68,"page":370,"text":" وَاِنَّ رَبَّكَ لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝٦٨ࣖ"},{"key":"26:69","surah":26,"ayah":69,"page":370,"text":" وَاتْلُ عَلَيْهِمْ نَبَاَ اِبْرٰهِيْمَ ۝٦٩ۘ"},{"key":"26:70","surah":26,"ayah":70,"page":370,"text":" اِذْ قَالَ لِاَبِيْهِ وَقَوْمِهٖ مَا تَعْبُدُوْنَ ۝٧٠"},{"key":"26:71","surah":26,"ayah":71,"page":370,"text":" قَالُوْا نَعْبُدُ اَصْنَامًا فَنَظَلُّ لَهَا عٰكِفِيْنَ ۝٧١"},{"key":"26:72","surah":26,"ayah":72,"page":370,"text":"قَالَ هَلْ يَسْمَعُوْنَكُمْ اِذْ تَدْعُوْنَ ۝٧٢ۙ"},{"key":"26:73","surah":26,"ayah":73,"page":370,"text":" اَوْ يَنْفَعُوْنَكُمْ اَوْ يَضُرُّوْنَ ۝٧٣"},{"key":"26:74","surah":26,"ayah":74,"page":370,"text":"قَالُوْا بَلْ وَجَدْنَا͏ٓ اٰبَا࢜ءَنَا كَذٰلِكَ يَفْعَلُوْنَ ۝٧٤"},{"key":"26:75","surah":26,"ayah":75,"page":370,"text":" قَالَ اَفَرَءَيْتُمْ مَّا كُنْتُمْ تَعْبُدُوْنَ ۝٧٥ۙ"},{"key":"26:76","surah":26,"ayah":76,"page":370,"text":" اَنْتُمْ وَاٰبَا࢜و͏ٔ͏ُكُمُ الْاَقْدَمُوْنَ ۝٧٦ؗۖ"},{"key":"26:77","surah":26,"ayah":77,"page":370,"text":" فَاِنَّهُمْ عَدُوٌّ لِّيْٓ اِلَّا رَبَّ الْعٰلَمِيْنَ ۝٧٧ۙ"},{"key":"26:78","surah":26,"ayah":78,"page":370,"text":" الَّذِيْ خَلَقَنِيْ فَهُوَ يَهْدِيْنِ ۝٧٨ۙ"},{"key":"26:79","surah":26,"ayah":79,"page":370,"text":"وَالَّذِيْ هُوَ يُطْعِمُنِيْ وَيَسْقِيْنِ ۝٧٩ۙ"},{"key":"26:80","surah":26,"ayah":80,"page":370,"text":" وَاِذَا مَرِضْتُ فَهُوَ يَشْفِيْنِ ۝٨٠ࣕۙ"},{"key":"26:81","surah":26,"ayah":81,"page":370,"text":"وَالَّذِيْ يُمِيْتُنِيْ ثُمَّ يُحْيِيْنِ ۝٨١ۙ"},{"key":"26:82","surah":26,"ayah":82,"page":370,"text":" وَالَّذِيْٓ اَطْمَعُ اَنْ يَّغْفِرَ لِيْ خَطِيْ࢜ـٔ͏َتِيْ يَوْمَ الدِّيْنِ ۝٨٢ؕ"},{"key":"26:83","surah":26,"ayah":83,"page":370,"text":" رَبِّ هَبْ لِيْ حُكْمًا وَّاَلْحِقْنِيْ بِالصّٰلِحِيْنَ ۝٨٣ۙ"},{"key":"26:84","surah":26,"ayah":84,"page":370,"text":"وَاجْعَلْ لِّيْ لِسَانَ صِدْقٍ فِي الْاٰخِرِيْنَ ۝٨٤ۙ"},{"key":"26:85","surah":26,"ayah":85,"page":370,"text":" وَاجْعَلْنِيْ مِنْ وَّرَثَةِ جَنَّةِ النَّعِيْمِ ۝٨٥ۙ"},{"key":"26:86","surah":26,"ayah":86,"page":370,"text":" وَاغْفِرْ لِاَبِيْٓ اِنَّهٗ كَانَ مِنَ الضَّا࢜لِّيْنَ ۝٨٦ۙ"},{"key":"26:87","surah":26,"ayah":87,"page":370,"text":"وَلَا تُخْزِنِيْ يَوْمَ يُبْعَثُوْنَ ۝٨٧ۙ"},{"key":"26:88","surah":26,"ayah":88,"page":370,"text":" يَوْمَ لَا يَنْفَعُ مَالٌ وَّلَا بَنُوْنَ ۝٨٨ۙ"},{"key":"26:89","surah":26,"ayah":89,"page":370,"text":"اِلَّا مَنْ اَتَي اللّٰهَ بِقَلْبٍ سَلِيْمٍ ۝٨٩ؕ"},{"key":"26:90","surah":26,"ayah":90,"page":370,"text":" وَاُزْلِفَتِ الْجَنَّةُ لِلْمُتَّقِيْنَ ۝٩٠ۙ"}]