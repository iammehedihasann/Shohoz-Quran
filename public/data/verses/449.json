[{"key":"37:83","surah":37,"ayah":83,"page":449,"text":"وَاِنَّ مِنْ شِيْعَتِهٖ لَاِبْرٰهِيْمَ ۝٨٣ۘ"},{"key":"37:84","surah":37,"ayah":84,"page":449,"text":" اِذْ جَا࢜ءَ رَبَّهٗ بِقَلْبٍ سَلِيْمٍ ۝٨٤"},{"key":"37:85","surah":37,"ayah":85,"page":449,"text":" اِذْ قَالَ لِاَبِيْهِ وَقَوْمِهٖ مَاذَا تَعْبُدُوْنَ ۝٨٥ۚ"},{"key":"37:86","surah":37,"ayah":86,"page":449,"text":" اَىِٕفْكًا اٰلِهَةً دُوْنَ اللّٰهِ تُرِيْدُوْنَ ۝٨٦ؕ"},{"key":"37:87","surah":37,"ayah":87,"page":449,"text":" فَمَا ظَنُّكُمْ بِرَبِّ الْعٰلَمِيْنَ ۝٨٧"},{"key":"37:88","surah":37,"ayah":88,"page":449,"text":" فَنَظَرَ نَظْرَةً فِي النُّجُوْمِ ۝٨٨ۙ"},{"key":"37:89","surah":37,"ayah":89,"page":449,"text":"فَقَالَ اِنِّيْ سَقِيْمٌ ۝٨٩"},{"key":"37:90","surah":37,"ayah":90,"page":449,"text":" فَتَوَلَّوْا عَنْهُ مُدْبِرِيْنَ ۝٩٠"},{"key":"37:91","surah":37,"ayah":91,"page":449,"text":" فَرَاغَ اِلٰٓي اٰلِهَتِهِمْ فَقَالَ اَلَا تَاْكُلُوْنَ ۝٩١ۚ"},{"key":"37:92","surah":37,"ayah":92,"page":449,"text":" مَا لَكُمْ لَا تَنْطِقُوْنَ ۝٩٢"},{"key":"37:93","surah":37,"ayah":93,"page":449,"text":" فَرَاغَ عَلَيْهِمْ ضَرْبًاۢ بِالْيَمِيْنِ ۝٩٣"},{"key":"37:94","surah":37,"ayah":94,"page":449,"text":" فَاَقْبَلُوْٓا اِلَيْهِ يَزِفُّوْنَ ۝٩٤"},{"key":"37:95","surah":37,"ayah":95,"page":449,"text":" قَالَ اَتَعْبُدُوْنَ مَا تَنْحِتُوْنَ ۝٩٥ۙ"},{"key":"37:96","surah":37,"ayah":96,"page":449,"text":" وَاللّٰهُ خَلَقَكُمْ وَمَا تَعْمَلُوْنَ ۝٩٦"},{"key":"37:97","surah":37,"ayah":97,"page":449,"text":" قَالُوا ابْنُوْا لَهٗ بُنْيَانًا فَاَلْقُوْهُ فِي الْجَحِيْمِ ۝٩٧"},{"key":"37:98","surah":37,"ayah":98,"page":449,"text":" فَاَرَادُوْا بِهٖ كَيْدًا فَجَعَلْنٰهُمُ الْاَسْفَلِيْنَ ۝٩٨"},{"key":"37:99","surah":37,"ayah":99,"page":449,"text":"وَقَالَ اِنِّيْ ذَاهِبٌ اِلٰي رَبِّيْ سَيَهْدِيْنِ ۝٩٩"},{"key":"37:100","surah":37,"ayah":100,"page":449,"text":" رَبِّ هَبْ لِيْ مِنَ الصّٰلِحِيْنَ ۝١٠٠"},{"key":"37:101","surah":37,"ayah":101,"page":449,"text":" فَبَشَّرْنٰهُ بِغُلٰمٍ حَلِيْمٍ ۝١٠١"},{"key":"37:102","surah":37,"ayah":102,"page":449,"text":" فَلَمَّا بَلَغَ مَعَهُ السَّعْيَ قَالَ يٰبُنَيَّ اِنِّيْٓ اَرٰي فِي الْمَنَامِ اَنِّيْٓ اَذْبَحُكَ فَانْظُرْ مَاذَا تَرٰيؕ قَالَ يٰٓاَبَتِ افْعَلْ مَا تُو͏ٔ͏ْمَرُؗ سَتَجِدُنِيْٓ اِنْ شَا࢜ءَ اللّٰهُ مِنَ الصّٰبِرِيْنَ ۝١٠٢"},{"key":"37:103","surah":37,"ayah":103,"page":449,"text":" فَلَمَّا͏ٓ اَسْلَمَا وَتَلَّهٗ لِلْجَبِيْنِ ۝١٠٣ۚ"},{"key":"37:104","surah":37,"ayah":104,"page":449,"text":" وَنَادَيْنٰهُ اَنْ يّٰٓاِبْرٰهِيْمُ ۝١٠٤ۙ"},{"key":"37:105","surah":37,"ayah":105,"page":449,"text":" قَدْ صَدَّقْتَ الرُّءْيَاۚ اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝١٠٥"},{"key":"37:106","surah":37,"ayah":106,"page":449,"text":"اِنَّ هٰذَا لَهُوَ الْبَلٰ࢜و͏ٔ͏ُا الْمُبِيْنُ ۝١٠٦"},{"key":"37:107","surah":37,"ayah":107,"page":449,"text":" وَفَدَيْنٰهُ بِذِبْحٍ عَظِيْمٍ ۝١٠٧"}]