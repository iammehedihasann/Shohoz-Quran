[{"key":"68:7","surah":68,"ayah":7,"page":565,"text":"اِنَّ رَبَّكَ هُوَ اَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِيْلِهٖࣕ وَهُوَ اَعْلَمُ بِالْمُهْتَدِيْنَ ۝٧"},{"key":"68:8","surah":68,"ayah":8,"page":565,"text":" فَلَا تُطِعِ الْمُكَذِّبِيْنَ ۝٨"},{"key":"68:9","surah":68,"ayah":9,"page":565,"text":" وَدُّوْا لَوْ تُدْهِنُ فَيُدْهِنُوْنَ ۝٩"},{"key":"68:10","surah":68,"ayah":10,"page":565,"text":" وَلَا تُطِعْ كُلَّ حَلَّافٍ مَّهِيْنٍ ۝١٠ۙ"},{"key":"68:11","surah":68,"ayah":11,"page":565,"text":" هَمَّازٍ مَّشَّا࢜ءٍۭ بِنَمِيْمٍ ۝١١ۙ"},{"key":"68:12","surah":68,"ayah":12,"page":565,"text":" مَّنَّاعٍ لِّلْخَيْرِ مُعْتَدٍ اَثِيْمٍ ۝١٢ۙ"},{"key":"68:13","surah":68,"ayah":13,"page":565,"text":" عُتُلٍّۭ بَعْدَ ذٰلِكَ زَنِيْمٍ ۝١٣ۙ"},{"key":"68:14","surah":68,"ayah":14,"page":565,"text":" اَنْ كَانَ ذَا مَالٍ وَّبَنِيْنَ ۝١٤ؕ"},{"key":"68:15","surah":68,"ayah":15,"page":565,"text":" اِذَا تُتْلٰي عَلَيْهِ اٰيٰتُنَا قَالَ اَسَاطِيْرُ الْاَوَّلِيْنَ ۝١٥"},{"key":"68:16","surah":68,"ayah":16,"page":565,"text":" سَنَسِمُهٗ عَلَي الْخُرْطُوْمِ ۝١٦"},{"key":"68:17","surah":68,"ayah":17,"page":565,"text":" اِنَّا بَلَوْنٰهُمْ كَمَا بَلَوْنَا͏ٓ اَصْحٰبَ الْجَنَّةِۚ اِذْ اَقْسَمُوْا لَيَصْرِمُنَّهَا مُصْبِحِيْنَ ۝١٧ۙ"},{"key":"68:18","surah":68,"ayah":18,"page":565,"text":" وَلَا يَسْتَثْنُوْنَ ۝١٨"},{"key":"68:19","surah":68,"ayah":19,"page":565,"text":" فَطَافَ عَلَيْهَا طَا࢜ىِٕفٌ مِّنْ رَّبِّكَ وَهُمْ نَا࢜ىِٕمُوْنَ ۝١٩"},{"key":"68:20","surah":68,"ayah":20,"page":565,"text":"فَاَصْبَحَتْ كَالصَّرِيْمِ ۝٢٠ۙ"},{"key":"68:21","surah":68,"ayah":21,"page":565,"text":" فَتَنَادَوْا مُصْبِحِيْنَ ۝٢١ۙ"},{"key":"68:22","surah":68,"ayah":22,"page":565,"text":" اَنِ اغْدُوْا عَلٰي حَرْثِكُمْ اِنْ كُنْتُمْ صٰرِمِيْنَ ۝٢٢"},{"key":"68:23","surah":68,"ayah":23,"page":565,"text":" فَانْطَلَقُوْا وَهُمْ يَتَخَافَتُوْنَ ۝٢٣ۙ"},{"key":"68:24","surah":68,"ayah":24,"page":565,"text":"اَنْ لَّا يَدْخُلَنَّهَا الْيَوْمَ عَلَيْكُمْ مِّسْكِيْنٌ ۝٢٤ۙ"},{"key":"68:25","surah":68,"ayah":25,"page":565,"text":" وَّغَدَوْا عَلٰي حَرْدٍ قٰدِرِيْنَ ۝٢٥"},{"key":"68:26","surah":68,"ayah":26,"page":565,"text":" فَلَمَّا رَاَوْهَا قَالُوْٓا اِنَّا لَضَا࢜لُّوْنَ ۝٢٦ۙ"},{"key":"68:27","surah":68,"ayah":27,"page":565,"text":" بَلْ نَحْنُ مَحْرُوْمُوْنَ ۝٢٧"},{"key":"68:28","surah":68,"ayah":28,"page":565,"text":" قَالَ اَوْسَطُهُمْ اَلَمْ اَقُلْ لَّكُمْ لَوْلَا تُسَبِّحُوْنَ ۝٢٨"},{"key":"68:29","surah":68,"ayah":29,"page":565,"text":"قَالُوْا سُبْحٰنَ رَبِّنَا͏ٓ اِنَّا كُنَّا ظٰلِمِيْنَ ۝٢٩"},{"key":"68:30","surah":68,"ayah":30,"page":565,"text":" فَاَقْبَلَ بَعْضُهُمْ عَلٰي بَعْضٍ يَّتَلَاوَمُوْنَ ۝٣٠"},{"key":"68:31","surah":68,"ayah":31,"page":565,"text":" قَالُوْا يٰوَيْلَنَا͏ٓ اِنَّا كُنَّا طٰغِيْنَ ۝٣١"}]