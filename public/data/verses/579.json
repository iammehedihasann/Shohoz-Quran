[{"key":"74:31","surah":74,"ayah":31,"page":579,"text":"وَمَا جَعَلْنَا͏ٓ اَصْحٰبَ النَّارِ اِلَّا مَلٰ࢜ىِٕكَةًࣕ وَّمَا جَعَلْنَا عِدَّتَهُمْ اِلَّا فِتْنَةً لِّلَّذِيْنَ كَفَرُوْاۙ لِيَسْتَيْقِنَ الَّذِيْنَ اُوْتُوا الْكِتٰبَ وَيَزْدَادَ الَّذِيْنَ اٰمَنُوْٓا اِيْمَانًا وَّلَا يَرْتَابَ الَّذِيْنَ اُوْتُوا الْكِتٰبَ وَالْمُو͏ٔ͏ْمِنُوْنَۙ وَلِيَقُوْلَ الَّذِيْنَ فِيْ قُلُوْبِهِمْ مَّرَضٌ وَّالْكٰفِرُوْنَ مَاذَا͏ٓ اَرَادَ اللّٰهُ بِهٰذَا مَثَلًاؕ كَذٰلِكَ يُضِلُّ اللّٰهُ مَنْ يَّشَا࢜ءُ وَيَهْدِيْ مَنْ يَّشَا࢜ءُؕ وَمَا يَعْلَمُ جُنُوْدَ رَبِّكَ اِلَّا هُوَؕ وَمَا هِيَ اِلَّا ذِكْرٰي لِلْبَشَرِ ۝٣١ࣖ"},{"key":"74:32","surah":74,"ayah":32,"page":579,"text":" كَلَّا وَالْقَمَرِ ۝٣٢ۙ"},{"key":"74:33","surah":74,"ayah":33,"page":579,"text":" وَالَّيْلِ اِذْ اَدْبَرَ ۝٣٣ۙ"},{"key":"74:34","surah":74,"ayah":34,"page":579,"text":" وَالصُّبْحِ اِذَا͏ٓ اَسْفَرَ ۝٣٤ۙ"},{"key":"74:35","surah":74,"ayah":35,"page":579,"text":" اِنَّهَا لَاِحْدَي الْكُبَرِ ۝٣٥ۙ"},{"key":"74:36","surah":74,"ayah":36,"page":579,"text":"نَذِيْرًا لِّلْبَشَرِ ۝٣٦ۙ"},{"key":"74:37","surah":74,"ayah":37,"page":579,"text":" لِمَنْ شَا࢜ءَ مِنْكُمْ اَنْ يَّتَقَدَّمَ اَوْ يَتَاَخَّرَ ۝٣٧ؕ"},{"key":"74:38","surah":74,"ayah":38,"page":579,"text":"كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِيْنَةٌ ۝٣٨ۙ"},{"key":"74:39","surah":74,"ayah":39,"page":579,"text":" اِلَّا͏ٓ اَصْحٰبَ الْيَمِيْنِ ۝٣٩ؕۛ"},{"key":"74:40","surah":74,"ayah":40,"page":579,"text":"فِيْ جَنّٰتٍࣞۛ يَتَسَا࢜ءَلُوْنَ ۝٤٠ۙ"},{"key":"74:41","surah":74,"ayah":41,"page":579,"text":" عَنِ الْمُجْرِمِيْنَ ۝٤١ۙ"},{"key":"74:42","surah":74,"ayah":42,"page":579,"text":" مَا سَلَكَكُمْ فِيْ سَقَرَ ۝٤٢"},{"key":"74:43","surah":74,"ayah":43,"page":579,"text":" قَالُوْا لَمْ نَكُ مِنَ الْمُصَلِّيْنَ ۝٤٣ۙ"},{"key":"74:44","surah":74,"ayah":44,"page":579,"text":" وَلَمْ نَكُ نُطْعِمُ الْمِسْكِيْنَ ۝٤٤ۙ"},{"key":"74:45","surah":74,"ayah":45,"page":579,"text":" وَكُنَّا نَخُوْضُ مَعَ الْخَا࢜ىِٕضِيْنَ ۝٤٥ۙ"},{"key":"74:46","surah":74,"ayah":46,"page":579,"text":" وَكُنَّا نُكَذِّبُ بِيَوْمِ الدِّيْنِ ۝٤٦ۙ"},{"key":"74:47","surah":74,"ayah":47,"page":579,"text":" حَتّٰٓي اَتٰىنَا الْيَقِيْنُ ۝٤٧ؕ"},{"key":"74:48","surah":74,"ayah":48,"page":579,"text":" فَمَا تَنْفَعُهُمْ شَفَاعَةُ الشّٰفِعِيْنَ ۝٤٨ؕ"},{"key":"74:49","surah":74,"ayah":49,"page":579,"text":" فَمَا لَهُمْ عَنِ التَّذْكِرَةِ مُعْرِضِيْنَ ۝٤٩ۙ"}]