[{"key":"78:1","surah":78,"ayah":1,"page":586,"text":"عَمَّ يَتَسَا࢜ءَلُوْنَ ۝١ۚ"},{"key":"78:2","surah":78,"ayah":2,"page":586,"text":" عَنِ النَّبَاِ الْعَظِيْمِ ۝٢ۙ"},{"key":"78:3","surah":78,"ayah":3,"page":586,"text":" الَّذِيْ هُمْ فِيْهِ مُخْتَلِفُوْنَ ۝٣ؕ"},{"key":"78:4","surah":78,"ayah":4,"page":586,"text":" كَلَّا سَيَعْلَمُوْنَ ۝٤ۙ"},{"key":"78:5","surah":78,"ayah":5,"page":586,"text":" ثُمَّ كَلَّا سَيَعْلَمُوْنَ ۝٥"},{"key":"78:6","surah":78,"ayah":6,"page":586,"text":" اَلَمْ نَجْعَلِ الْاَرْضَ مِهٰدًا ۝٦ۙ"},{"key":"78:7","surah":78,"ayah":7,"page":586,"text":" وَّالْجِبَالَ اَوْتَادًا ۝٧ࣕۙ"},{"key":"78:8","surah":78,"ayah":8,"page":586,"text":" وَّخَلَقْنٰكُمْ اَزْوَاجًا ۝٨ۙ"},{"key":"78:9","surah":78,"ayah":9,"page":586,"text":" وَّجَعَلْنَا نَوْمَكُمْ سُبَاتًا ۝٩ۙ"},{"key":"78:10","surah":78,"ayah":10,"page":586,"text":" وَّجَعَلْنَا الَّيْلَ لِبَاسًا ۝١٠ۙ"},{"key":"78:11","surah":78,"ayah":11,"page":586,"text":"وَّجَعَلْنَا النَّهَارَ مَعَاشًا ۝١١ࣕ"},{"key":"78:12","surah":78,"ayah":12,"page":586,"text":" وَّبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا ۝١٢ۙ"},{"key":"78:13","surah":78,"ayah":13,"page":586,"text":"وَّجَعَلْنَا سِرَاجًا وَّهَّاجًا ۝١٣ࣕۙ"},{"key":"78:14","surah":78,"ayah":14,"page":586,"text":" وَّاَنْزَلْنَا مِنَ الْمُعْصِرٰتِ مَا࢜ءً ثَجَّاجًا ۝١٤ۙ"},{"key":"78:15","surah":78,"ayah":15,"page":586,"text":" لِّنُخْرِجَ بِهٖ حَبًّا وَّنَبَاتًا ۝١٥ۙ"},{"key":"78:16","surah":78,"ayah":16,"page":586,"text":" وَّجَنّٰتٍ اَلْفَافًا ۝١٦ؕ"},{"key":"78:17","surah":78,"ayah":17,"page":586,"text":"اِنَّ يَوْمَ الْفَصْلِ كَانَ مِيْقَاتًا ۝١٧ۙ"},{"key":"78:18","surah":78,"ayah":18,"page":586,"text":" يَّوْمَ يُنْفَخُ فِي الصُّوْرِ فَتَاْتُوْنَ اَفْوَاجًا ۝١٨ۙ"},{"key":"78:19","surah":78,"ayah":19,"page":586,"text":" وَّفُتِحَتِ السَّمَا࢜ءُ فَكَانَتْ اَبْوَابًا ۝١٩ۙ"},{"key":"78:20","surah":78,"ayah":20,"page":586,"text":"وَّسُيِّرَتِ الْجِبَالُ فَكَانَتْ سَرَابًا ۝٢٠ؕ"},{"key":"78:21","surah":78,"ayah":21,"page":586,"text":" اِنَّ جَهَنَّمَ كَانَتْ مِرْصَادًا ۝٢١ࣕۙ"},{"key":"78:22","surah":78,"ayah":22,"page":586,"text":" لِّلطَّاغِيْنَ مَاٰبًا ۝٢٢ۙ"},{"key":"78:23","surah":78,"ayah":23,"page":586,"text":" لّٰبِثِيْنَ فِيْهَا͏ٓ اَحْقَابًا ۝٢٣ۚ"},{"key":"78:24","surah":78,"ayah":24,"page":586,"text":"لَا يَذُوْقُوْنَ فِيْهَا بَرْدًا وَّلَا شَرَابًا ۝٢٤ۙ"},{"key":"78:25","surah":78,"ayah":25,"page":586,"text":" اِلَّا حَمِيْمًا وَّغَسَّاقًا ۝٢٥ۙ"},{"key":"78:26","surah":78,"ayah":26,"page":586,"text":"جَزَا࢜ءً وِّفَاقًا ۝٢٦ؕ"},{"key":"78:27","surah":78,"ayah":27,"page":586,"text":" اِنَّهُمْ كَانُوْا لَا يَرْجُوْنَ حِسَابًا ۝٢٧ۙ"}]