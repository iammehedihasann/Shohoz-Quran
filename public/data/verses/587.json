[{"key":"78:28","surah":78,"ayah":28,"page":587,"text":"وَّكَذَّبُوْا بِاٰيٰتِنَا كِذَّابًا ۝٢٨ؕ"},{"key":"78:29","surah":78,"ayah":29,"page":587,"text":" وَكُلَّ شَيْءٍ اَحْصَيْنٰهُ كِتٰبًا ۝٢٩ۙ"},{"key":"78:30","surah":78,"ayah":30,"page":587,"text":"فَذُوْقُوْا فَلَنْ نَّزِيْدَكُمْ اِلَّا عَذَابًا ۝٣٠ࣖ"},{"key":"78:31","surah":78,"ayah":31,"page":587,"text":" اِنَّ لِلْمُتَّقِيْنَ مَفَازًا ۝٣١ۙ"},{"key":"78:32","surah":78,"ayah":32,"page":587,"text":" حَدَا࢜ىِٕقَ وَاَعْنَابًا ۝٣٢ۙ"},{"key":"78:33","surah":78,"ayah":33,"page":587,"text":" وَّكَوَاعِبَ اَتْرَابًا ۝٣٣ۙ"},{"key":"78:34","surah":78,"ayah":34,"page":587,"text":" وَّكَاْسًا دِهَاقًا ۝٣٤ؕ"},{"key":"78:35","surah":78,"ayah":35,"page":587,"text":" لَا يَسْمَعُوْنَ فِيْهَا لَغْوًا وَّلَا كِذّٰبًا ۝٣٥ۚ"},{"key":"78:36","surah":78,"ayah":36,"page":587,"text":" جَزَا࢜ءً مِّنْ رَّبِّكَ عَطَا࢜ءً حِسَابًا ۝٣٦ۙ"},{"key":"78:37","surah":78,"ayah":37,"page":587,"text":" رَّبِّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَيْنَهُمَا الرَّحْمٰنِ لَا يَمْلِكُوْنَ مِنْهُ خِطَابًا ۝٣٧ۚ"},{"key":"78:38","surah":78,"ayah":38,"page":587,"text":" يَوْمَ يَقُوْمُ الرُّوْحُ وَالْمَلٰ࢜ىِٕكَةُ صَفًّاؕࣗۙ لَّا يَتَكَلَّمُوْنَ اِلَّا مَنْ اَذِنَ لَهُ الرَّحْمٰنُ وَقَالَ صَوَابًا ۝٣٨"},{"key":"78:39","surah":78,"ayah":39,"page":587,"text":" ذٰلِكَ الْيَوْمُ الْحَقُّۚ فَمَنْ شَا࢜ءَ اتَّخَذَ اِلٰي رَبِّهٖ مَاٰبًا ۝٣٩"},{"key":"78:40","surah":78,"ayah":40,"page":587,"text":" اِنَّا͏ٓ اَنْذَرْنٰكُمْ عَذَابًا قَرِيْبًا࣢ۚۖ يَّوْمَ يَنْظُرُ الْمَرْءُ مَا قَدَّمَتْ يَدٰهُ وَيَقُوْلُ الْكٰفِرُ يٰلَيْتَنِيْ كُنْتُ تُرٰبًا ۝٤٠ࣖ"},{"key":"79:1","surah":79,"ayah":1,"page":587,"text":"وَالنّٰزِعٰتِ غَرْقًا ۝١ۙ"},{"key":"79:2","surah":79,"ayah":2,"page":587,"text":" وَّالنّٰشِطٰتِ نَشْطًا ۝٢ۙ"},{"key":"79:3","surah":79,"ayah":3,"page":587,"text":" وَّالسّٰبِحٰتِ سَبْحًا ۝٣ۙ"},{"key":"79:4","surah":79,"ayah":4,"page":587,"text":" فَالسّٰبِقٰتِ سَبْقًا ۝٤ۙ"},{"key":"79:5","surah":79,"ayah":5,"page":587,"text":" فَالْمُدَبِّرٰتِ اَمْرًا ۝٥ۘ"},{"key":"79:6","surah":79,"ayah":6,"page":587,"text":" يَوْمَ تَرْجُفُ الرَّاجِفَةُ ۝٦ۙ"},{"key":"79:7","surah":79,"ayah":7,"page":587,"text":" تَتْبَعُهَا الرَّادِفَةُ ۝٧ؕ"},{"key":"79:8","surah":79,"ayah":8,"page":587,"text":" قُلُوْبٌ يَّوْمَىِٕذٍ وَّاجِفَةٌ ۝٨ۙ"}]