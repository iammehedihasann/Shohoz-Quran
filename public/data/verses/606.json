[{"key":"100:9","surah":100,"ayah":9,"page":606,"text":"اَفَلَا يَعْلَمُ اِذَا بُعْثِرَ مَا فِي الْقُبُوْرِ ۝٩ۙ"},{"key":"100:10","surah":100,"ayah":10,"page":606,"text":" وَحُصِّلَ مَا فِي الصُّدُوْرِ ۝١٠ۙ"},{"key":"100:11","surah":100,"ayah":11,"page":606,"text":"اِنَّ رَبَّهُمْ بِهِمْ يَوْمَىِٕذٍ لَّخَبِيْرٌ ۝١١ࣖ"},{"key":"101:1","surah":101,"ayah":1,"page":606,"text":"اَلْقَارِعَةُ ۝١ۙ"},{"key":"101:2","surah":101,"ayah":2,"page":606,"text":" مَا الْقَارِعَةُ ۝٢ۚ"},{"key":"101:3","surah":101,"ayah":3,"page":606,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا الْقَارِعَةُ ۝٣ؕ"},{"key":"101:4","surah":101,"ayah":4,"page":606,"text":"يَوْمَ يَكُوْنُ النَّاسُ كَالْفَرَاشِ الْمَبْثُوْثِ ۝٤ۙ"},{"key":"101:5","surah":101,"ayah":5,"page":606,"text":" وَتَكُوْنُ الْجِبَالُ كَالْعِهْنِ الْمَنْفُوْشِ ۝٥ؕ"},{"key":"101:6","surah":101,"ayah":6,"page":606,"text":" فَاَمَّا مَنْ ثَقُلَتْ مَوَازِيْنُهٗ ۝٦ۙ"},{"key":"101:7","surah":101,"ayah":7,"page":606,"text":" فَهُوَ فِيْ عِيْشَةٍ رَّاضِيَةٍ ۝٧ؕ"},{"key":"101:8","surah":101,"ayah":8,"page":606,"text":" وَاَمَّا مَنْ خَفَّتْ مَوَازِيْنُهٗ ۝٨ۙ"},{"key":"101:9","surah":101,"ayah":9,"page":606,"text":" فَاُمُّهٗ هَاوِيَةٌ ۝٩ؕ"},{"key":"101:10","surah":101,"ayah":10,"page":606,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا هِيَهْ ۝١٠ؕ"},{"key":"101:11","surah":101,"ayah":11,"page":606,"text":" نَارٌ حَامِيَةٌ ۝١١ࣖ"},{"key":"102:1","surah":102,"ayah":1,"page":606,"text":"اَلْهٰىكُمُ التَّكَاثُرُ ۝١ۙ"},{"key":"102:2","surah":102,"ayah":2,"page":606,"text":" حَتّٰي زُرْتُمُ الْمَقَابِرَ ۝٢ؕ"},{"key":"102:3","surah":102,"ayah":3,"page":606,"text":" كَلَّا سَوْفَ تَعْلَمُوْنَ ۝٣ۙ"},{"key":"102:4","surah":102,"ayah":4,"page":606,"text":" ثُمَّ كَلَّا سَوْفَ تَعْلَمُوْنَ ۝٤ؕ"},{"key":"102:5","surah":102,"ayah":5,"page":606,"text":" كَلَّا لَوْ تَعْلَمُوْنَ عِلْمَ الْيَقِيْنِ ۝٥ؕ"},{"key":"102:6","surah":102,"ayah":6,"page":606,"text":" لَتَرَوُنَّ الْجَحِيْمَ ۝٦ۙ"},{"key":"102:7","surah":102,"ayah":7,"page":606,"text":" ثُمَّ لَتَرَوُنَّهَا عَيْنَ الْيَقِيْنِ ۝٧ۙ"},{"key":"102:8","surah":102,"ayah":8,"page":606,"text":" ثُمَّ لَتُسْـٔ͏َلُنَّ يَوْمَىِٕذٍ عَنِ النَّعِيْمِ ۝٨ࣖ"}]