[{"key":"83:34","surah":83,"ayah":34,"page":594,"text":"فَالْيَوْمَ الَّذِيْنَ اٰمَنُوْا مِنَ الْكُفَّارِ يَضْحَكُوْنَ ۝٣٤ۙ"},{"key":"83:35","surah":83,"ayah":35,"page":594,"text":" عَلَي الْاَرَا࢜ىِٕكِۙ يَنْظُرُوْنَ ۝٣٥ؕ"},{"key":"83:36","surah":83,"ayah":36,"page":594,"text":" هَلْ ثُوِّبَ الْكُفَّارُ مَا كَانُوْا يَفْعَلُوْنَ ۝٣٦ࣖ"},{"key":"84:1","surah":84,"ayah":1,"page":594,"text":"اِذَا السَّمَا࢜ءُ انْشَقَّتْ ۝١ۙ"},{"key":"84:2","surah":84,"ayah":2,"page":594,"text":" وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۝٢ۙ"},{"key":"84:3","surah":84,"ayah":3,"page":594,"text":" وَاِذَا الْاَرْضُ مُدَّتْ ۝٣ؕ"},{"key":"84:4","surah":84,"ayah":4,"page":594,"text":" وَاَلْقَتْ مَا فِيْهَا وَتَخَلَّتْ ۝٤ۙ"},{"key":"84:5","surah":84,"ayah":5,"page":594,"text":" وَاَذِنَتْ لِرَبِّهَا وَحُقَّتْ ۝٥ؕ"},{"key":"84:6","surah":84,"ayah":6,"page":594,"text":" يٰٓاَيُّهَا الْاِنْسَانُ اِنَّكَ كَادِحٌ اِلٰي رَبِّكَ كَدْحًا فَمُلٰقِيْهِ ۝٦ۚ"},{"key":"84:7","surah":84,"ayah":7,"page":594,"text":" فَاَمَّا مَنْ اُوْتِيَ كِتٰبَهٗ بِيَمِيْنِهٖ ۝٧ۙ"},{"key":"84:8","surah":84,"ayah":8,"page":594,"text":"فَسَوْفَ يُحَاسَبُ حِسَابًا يَّسِيْرًا ۝٨ۙ"},{"key":"84:9","surah":84,"ayah":9,"page":594,"text":" وَّيَنْقَلِبُ اِلٰٓي اَهْلِهٖ مَسْرُوْرًا ۝٩ؕ"},{"key":"84:10","surah":84,"ayah":10,"page":594,"text":" وَاَمَّا مَنْ اُوْتِيَ كِتٰبَهٗ وَرَا࢜ءَ ظَهْرِهٖ ۝١٠ۙ"},{"key":"84:11","surah":84,"ayah":11,"page":594,"text":" فَسَوْفَ يَدْعُوْا ثُبُوْرًا ۝١١ۙ"},{"key":"84:12","surah":84,"ayah":12,"page":594,"text":" وَّيَصْلٰي سَعِيْرًا ۝١٢ؕ"},{"key":"84:13","surah":84,"ayah":13,"page":594,"text":" اِنَّهٗ كَانَ فِيْٓ اَهْلِهٖ مَسْرُوْرًا ۝١٣ؕ"},{"key":"84:14","surah":84,"ayah":14,"page":594,"text":" اِنَّهٗ ظَنَّ اَنْ لَّنْ يَّحُوْرَ ۝١٤ۚۛ"},{"key":"84:15","surah":84,"ayah":15,"page":594,"text":" بَلٰٓيۚۛ اِنَّ رَبَّهٗ كَانَ بِهٖ بَصِيْرًا ۝١٥ؕ"},{"key":"84:16","surah":84,"ayah":16,"page":594,"text":" فَلَا͏ٓ اُقْسِمُ بِالشَّفَقِ ۝١٦ۙ"},{"key":"84:17","surah":84,"ayah":17,"page":594,"text":" وَالَّيْلِ وَمَا وَسَقَ ۝١٧ۙ"},{"key":"84:18","surah":84,"ayah":18,"page":594,"text":"وَالْقَمَرِ اِذَا اتَّسَقَ ۝١٨ۙ"},{"key":"84:19","surah":84,"ayah":19,"page":594,"text":" لَتَرْكَبُنَّ طَبَقًا عَنْ طَبَقٍ ۝١٩ؕ"},{"key":"84:20","surah":84,"ayah":20,"page":594,"text":" فَمَا لَهُمْ لَا يُو͏ٔ͏ْمِنُوْنَ ۝٢٠ۙ"},{"key":"84:21","surah":84,"ayah":21,"page":594,"text":" وَاِذَا قُرِي͏ٔ͏َ عَلَيْهِمُ الْقُرْاٰنُ لَا يَسْجُدُوْنَ ۝٢١ࣛؕ"}]