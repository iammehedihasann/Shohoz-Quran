[{"key":"113:1","surah":113,"ayah":1,"page":610,"text":"قُلْ اَعُوْذُ بِرَبِّ الْفَلَقِ ۝١ۙ"},{"key":"113:2","surah":113,"ayah":2,"page":610,"text":" مِنْ شَرِّ مَا خَلَقَ ۝٢ۙ"},{"key":"113:3","surah":113,"ayah":3,"page":610,"text":" وَمِنْ شَرِّ غَاسِقٍ اِذَا وَقَبَ ۝٣ۙ"},{"key":"113:4","surah":113,"ayah":4,"page":610,"text":" وَمِنْ شَرِّ النَّفّٰثٰتِ فِي الْعُقَدِ ۝٤ۙ"},{"key":"113:5","surah":113,"ayah":5,"page":610,"text":"وَمِنْ شَرِّ حَاسِدٍ اِذَا حَسَدَ ۝٥ࣖ"},{"key":"114:1","surah":114,"ayah":1,"page":610,"text":"قُلْ اَعُوْذُ بِرَبِّ النَّاسِ ۝١ۙ"},{"key":"114:2","surah":114,"ayah":2,"page":610,"text":" مَلِكِ النَّاسِ ۝٢ۙ"},{"key":"114:3","surah":114,"ayah":3,"page":610,"text":" اِلٰهِ النَّاسِ ۝٣ۙ"},{"key":"114:4","surah":114,"ayah":4,"page":610,"text":"مِنْ شَرِّ الْوَسْوَاسِ࣢ۙ الْخَنَّاسِ ۝٤ࣕۙ"},{"key":"114:5","surah":114,"ayah":5,"page":610,"text":" الَّذِيْ يُوَسْوِسُ فِيْ صُدُوْرِ النَّاسِ ۝٥ۙ"},{"key":"114:6","surah":114,"ayah":6,"page":610,"text":" مِنَ الْجِنَّةِ وَالنَّاسِ ۝٦ࣖ"}]