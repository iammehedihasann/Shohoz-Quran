[{"key":"51:7","surah":51,"ayah":7,"page":521,"text":"وَالسَّمَا࢜ءِ ذَاتِ الْحُبُكِ ۝٧ۙ"},{"key":"51:8","surah":51,"ayah":8,"page":521,"text":" اِنَّكُمْ لَفِيْ قَوْلٍ مُّخْتَلِفٍ ۝٨ۙ"},{"key":"51:9","surah":51,"ayah":9,"page":521,"text":" يُّو͏ٔ͏ْفَكُ عَنْهُ مَنْ اُفِكَ ۝٩ؕ"},{"key":"51:10","surah":51,"ayah":10,"page":521,"text":" قُتِلَ الْخَرّٰصُوْنَ ۝١٠ۙ"},{"key":"51:11","surah":51,"ayah":11,"page":521,"text":" الَّذِيْنَ هُمْ فِيْ غَمْرَةٍ سَاهُوْنَ ۝١١ۙ"},{"key":"51:12","surah":51,"ayah":12,"page":521,"text":"يَسْـٔ͏َلُوْنَ اَيَّانَ يَوْمُ الدِّيْنِ ۝١٢ؕ"},{"key":"51:13","surah":51,"ayah":13,"page":521,"text":" يَوْمَ هُمْ عَلَي النَّارِ يُفْتَنُوْنَ ۝١٣"},{"key":"51:14","surah":51,"ayah":14,"page":521,"text":" ذُوْقُوْا فِتْنَتَكُمْؕ هٰذَا الَّذِيْ كُنْتُمْ بِهٖ تَسْتَعْجِلُوْنَ ۝١٤"},{"key":"51:15","surah":51,"ayah":15,"page":521,"text":" اِنَّ الْمُتَّقِيْنَ فِيْ جَنّٰتٍ وَّعُيُوْنٍ ۝١٥ۙ"},{"key":"51:16","surah":51,"ayah":16,"page":521,"text":" اٰخِذِيْنَ مَا͏ٓ اٰتٰىهُمْ رَبُّهُمْؕ اِنَّهُمْ كَانُوْا قَبْلَ ذٰلِكَ مُحْسِنِيْنَ ۝١٦ؕ"},{"key":"51:17","surah":51,"ayah":17,"page":521,"text":" كَانُوْا قَلِيْلًا مِّنَ الَّيْلِ مَا يَهْجَعُوْنَ ۝١٧"},{"key":"51:18","surah":51,"ayah":18,"page":521,"text":" وَبِالْاَسْحَارِ هُمْ يَسْتَغْفِرُوْنَ ۝١٨"},{"key":"51:19","surah":51,"ayah":19,"page":521,"text":" وَفِيْٓ اَمْوَالِهِمْ حَقٌّ لِّلسَّا࢜ىِٕلِ وَالْمَحْرُوْمِ ۝١٩"},{"key":"51:20","surah":51,"ayah":20,"page":521,"text":" وَفِي الْاَرْضِ اٰيٰتٌ لِّلْمُوْقِنِيْنَ ۝٢٠ۙ"},{"key":"51:21","surah":51,"ayah":21,"page":521,"text":" وَفِيْٓ اَنْفُسِكُمْؕ اَفَلَا تُبْصِرُوْنَ ۝٢١"},{"key":"51:22","surah":51,"ayah":22,"page":521,"text":" وَفِي السَّمَا࢜ءِ رِزْقُكُمْ وَمَا تُوْعَدُوْنَ ۝٢٢"},{"key":"51:23","surah":51,"ayah":23,"page":521,"text":" فَوَرَبِّ السَّمَا࢜ءِ وَالْاَرْضِ اِنَّهٗ لَحَقٌّ مِّثْلَ مَا͏ٓ اَنَّكُمْ تَنْطِقُوْنَ ۝٢٣ࣖ"},{"key":"51:24","surah":51,"ayah":24,"page":521,"text":" هَلْ اَتٰىكَ حَدِيْثُ ضَيْفِ اِبْرٰهِيْمَ الْمُكْرَمِيْنَ ۝٢٤ۘ"},{"key":"51:25","surah":51,"ayah":25,"page":521,"text":" اِذْ دَخَلُوْا عَلَيْهِ فَقَالُوْا سَلٰمًاؕ قَالَ سَلٰمٌۚ قَوْمٌ مُّنْكَرُوْنَ ۝٢٥"},{"key":"51:26","surah":51,"ayah":26,"page":521,"text":" فَرَاغَ اِلٰٓي اَهْلِهٖ فَجَا࢜ءَ بِعِجْلٍ سَمِيْنٍ ۝٢٦ۙ"},{"key":"51:27","surah":51,"ayah":27,"page":521,"text":" فَقَرَّبَهٗٓ اِلَيْهِمْ قَالَ اَلَا تَاْكُلُوْنَ ۝٢٧ؗ"},{"key":"51:28","surah":51,"ayah":28,"page":521,"text":" فَاَوْجَسَ مِنْهُمْ خِيْفَةًؕ قَالُوْا لَا تَخَفْؕ وَبَشَّرُوْهُ بِغُلٰمٍ عَلِيْمٍ ۝٢٨"},{"key":"51:29","surah":51,"ayah":29,"page":521,"text":" فَاَقْبَلَتِ امْرَاَتُهٗ فِيْ صَرَّةٍ فَصَكَّتْ وَجْهَهَا وَقَالَتْ عَجُوْزٌ عَقِيْمٌ ۝٢٩"},{"key":"51:30","surah":51,"ayah":30,"page":521,"text":" قَالُوْا كَذٰلِكِۙ قَالَ رَبُّكِؕ اِنَّهٗ هُوَ الْحَكِيْمُ الْعَلِيْمُ ۝٣٠"}]