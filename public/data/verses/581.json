[{"key":"75:15","surah":75,"ayah":15,"page":581,"text":"وَّلَوْ اَلْقٰى مَعَاذِيْرَهٗ ۝١٥ؕ"},{"key":"75:16","surah":75,"ayah":16,"page":581,"text":" لَا تُحَرِّكْ بِهٖ لِسَانَكَ لِتَعْجَلَ بِهٖ ۝١٦ؕ"},{"key":"75:17","surah":75,"ayah":17,"page":581,"text":" اِنَّ عَلَيْنَا جَمْعَهٗ وَقُرْاٰنَهٗ ۝١٧ۚۖ"},{"key":"75:18","surah":75,"ayah":18,"page":581,"text":" فَاِذَا قَرَاْنٰهُ فَاتَّبِعْ قُرْاٰنَهٗ ۝١٨ۚ"},{"key":"75:19","surah":75,"ayah":19,"page":581,"text":" ثُمَّ اِنَّ عَلَيْنَا بَيَانَهٗ ۝١٩ؕ"},{"key":"75:20","surah":75,"ayah":20,"page":581,"text":" كَلَّا بَلْ تُحِبُّوْنَ الْعَاجِلَةَ ۝٢٠ۙ"},{"key":"75:21","surah":75,"ayah":21,"page":581,"text":" وَتَذَرُوْنَ الْاٰخِرَةَ ۝٢١ؕ"},{"key":"75:22","surah":75,"ayah":22,"page":581,"text":" وُجُوْهٌ يَّوْمَىِٕذٍ نَّاضِرَةٌ ۝٢٢ۙ"},{"key":"75:23","surah":75,"ayah":23,"page":581,"text":" اِلٰى رَبِّهَا نَاظِرَةٌ ۝٢٣ۚ"},{"key":"75:24","surah":75,"ayah":24,"page":581,"text":" وَوُجُوْهٌ يَّوْمَىِٕذٍۭ بَاسِرَةٌ ۝٢٤ۙ"},{"key":"75:25","surah":75,"ayah":25,"page":581,"text":" تَظُنُّ اَنْ يُّفْعَلَ بِهَا فَاقِرَةٌ ۝٢٥ؕ"},{"key":"75:26","surah":75,"ayah":26,"page":581,"text":" كَلَّا͏ٓ اِذَا بَلَغَتِ التَّرَاقِيَ ۝٢٦ۙ"},{"key":"75:27","surah":75,"ayah":27,"page":581,"text":" وَقِيْلَ مَنْࣝ رَاقٍ ۝٢٧ۙ"},{"key":"75:28","surah":75,"ayah":28,"page":581,"text":" وَّظَنَّ اَنَّهُ الْفِرَاقُ ۝٢٨ۙ"},{"key":"75:29","surah":75,"ayah":29,"page":581,"text":" وَالْتَفَّتِ السَّاقُ بِالسَّاقِ ۝٢٩ۙ"},{"key":"75:30","surah":75,"ayah":30,"page":581,"text":" اِلٰى رَبِّكَ يَوْمَىِٕذِ اࣙلْمَسَاقُ ۝٣٠ؕࣖ"},{"key":"75:31","surah":75,"ayah":31,"page":581,"text":" فَلَا صَدَّقَ وَلَا صَلّٰى ۝٣١ۙ"},{"key":"75:32","surah":75,"ayah":32,"page":581,"text":" وَلٰكِنْ كَذَّبَ وَتَوَلّٰى ۝٣٢ۙ"},{"key":"75:33","surah":75,"ayah":33,"page":581,"text":" ثُمَّ ذَهَبَ اِلٰٓي اَهْلِهٖ يَتَمَطّٰى ۝٣٣ؕ"},{"key":"75:34","surah":75,"ayah":34,"page":581,"text":" اَوْلٰى لَكَ فَاَوْلٰى ۝٣٤ۙ"},{"key":"75:35","surah":75,"ayah":35,"page":581,"text":" ثُمَّ اَوْلٰى لَكَ فَاَوْلٰى ۝٣٥ؕ"},{"key":"75:36","surah":75,"ayah":36,"page":581,"text":" اَيَحْسَبُ الْاِنْسَانُ اَنْ يُّتْرَكَ سُدًي ۝٣٦ؕ"},{"key":"75:37","surah":75,"ayah":37,"page":581,"text":" اَلَمْ يَكُ نُطْفَةً مِّنْ مَّنِيٍّ يُّمْنٰى ۝٣٧ۙ"},{"key":"75:38","surah":75,"ayah":38,"page":581,"text":" ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوّٰى ۝٣٨ۙ"},{"key":"75:39","surah":75,"ayah":39,"page":581,"text":" فَجَعَلَ مِنْهُ الزَّوْجَيْنِ الذَّكَرَ وَالْاُنْثٰي ۝٣٩ؕ"},{"key":"75:40","surah":75,"ayah":40,"page":581,"text":" اَلَيْسَ ذٰلِكَ بِقٰدِرٍ عَلٰٓي اَنْ يُّحْيِۦَ الْمَوْتٰى ۝٤٠ࣖ"}]