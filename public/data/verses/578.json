[{"key":"74:1","surah":74,"ayah":1,"page":578,"text":"يٰٓاَيُّهَا الْمُدَّثِّرُ ۝١ۙ"},{"key":"74:2","surah":74,"ayah":2,"page":578,"text":" قُمْ فَاَنْذِرْ ۝٢ࣕۙ"},{"key":"74:3","surah":74,"ayah":3,"page":578,"text":" وَرَبَّكَ فَكَبِّرْ ۝٣ࣕۙ"},{"key":"74:4","surah":74,"ayah":4,"page":578,"text":"وَثِيَابَكَ فَطَهِّرْ ۝٤ࣕۙ"},{"key":"74:5","surah":74,"ayah":5,"page":578,"text":" وَالرُّجْزَ فَاهْجُرْ ۝٥ࣕۙ"},{"key":"74:6","surah":74,"ayah":6,"page":578,"text":" وَلَا تَمْنُنْ تَسْتَكْثِرُ ۝٦ࣕۙ"},{"key":"74:7","surah":74,"ayah":7,"page":578,"text":" وَلِرَبِّكَ فَاصْبِرْ ۝٧ؕ"},{"key":"74:8","surah":74,"ayah":8,"page":578,"text":" فَاِذَا نُقِرَ فِي النَّاقُوْرِ ۝٨ۙ"},{"key":"74:9","surah":74,"ayah":9,"page":578,"text":"فَذٰلِكَ يَوْمَىِٕذٍ يَّوْمٌ عَسِيْرٌ ۝٩ۙ"},{"key":"74:10","surah":74,"ayah":10,"page":578,"text":" عَلَي الْكٰفِرِيْنَ غَيْرُ يَسِيْرٍ ۝١٠"},{"key":"74:11","surah":74,"ayah":11,"page":578,"text":" ذَرْنِيْ وَمَنْ خَلَقْتُ وَحِيْدًا ۝١١ۙ"},{"key":"74:12","surah":74,"ayah":12,"page":578,"text":" وَّجَعَلْتُ لَهٗ مَالًا مَّمْدُوْدًا ۝١٢ۙ"},{"key":"74:13","surah":74,"ayah":13,"page":578,"text":" وَّبَنِيْنَ شُهُوْدًا ۝١٣ۙ"},{"key":"74:14","surah":74,"ayah":14,"page":578,"text":" وَّمَهَّدْتُّ لَهٗ تَمْهِيْدًا ۝١٤ۙ"},{"key":"74:15","surah":74,"ayah":15,"page":578,"text":"ثُمَّ يَطْمَعُ اَنْ اَزِيْدَ ۝١٥ࣗۙ"},{"key":"74:16","surah":74,"ayah":16,"page":578,"text":" كَلَّاؕ اِنَّهٗ كَانَ لِاٰيٰتِنَا عَنِيْدًا ۝١٦ؕ"},{"key":"74:17","surah":74,"ayah":17,"page":578,"text":"سَاُرْهِقُهٗ صَعُوْدًا ۝١٧ؕ"},{"key":"74:18","surah":74,"ayah":18,"page":578,"text":" اِنَّهٗ فَكَّرَ وَقَدَّرَ ۝١٨ۙ"},{"key":"74:19","surah":74,"ayah":19,"page":578,"text":" فَقُتِلَ كَيْفَ قَدَّرَ ۝١٩ۙ"},{"key":"74:20","surah":74,"ayah":20,"page":578,"text":" ثُمَّ قُتِلَ كَيْفَ قَدَّرَ ۝٢٠ۙ"},{"key":"74:21","surah":74,"ayah":21,"page":578,"text":" ثُمَّ نَظَرَ ۝٢١ۙ"},{"key":"74:22","surah":74,"ayah":22,"page":578,"text":" ثُمَّ عَبَسَ وَبَسَرَ ۝٢٢ۙ"},{"key":"74:23","surah":74,"ayah":23,"page":578,"text":" ثُمَّ اَدْبَرَ وَاسْتَكْبَرَ ۝٢٣ۙ"},{"key":"74:24","surah":74,"ayah":24,"page":578,"text":" فَقَالَ اِنْ هٰذَا͏ٓ اِلَّا سِحْرٌ يُّو͏ٔ͏ْثَرُ ۝٢٤ۙ"},{"key":"74:25","surah":74,"ayah":25,"page":578,"text":" اِنْ هٰذَا͏ٓ اِلَّا قَوْلُ الْبَشَرِ ۝٢٥ؕ"},{"key":"74:26","surah":74,"ayah":26,"page":578,"text":"سَاُصْلِيْهِ سَقَرَ ۝٢٦"},{"key":"74:27","surah":74,"ayah":27,"page":578,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا سَقَرُ ۝٢٧ؕ"},{"key":"74:28","surah":74,"ayah":28,"page":578,"text":" لَا تُبْقِيْ وَلَا تَذَرُ ۝٢٨ۚ"},{"key":"74:29","surah":74,"ayah":29,"page":578,"text":" لَوَّاحَةٌ لِّلْبَشَرِ ۝٢٩ۚۖ"},{"key":"74:30","surah":74,"ayah":30,"page":578,"text":" عَلَيْهَا تِسْعَةَ عَشَرَ ۝٣٠ؕ"}]