[{"key":"1:1","surah":1,"ayah":1,"page":1,"text":"بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ ۝"},{"key":"1:2","surah":1,"ayah":2,"page":1,"text":"اَلْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَ ۝١ۙ"},{"key":"1:3","surah":1,"ayah":3,"page":1,"text":" الرَّحْمٰنِ الرَّحِيْمِ ۝٢ۙ"},{"key":"1:4","surah":1,"ayah":4,"page":1,"text":" مٰلِكِ يَوْمِ الدِّيْنِ ۝٣ؕ"},{"key":"1:5","surah":1,"ayah":5,"page":1,"text":"اِيَّاكَ نَعْبُدُ وَاِيَّاكَ نَسْتَعِيْنُ ۝٤ؕ"},{"key":"1:6","surah":1,"ayah":6,"page":1,"text":"اِهْدِنَا الصِّرَاطَ الْمُسْتَقِيْمَ ۝٥ۙ"},{"key":"1:7","surah":1,"ayah":7,"page":1,"text":" صِرَاطَ الَّذِيْنَ اَنْعَمْتَ عَلَيْهِمْ‮٦࣢ۙ غَيْرِ الْمَغْضُوْبِ عَلَيْهِمْ وَلَا الضَّا࢜لِّيْنَ ۝٧ࣖ"}]