[{"key":"37:57","surah":37,"ayah":57,"page":448,"text":"وَلَوْلَا نِعْمَةُ رَبِّيْ لَكُنْتُ مِنَ الْمُحْضَرِيْنَ ۝٥٧"},{"key":"37:58","surah":37,"ayah":58,"page":448,"text":" اَفَمَا نَحْنُ بِمَيِّتِيْنَ ۝٥٨ۙ"},{"key":"37:59","surah":37,"ayah":59,"page":448,"text":" اِلَّا مَوْتَتَنَا الْاُوْلٰي وَمَا نَحْنُ بِمُعَذَّبِيْنَ ۝٥٩"},{"key":"37:60","surah":37,"ayah":60,"page":448,"text":" اِنَّ هٰذَا لَهُوَ الْفَوْزُ الْعَظِيْمُ ۝٦٠"},{"key":"37:61","surah":37,"ayah":61,"page":448,"text":" لِمِثْلِ هٰذَا فَلْيَعْمَلِ الْعٰمِلُوْنَ ۝٦١"},{"key":"37:62","surah":37,"ayah":62,"page":448,"text":"اَذٰلِكَ خَيْرٌ نُّزُلًا اَمْ شَجَرَةُ الزَّقُّوْمِ ۝٦٢"},{"key":"37:63","surah":37,"ayah":63,"page":448,"text":" اِنَّا جَعَلْنٰهَا فِتْنَةً لِّلظّٰلِمِيْنَ ۝٦٣"},{"key":"37:64","surah":37,"ayah":64,"page":448,"text":" اِنَّهَا شَجَرَةٌ تَخْرُجُ فِيْٓ اَصْلِ الْجَحِيْمِ ۝٦٤ۙ"},{"key":"37:65","surah":37,"ayah":65,"page":448,"text":" طَلْعُهَا كَاَنَّهٗ رُءُوْسُ الشَّيٰطِيْنِ ۝٦٥"},{"key":"37:66","surah":37,"ayah":66,"page":448,"text":" فَاِنَّهُمْ لَاٰكِلُوْنَ مِنْهَا فَمَالِـٔ͏ُوْنَ مِنْهَا الْبُطُوْنَ ۝٦٦ؕ"},{"key":"37:67","surah":37,"ayah":67,"page":448,"text":" ثُمَّ اِنَّ لَهُمْ عَلَيْهَا لَشَوْبًا مِّنْ حَمِيْمٍ ۝٦٧ۚ"},{"key":"37:68","surah":37,"ayah":68,"page":448,"text":" ثُمَّ اِنَّ مَرْجِعَهُمْ لَا۟اِلَي الْجَحِيْمِ ۝٦٨"},{"key":"37:69","surah":37,"ayah":69,"page":448,"text":" اِنَّهُمْ اَلْفَوْا اٰبَا࢜ءَهُمْ ضَا࢜لِّيْنَ ۝٦٩ۙ"},{"key":"37:70","surah":37,"ayah":70,"page":448,"text":"فَهُمْ عَلٰٓي اٰثٰرِهِمْ يُهْرَعُوْنَ ۝٧٠"},{"key":"37:71","surah":37,"ayah":71,"page":448,"text":" وَلَقَدْ ضَلَّ قَبْلَهُمْ اَكْثَرُ الْاَوَّلِيْنَ ۝٧١ۙ"},{"key":"37:72","surah":37,"ayah":72,"page":448,"text":" وَلَقَدْ اَرْسَلْنَا فِيْهِمْ مُّنْذِرِيْنَ ۝٧٢"},{"key":"37:73","surah":37,"ayah":73,"page":448,"text":" فَانْظُرْ كَيْفَ كَانَ عَاقِبَةُ الْمُنْذَرِيْنَ ۝٧٣ۙ"},{"key":"37:74","surah":37,"ayah":74,"page":448,"text":" اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصِيْنَ ۝٧٤ࣖ"},{"key":"37:75","surah":37,"ayah":75,"page":448,"text":" وَلَقَدْ نَادٰىنَا نُوْحٌ فَلَنِعْمَ الْمُجِيْبُوْنَ ۝٧٥ؗۖ"},{"key":"37:76","surah":37,"ayah":76,"page":448,"text":" وَنَجَّيْنٰهُ وَاَهْلَهٗ مِنَ الْكَرْبِ الْعَظِيْمِ ۝٧٦ؗۖ"},{"key":"37:77","surah":37,"ayah":77,"page":448,"text":" وَجَعَلْنَا ذُرِّيَّتَهٗ هُمُ الْبٰقِيْنَ ۝٧٧ؗۖ"},{"key":"37:78","surah":37,"ayah":78,"page":448,"text":" وَتَرَكْنَا عَلَيْهِ فِي الْاٰخِرِيْنَ ۝٧٨ؗۖ"},{"key":"37:79","surah":37,"ayah":79,"page":448,"text":" سَلٰمٌ عَلٰي نُوْحٍ فِي الْعٰلَمِيْنَ ۝٧٩"},{"key":"37:80","surah":37,"ayah":80,"page":448,"text":" اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝٨٠"},{"key":"37:81","surah":37,"ayah":81,"page":448,"text":" اِنَّهٗ مِنْ عِبَادِنَا الْمُو͏ٔ͏ْمِنِيْنَ ۝٨١"},{"key":"37:82","surah":37,"ayah":82,"page":448,"text":" ثُمَّ اَغْرَقْنَا الْاٰخَرِيْنَ ۝٨٢"}]