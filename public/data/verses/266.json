[{"key":"15:73","surah":15,"ayah":73,"page":266,"text":"فَاَخَذَتْهُمُ الصَّيْحَةُ مُشْرِقِيْنَ ۝٧٣ۙ"},{"key":"15:74","surah":15,"ayah":74,"page":266,"text":" فَجَعَلْنَا عَالِيَهَا سَافِلَهَا وَاَمْطَرْنَا عَلَيْهِمْ حِجَارَةً مِّنْ سِجِّيْلٍ ۝٧٤ؕ"},{"key":"15:75","surah":15,"ayah":75,"page":266,"text":" اِنَّ فِيْ ذٰلِكَ لَاٰيٰتٍ لِّلْمُتَوَسِّمِيْنَ ۝٧٥"},{"key":"15:76","surah":15,"ayah":76,"page":266,"text":" وَاِنَّهَا لَبِسَبِيْلٍ مُّقِيْمٍ ۝٧٦"},{"key":"15:77","surah":15,"ayah":77,"page":266,"text":" اِنَّ فِيْ ذٰلِكَ لَاٰيَةً لِّلْمُو͏ٔ͏ْمِنِيْنَ ۝٧٧ؕ"},{"key":"15:78","surah":15,"ayah":78,"page":266,"text":" وَاِنْ كَانَ اَصْحٰبُ الْاَيْكَةِ لَظٰلِمِيْنَ ۝٧٨ۙ"},{"key":"15:79","surah":15,"ayah":79,"page":266,"text":"فَانْتَقَمْنَا مِنْهُمْۘ وَاِنَّهُمَا لَبِاِمَامٍ مُّبِيْنٍ ۝٧٩ؕࣖ"},{"key":"15:80","surah":15,"ayah":80,"page":266,"text":" وَلَقَدْ كَذَّبَ اَصْحٰبُ الْحِجْرِ الْمُرْسَلِيْنَ ۝٨٠ۙ"},{"key":"15:81","surah":15,"ayah":81,"page":266,"text":" وَاٰتَيْنٰهُمْ اٰيٰتِنَا فَكَانُوْا عَنْهَا مُعْرِضِيْنَ ۝٨١ۙ"},{"key":"15:82","surah":15,"ayah":82,"page":266,"text":" وَكَانُوْا يَنْحِتُوْنَ مِنَ الْجِبَالِ بُيُوْتًا اٰمِنِيْنَ ۝٨٢"},{"key":"15:83","surah":15,"ayah":83,"page":266,"text":"فَاَخَذَتْهُمُ الصَّيْحَةُ مُصْبِحِيْنَ ۝٨٣ۙ"},{"key":"15:84","surah":15,"ayah":84,"page":266,"text":" فَمَا͏ٓ اَغْنٰي عَنْهُمْ مَّا كَانُوْا يَكْسِبُوْنَ ۝٨٤ؕ"},{"key":"15:85","surah":15,"ayah":85,"page":266,"text":" وَمَا خَلَقْنَا السَّمٰوٰتِ وَالْاَرْضَ وَمَا بَيْنَهُمَا͏ٓ اِلَّا بِالْحَقِّؕ وَاِنَّ السَّاعَةَ لَاٰتِيَةٌ فَاصْفَحِ الصَّفْحَ الْجَمِيْلَ ۝٨٥"},{"key":"15:86","surah":15,"ayah":86,"page":266,"text":" اِنَّ رَبَّكَ هُوَ الْخَلّٰقُ الْعَلِيْمُ ۝٨٦"},{"key":"15:87","surah":15,"ayah":87,"page":266,"text":" وَلَقَدْ اٰتَيْنٰكَ سَبْعًا مِّنَ الْمَثَانِيْ وَالْقُرْاٰنَ الْعَظِيْمَ ۝٨٧"},{"key":"15:88","surah":15,"ayah":88,"page":266,"text":" لَا تَمُدَّنَّ عَيْنَيْكَ اِلٰي مَا مَتَّعْنَا بِهٖٓ اَزْوَاجًا مِّنْهُمْ وَلَا تَحْزَنْ عَلَيْهِمْ وَاخْفِضْ جَنَاحَكَ لِلْمُو͏ٔ͏ْمِنِيْنَ ۝٨٨"},{"key":"15:89","surah":15,"ayah":89,"page":266,"text":" وَقُلْ اِنِّيْٓ اَنَا النَّذِيْرُ الْمُبِيْنُ ۝٨٩ۚ"},{"key":"15:90","surah":15,"ayah":90,"page":266,"text":" كَمَا͏ٓ اَنْزَلْنَا عَلَي الْمُقْتَسِمِيْنَ ۝٩٠ۙ"}]