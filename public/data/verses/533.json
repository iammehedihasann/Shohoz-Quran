[{"key":"55:39","surah":55,"ayah":39,"page":533,"text":"فَيَوْمَىِٕذٍ لَّا يُسْـٔ͏َلُ عَنْ ذَنۢ͏ْبِهٖٓ اِنْسٌ وَّلَا جَا࢜نٌّ ۝٣٩ۚ"},{"key":"55:40","surah":55,"ayah":40,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٤٠"},{"key":"55:41","surah":55,"ayah":41,"page":533,"text":" يُعْرَفُ الْمُجْرِمُوْنَ بِسِيْمٰهُمْ فَيُو͏ٔ͏ْخَذُ بِالنَّوَاصِيْ وَالْاَقْدَامِ ۝٤١ۚ"},{"key":"55:42","surah":55,"ayah":42,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٤٢"},{"key":"55:43","surah":55,"ayah":43,"page":533,"text":" هٰذِهٖ جَهَنَّمُ الَّتِيْ يُكَذِّبُ بِهَا الْمُجْرِمُوْنَ ۝٤٣ۘ"},{"key":"55:44","surah":55,"ayah":44,"page":533,"text":" يَطُوْفُوْنَ بَيْنَهَا وَبَيْنَ حَمِيْمٍ اٰنٍ ۝٤٤ۚ"},{"key":"55:45","surah":55,"ayah":45,"page":533,"text":"فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٤٥ࣖ"},{"key":"55:46","surah":55,"ayah":46,"page":533,"text":" وَلِمَنْ خَافَ مَقَامَ رَبِّهٖ جَنَّتٰنِ ۝٤٦ۚ"},{"key":"55:47","surah":55,"ayah":47,"page":533,"text":"فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٤٧ۙ"},{"key":"55:48","surah":55,"ayah":48,"page":533,"text":" ذَوَاتَا͏ٓ اَفْنَانٍ ۝٤٨ۚ"},{"key":"55:49","surah":55,"ayah":49,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٤٩"},{"key":"55:50","surah":55,"ayah":50,"page":533,"text":" فِيْهِمَا عَيْنٰنِ تَجْرِيٰنِ ۝٥٠ۚ"},{"key":"55:51","surah":55,"ayah":51,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٥١"},{"key":"55:52","surah":55,"ayah":52,"page":533,"text":"فِيْهِمَا مِنْ كُلِّ فَاكِهَةٍ زَوْجٰنِ ۝٥٢ۚ"},{"key":"55:53","surah":55,"ayah":53,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٥٣"},{"key":"55:54","surah":55,"ayah":54,"page":533,"text":"مُتَّكِـِٕيْنَ عَلٰي فُرُشٍۢ بَطَا࢜ىِٕنُهَا مِنْ اِسْتَبْرَقٍؕ وَجَنَا الْجَنَّتَيْنِ دَانٍ ۝٥٤ۚ"},{"key":"55:55","surah":55,"ayah":55,"page":533,"text":"فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٥٥"},{"key":"55:56","surah":55,"ayah":56,"page":533,"text":" فِيْهِنَّ قٰصِرٰتُ الطَّرْفِۙ لَمْ يَطْمِثْهُنَّ اِنْسٌ قَبْلَهُمْ وَلَا جَا࢜نٌّ ۝٥٦ۚ"},{"key":"55:57","surah":55,"ayah":57,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٥٧ۚ"},{"key":"55:58","surah":55,"ayah":58,"page":533,"text":" كَاَنَّهُنَّ الْيَاقُوْتُ وَالْمَرْجَانُ ۝٥٨ۚ"},{"key":"55:59","surah":55,"ayah":59,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٥٩"},{"key":"55:60","surah":55,"ayah":60,"page":533,"text":" هَلْ جَزَا࢜ءُ الْاِحْسَانِ اِلَّا الْاِحْسَانُ ۝٦٠ۚ"},{"key":"55:61","surah":55,"ayah":61,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٦١"},{"key":"55:62","surah":55,"ayah":62,"page":533,"text":" وَمِنْ دُوْنِهِمَا جَنَّتٰنِ ۝٦٢ۚ"},{"key":"55:63","surah":55,"ayah":63,"page":533,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٦٣ۙ"},{"key":"55:64","surah":55,"ayah":64,"page":533,"text":" مُدْهَا࢜مَّتٰنِ ۝٦٤ۚ"},{"key":"55:65","surah":55,"ayah":65,"page":533,"text":"فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٦٥ۚ"},{"key":"55:66","surah":55,"ayah":66,"page":533,"text":" فِيْهِمَا عَيْنٰنِ نَضَّاخَتٰنِ ۝٦٦ۚ"}]