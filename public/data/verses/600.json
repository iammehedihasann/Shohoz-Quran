[{"key":"90:1","surah":90,"ayah":1,"page":600,"text":"لَا͏ٓ اُقْسِمُ بِهٰذَا الْبَلَدِ ۝١ۙ"},{"key":"90:2","surah":90,"ayah":2,"page":600,"text":" وَاَنْتَ حِلٌّۢ بِهٰذَا الْبَلَدِ ۝٢ۙ"},{"key":"90:3","surah":90,"ayah":3,"page":600,"text":" وَوَالِدٍ وَّمَا وَلَدَ ۝٣ۙ"},{"key":"90:4","surah":90,"ayah":4,"page":600,"text":" لَقَدْ خَلَقْنَا الْاِنْسَانَ فِيْ كَبَدٍ ۝٤ؕ"},{"key":"90:5","surah":90,"ayah":5,"page":600,"text":" اَيَحْسَبُ اَنْ لَّنْ يَّقْدِرَ عَلَيْهِ اَحَدٌ ۝٥ۘ"},{"key":"90:6","surah":90,"ayah":6,"page":600,"text":" يَقُوْلُ اَهْلَكْتُ مَالًا لُّبَدًا ۝٦ؕ"},{"key":"90:7","surah":90,"ayah":7,"page":600,"text":" اَيَحْسَبُ اَنْ لَّمْ يَرَهٗٓ اَحَدٌ ۝٧ؕ"},{"key":"90:8","surah":90,"ayah":8,"page":600,"text":" اَلَمْ نَجْعَلْ لَّهٗ عَيْنَيْنِ ۝٨ۙ"},{"key":"90:9","surah":90,"ayah":9,"page":600,"text":" وَلِسَانًا وَّشَفَتَيْنِ ۝٩ۙ"},{"key":"90:10","surah":90,"ayah":10,"page":600,"text":" وَهَدَيْنٰهُ النَّجْدَيْنِ ۝١٠ۚ"},{"key":"90:11","surah":90,"ayah":11,"page":600,"text":" فَلَا اقْتَحَمَ الْعَقَبَةَ ۝١١ؗۖ"},{"key":"90:12","surah":90,"ayah":12,"page":600,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا الْعَقَبَةُ ۝١٢ؕ"},{"key":"90:13","surah":90,"ayah":13,"page":600,"text":" فَكُّ رَقَبَةٍ ۝١٣ۙ"},{"key":"90:14","surah":90,"ayah":14,"page":600,"text":" اَوْ اِطْعٰمٌ فِيْ يَوْمٍ ذِيْ مَسْغَبَةٍ ۝١٤ۙ"},{"key":"90:15","surah":90,"ayah":15,"page":600,"text":" يَّتِيْمًا ذَا مَقْرَبَةٍ ۝١٥ۙ"},{"key":"90:16","surah":90,"ayah":16,"page":600,"text":"اَوْ مِسْكِيْنًا ذَا مَتْرَبَةٍ ۝١٦ؕ"},{"key":"90:17","surah":90,"ayah":17,"page":600,"text":" ثُمَّ كَانَ مِنَ الَّذِيْنَ اٰمَنُوْا وَتَوَاصَوْا بِالصَّبْرِ وَتَوَاصَوْا بِالْمَرْحَمَةِ ۝١٧ؕ"},{"key":"90:18","surah":90,"ayah":18,"page":600,"text":" اُولٰ࢜ىِٕكَ اَصْحٰبُ الْمَيْمَنَةِ ۝١٨ؕ"},{"key":"90:19","surah":90,"ayah":19,"page":600,"text":" وَالَّذِيْنَ كَفَرُوْا بِاٰيٰتِنَا هُمْ اَصْحٰبُ الْمَشْـٔ͏َمَةِ ۝١٩ؕ"},{"key":"90:20","surah":90,"ayah":20,"page":600,"text":" عَلَيْهِمْ نَارٌ مُّو͏ٔ͏ْصَدَةٌ ۝٢٠ࣖ"},{"key":"91:1","surah":91,"ayah":1,"page":600,"text":"وَالشَّمْسِ وَضُحٰىهَا ۝١ࣕۙ"},{"key":"91:2","surah":91,"ayah":2,"page":600,"text":" وَالْقَمَرِ اِذَا تَلٰىهَا ۝٢ࣕۙ"},{"key":"91:3","surah":91,"ayah":3,"page":600,"text":" وَالنَّهَارِ اِذَا جَلّٰىهَا ۝٣ࣕۙ"},{"key":"91:4","surah":91,"ayah":4,"page":600,"text":" وَالَّيْلِ اِذَا يَغْشٰىهَا ۝٤ࣕۙ"},{"key":"91:5","surah":91,"ayah":5,"page":600,"text":" وَالسَّمَا࢜ءِ وَمَا بَنٰىهَا ۝٥ࣕۙ"}]