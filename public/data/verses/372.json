[{"key":"26:118","surah":26,"ayah":118,"page":372,"text":"فَافْتَحْ بَيْنِيْ وَبَيْنَهُمْ فَتْحًا وَّنَجِّنِيْ وَمَنْ مَّعِيَ مِنَ الْمُو͏ٔ͏ْمِنِيْنَ ۝١١٨"},{"key":"26:119","surah":26,"ayah":119,"page":372,"text":"فَاَنْجَيْنٰهُ وَمَنْ مَّعَهٗ فِي الْفُلْكِ الْمَشْحُوْنِ ۝١١٩ۚ"},{"key":"26:120","surah":26,"ayah":120,"page":372,"text":" ثُمَّ اَغْرَقْنَا بَعْدُ الْبٰقِيْنَ ۝١٢٠ؕ"},{"key":"26:121","surah":26,"ayah":121,"page":372,"text":" اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝١٢١"},{"key":"26:122","surah":26,"ayah":122,"page":372,"text":"وَاِنَّ رَبَّكَ لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝١٢٢ࣖ"},{"key":"26:123","surah":26,"ayah":123,"page":372,"text":" كَذَّبَتْ عَادُ اࣙلْمُرْسَلِيْنَ ۝١٢٣ۚۖ"},{"key":"26:124","surah":26,"ayah":124,"page":372,"text":" اِذْ قَالَ لَهُمْ اَخُوْهُمْ هُوْدٌ اَلَا تَتَّقُوْنَ ۝١٢٤ۚ"},{"key":"26:125","surah":26,"ayah":125,"page":372,"text":" اِنِّيْ لَكُمْ رَسُوْلٌ اَمِيْنٌ ۝١٢٥ۙ"},{"key":"26:126","surah":26,"ayah":126,"page":372,"text":"فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١٢٦ۚ"},{"key":"26:127","surah":26,"ayah":127,"page":372,"text":" وَمَا͏ٓ اَسْـٔ͏َلُكُمْ عَلَيْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِيَ اِلَّا عَلٰي رَبِّ الْعٰلَمِيْنَ ۝١٢٧ؕ"},{"key":"26:128","surah":26,"ayah":128,"page":372,"text":" اَتَبْنُوْنَ بِكُلِّ رِيْعٍ اٰيَةً تَعْبَثُوْنَ ۝١٢٨ۙ"},{"key":"26:129","surah":26,"ayah":129,"page":372,"text":"وَتَتَّخِذُوْنَ مَصَانِعَ لَعَلَّكُمْ تَخْلُدُوْنَ ۝١٢٩ۚ"},{"key":"26:130","surah":26,"ayah":130,"page":372,"text":" وَاِذَا بَطَشْتُمْ بَطَشْتُمْ جَبَّارِيْنَ ۝١٣٠ۚ"},{"key":"26:131","surah":26,"ayah":131,"page":372,"text":" فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١٣١ۚ"},{"key":"26:132","surah":26,"ayah":132,"page":372,"text":" وَاتَّقُوا الَّذِيْٓ اَمَدَّكُمْ بِمَا تَعْلَمُوْنَ ۝١٣٢ۚ"},{"key":"26:133","surah":26,"ayah":133,"page":372,"text":" اَمَدَّكُمْ بِاَنْعَامٍ وَّبَنِيْنَ ۝١٣٣ۚۙ"},{"key":"26:134","surah":26,"ayah":134,"page":372,"text":" وَجَنّٰتٍ وَّعُيُوْنٍ ۝١٣٤ۚ"},{"key":"26:135","surah":26,"ayah":135,"page":372,"text":" اِنِّيْٓ اَخَافُ عَلَيْكُمْ عَذَابَ يَوْمٍ عَظِيْمٍ ۝١٣٥ؕ"},{"key":"26:136","surah":26,"ayah":136,"page":372,"text":" قَالُوْا سَوَا࢜ءٌ عَلَيْنَا͏ٓ اَوَعَظْتَ اَمْ لَمْ تَكُنْ مِّنَ الْوٰعِظِيْنَ ۝١٣٦ۙ"},{"key":"26:137","surah":26,"ayah":137,"page":372,"text":" اِنْ هٰذَا͏ٓ اِلَّا خُلُقُ الْاَوَّلِيْنَ ۝١٣٧ۙ"},{"key":"26:138","surah":26,"ayah":138,"page":372,"text":" وَمَا نَحْنُ بِمُعَذَّبِيْنَ ۝١٣٨ۚ"},{"key":"26:139","surah":26,"ayah":139,"page":372,"text":" فَكَذَّبُوْهُ فَاَهْلَكْنٰهُمْؕ اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝١٣٩"},{"key":"26:140","surah":26,"ayah":140,"page":372,"text":" وَاِنَّ رَبَّكَ لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝١٤٠ࣖ"},{"key":"26:141","surah":26,"ayah":141,"page":372,"text":" كَذَّبَتْ ثَمُوْدُ الْمُرْسَلِيْنَ ۝١٤١ۚۖ"},{"key":"26:142","surah":26,"ayah":142,"page":372,"text":" اِذْ قَالَ لَهُمْ اَخُوْهُمْ صٰلِحٌ اَلَا تَتَّقُوْنَ ۝١٤٢ۚ"}]