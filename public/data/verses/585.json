[{"key":"77:26","surah":77,"ayah":26,"page":585,"text":"اَحْيَا࢜ءً وَّاَمْوَاتًا ۝٢٦ۙ"},{"key":"77:27","surah":77,"ayah":27,"page":585,"text":" وَّجَعَلْنَا فِيْهَا رَوَاسِيَ شٰمِخٰتٍ وَّاَسْقَيْنٰكُمْ مَّا࢜ءً فُرَاتًا ۝٢٧ؕ"},{"key":"77:28","surah":77,"ayah":28,"page":585,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٢٨"},{"key":"77:29","surah":77,"ayah":29,"page":585,"text":"اِنْطَلِقُوْٓا اِلٰي مَا كُنْتُمْ بِهٖ تُكَذِّبُوْنَ ۝٢٩ۚ"},{"key":"77:30","surah":77,"ayah":30,"page":585,"text":" اِنْطَلِقُوْٓا اِلٰي ظِلٍّ ذِيْ ثَلٰثِ شُعَبٍ ۝٣٠ۙ"},{"key":"77:31","surah":77,"ayah":31,"page":585,"text":" لَّا ظَلِيْلٍ وَّلَا يُغْنِيْ مِنَ اللَّهَبِ ۝٣١ؕ"},{"key":"77:32","surah":77,"ayah":32,"page":585,"text":"اِنَّهَا تَرْمِيْ بِشَرَرٍ كَالْقَصْرِ ۝٣٢ۚ"},{"key":"77:33","surah":77,"ayah":33,"page":585,"text":" كَاَنَّهٗ جِمٰلَتٌ صُفْرٌ ۝٣٣ؕ"},{"key":"77:34","surah":77,"ayah":34,"page":585,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٣٤"},{"key":"77:35","surah":77,"ayah":35,"page":585,"text":" هٰذَا يَوْمُ لَا يَنْطِقُوْنَ ۝٣٥ۙ"},{"key":"77:36","surah":77,"ayah":36,"page":585,"text":" وَلَا يُو͏ٔ͏ْذَنُ لَهُمْ فَيَعْتَذِرُوْنَ ۝٣٦"},{"key":"77:37","surah":77,"ayah":37,"page":585,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٣٧"},{"key":"77:38","surah":77,"ayah":38,"page":585,"text":"هٰذَا يَوْمُ الْفَصْلِۚ جَمَعْنٰكُمْ وَالْاَوَّلِيْنَ ۝٣٨"},{"key":"77:39","surah":77,"ayah":39,"page":585,"text":" فَاِنْ كَانَ لَكُمْ كَيْدٌ فَكِيْدُوْنِ ۝٣٩"},{"key":"77:40","surah":77,"ayah":40,"page":585,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٤٠ࣖ"},{"key":"77:41","surah":77,"ayah":41,"page":585,"text":" اِنَّ الْمُتَّقِيْنَ فِيْ ظِلٰلٍ وَّعُيُوْنٍ ۝٤١ۙ"},{"key":"77:42","surah":77,"ayah":42,"page":585,"text":" وَّفَوَاكِهَ مِمَّا يَشْتَهُوْنَ ۝٤٢ؕ"},{"key":"77:43","surah":77,"ayah":43,"page":585,"text":"كُلُوْا وَاشْرَبُوْا هَنِيْ࢜ـٔ͏ًاۢ بِمَا كُنْتُمْ تَعْمَلُوْنَ ۝٤٣"},{"key":"77:44","surah":77,"ayah":44,"page":585,"text":" اِنَّا كَذٰلِكَ نَجْزِي الْمُحْسِنِيْنَ ۝٤٤"},{"key":"77:45","surah":77,"ayah":45,"page":585,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٤٥"},{"key":"77:46","surah":77,"ayah":46,"page":585,"text":" كُلُوْا وَتَمَتَّعُوْا قَلِيْلًا اِنَّكُمْ مُّجْرِمُوْنَ ۝٤٦"},{"key":"77:47","surah":77,"ayah":47,"page":585,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٤٧"},{"key":"77:48","surah":77,"ayah":48,"page":585,"text":" وَاِذَا قِيْلَ لَهُمُ ارْكَعُوْا لَا يَرْكَعُوْنَ ۝٤٨"},{"key":"77:49","surah":77,"ayah":49,"page":585,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝٤٩"},{"key":"77:50","surah":77,"ayah":50,"page":585,"text":" فَبِاَيِّ حَدِيْثٍۭ بَعْدَهٗ يُو͏ٔ͏ْمِنُوْنَ ۝٥٠ࣖ"}]