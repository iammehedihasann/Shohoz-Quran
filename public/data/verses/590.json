[{"key":"80:21","surah":80,"ayah":21,"page":590,"text":"ثُمَّ اَمَاتَهٗ فَاَقْبَرَهٗ ۝٢١ۙ"},{"key":"80:22","surah":80,"ayah":22,"page":590,"text":" ثُمَّ اِذَا شَا࢜ءَ اَنْشَرَهٗ ۝٢٢ؕ"},{"key":"80:23","surah":80,"ayah":23,"page":590,"text":" كَلَّا لَمَّا يَقْضِ مَا͏ٓ اَمَرَهٗ ۝٢٣ؕ"},{"key":"80:24","surah":80,"ayah":24,"page":590,"text":" فَلْيَنْظُرِ الْاِنْسَانُ اِلٰى طَعَامِهٖٓ ۝٢٤ۙ"},{"key":"80:25","surah":80,"ayah":25,"page":590,"text":" اَنَّا صَبَبْنَا الْمَا࢜ءَ صَبًّا ۝٢٥ۙ"},{"key":"80:26","surah":80,"ayah":26,"page":590,"text":" ثُمَّ شَقَقْنَا الْاَرْضَ شَقًّا ۝٢٦ۙ"},{"key":"80:27","surah":80,"ayah":27,"page":590,"text":" فَاَنۢ͏ْبَتْنَا فِيْهَا حَبًّا ۝٢٧ۙ"},{"key":"80:28","surah":80,"ayah":28,"page":590,"text":" وَّعِنَبًا وَّقَضْبًا ۝٢٨ۙ"},{"key":"80:29","surah":80,"ayah":29,"page":590,"text":" وَّزَيْتُوْنًا وَّنَخْلًا ۝٢٩ۙ"},{"key":"80:30","surah":80,"ayah":30,"page":590,"text":" وَّحَدَا࢜ىِٕقَ غُلْبًا ۝٣٠ۙ"},{"key":"80:31","surah":80,"ayah":31,"page":590,"text":" وَّفَاكِهَةً وَّاَبًّا ۝٣١ۙ"},{"key":"80:32","surah":80,"ayah":32,"page":590,"text":" مَّتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۝٣٢ؕ"},{"key":"80:33","surah":80,"ayah":33,"page":590,"text":" فَاِذَا جَا࢜ءَتِ الصَّا࢜خَّةُ ۝٣٣ؗ"},{"key":"80:34","surah":80,"ayah":34,"page":590,"text":" يَوْمَ يَفِرُّ الْمَرْءُ مِنْ اَخِيْهِ ۝٣٤ۙ"},{"key":"80:35","surah":80,"ayah":35,"page":590,"text":" وَاُمِّهٖ وَاَبِيْهِ ۝٣٥ۙ"},{"key":"80:36","surah":80,"ayah":36,"page":590,"text":" وَصَاحِبَتِهٖ وَبَنِيْهِ ۝٣٦ؕ"},{"key":"80:37","surah":80,"ayah":37,"page":590,"text":" لِكُلِّ امْرِي͏ٔ͏ٍ مِّنْهُمْ يَوْمَىِٕذٍ شَاْنٌ يُّغْنِيْهِ ۝٣٧ؕ"},{"key":"80:38","surah":80,"ayah":38,"page":590,"text":" وُجُوْهٌ يَّوْمَىِٕذٍ مُّسْفِرَةٌ ۝٣٨ۙ"},{"key":"80:39","surah":80,"ayah":39,"page":590,"text":" ضَاحِكَةٌ مُّسْتَبْشِرَةٌ ۝٣٩ۚ"},{"key":"80:40","surah":80,"ayah":40,"page":590,"text":" وَوُجُوْهٌ يَّوْمَىِٕذٍ عَلَيْهَا غَبَرَةٌ ۝٤٠ۙ"},{"key":"80:41","surah":80,"ayah":41,"page":590,"text":" تَرْهَقُهَا قَتَرَةٌ ۝٤١ؕ"},{"key":"80:42","surah":80,"ayah":42,"page":590,"text":" اُولٰ࢜ىِٕكَ هُمُ الْكَفَرَةُ الْفَجَرَةُ ۝٤٢ࣖ"},{"key":"81:1","surah":81,"ayah":1,"page":590,"text":"اِذَا الشَّمْسُ كُوِّرَتْ ۝١ࣕۙ"},{"key":"81:2","surah":81,"ayah":2,"page":590,"text":" وَاِذَا النُّجُوْمُ انْكَدَرَتْ ۝٢ࣕۙ"},{"key":"81:3","surah":81,"ayah":3,"page":590,"text":" وَاِذَا الْجِبَالُ سُيِّرَتْ ۝٣ࣕۙ"},{"key":"81:4","surah":81,"ayah":4,"page":590,"text":" وَاِذَا الْعِشَارُ عُطِّلَتْ ۝٤ࣕۙ"},{"key":"81:5","surah":81,"ayah":5,"page":590,"text":" وَاِذَا الْوُحُوْشُ حُشِرَتْ ۝٥ࣕۙ"},{"key":"81:6","surah":81,"ayah":6,"page":590,"text":" وَاِذَا الْبِحَارُ سُجِّرَتْ ۝٦ࣕۙ"},{"key":"81:7","surah":81,"ayah":7,"page":590,"text":" وَاِذَا النُّفُوْسُ زُوِّجَتْ ۝٧ࣕۙ"}]