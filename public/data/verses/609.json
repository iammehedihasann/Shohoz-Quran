[{"key":"109:3","surah":109,"ayah":3,"page":609,"text":"وَلَا͏ٓ اَنْتُمْ عٰبِدُوْنَ مَا͏ٓ اَعْبُدُ ۝٣ۚ"},{"key":"109:4","surah":109,"ayah":4,"page":609,"text":" وَلَا͏ٓ اَنَا عَابِدٌ مَّا عَبَدْتُّمْ ۝٤ۙ"},{"key":"109:5","surah":109,"ayah":5,"page":609,"text":"وَلَا͏ٓ اَنْتُمْ عٰبِدُوْنَ مَا͏ٓ اَعْبُدُ ۝٥ؕ"},{"key":"109:6","surah":109,"ayah":6,"page":609,"text":" لَكُمْ دِيْنُكُمْ وَلِيَ دِيْنِ ۝٦ࣖ"},{"key":"110:1","surah":110,"ayah":1,"page":609,"text":"اِذَا جَا࢜ءَ نَصْرُ اللّٰهِ وَالْفَتْحُ ۝١ۙ"},{"key":"110:2","surah":110,"ayah":2,"page":609,"text":" وَرَاَيْتَ النَّاسَ يَدْخُلُوْنَ فِيْ دِيْنِ اللّٰهِ اَفْوَاجًا ۝٢ۙ"},{"key":"110:3","surah":110,"ayah":3,"page":609,"text":" فَسَبِّحْ بِحَمْدِ رَبِّكَ وَاسْتَغْفِرْهُؕؔ اِنَّهٗ كَانَ تَوَّابًا ۝٣ࣖ"},{"key":"111:1","surah":111,"ayah":1,"page":609,"text":"تَبَّتْ يَدَا͏ٓ اَبِيْ لَهَبٍ وَّتَبَّ ۝١ؕ"},{"key":"111:2","surah":111,"ayah":2,"page":609,"text":" مَا͏ٓ اَغْنٰي عَنْهُ مَالُهٗ وَمَا كَسَبَ ۝٢ؕ"},{"key":"111:3","surah":111,"ayah":3,"page":609,"text":" سَيَصْلٰي نَارًا ذَاتَ لَهَبٍ ۝٣ۚۖ"},{"key":"111:4","surah":111,"ayah":4,"page":609,"text":" وَّامْرَاَتُهٗؕ حَمَّالَةَ الْحَطَبِ ۝٤ۚ"},{"key":"111:5","surah":111,"ayah":5,"page":609,"text":" فِيْ جِيْدِهَا حَبْلٌ مِّنْ مَّسَدٍ ۝٥ࣖ"},{"key":"112:1","surah":112,"ayah":1,"page":609,"text":"قُلْ هُوَ اللّٰهُ اَحَدٌ ۝١ۚ"},{"key":"112:2","surah":112,"ayah":2,"page":609,"text":" اَللّٰهُ الصَّمَدُ ۝٢ۚ"},{"key":"112:3","surah":112,"ayah":3,"page":609,"text":" لَمْ يَلِدْ࣢ۙ وَلَمْ يُوْلَدْ ۝٣ۙ"},{"key":"112:4","surah":112,"ayah":4,"page":609,"text":" وَلَمْ يَكُنْ لَّهٗ كُفُوًا اَحَدٌ ۝٤ࣖ"}]