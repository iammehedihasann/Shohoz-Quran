[{"key":"103:1","surah":103,"ayah":1,"page":607,"text":"وَالْعَصْرِ ۝١ۙ"},{"key":"103:2","surah":103,"ayah":2,"page":607,"text":" اِنَّ الْاِنْسَانَ لَفِيْ خُسْرٍ ۝٢ۙ"},{"key":"103:3","surah":103,"ayah":3,"page":607,"text":" اِلَّا الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِ وَتَوَاصَوْا بِالْحَقِّ࣢ۙ وَتَوَاصَوْا بِالصَّبْرِ ۝٣ࣖ"},{"key":"104:1","surah":104,"ayah":1,"page":607,"text":"وَيْلٌ لِّكُلِّ هُمَزَةٍ لُّمَزَةِ ۝١ۙ"},{"key":"104:2","surah":104,"ayah":2,"page":607,"text":" اࣙلَّذِيْ جَمَعَ مَالًا وَّعَدَّدَهٗ ۝٢ۙ"},{"key":"104:3","surah":104,"ayah":3,"page":607,"text":"يَحْسَبُ اَنَّ مَالَهٗٓ اَخْلَدَهٗ ۝٣ۚ"},{"key":"104:4","surah":104,"ayah":4,"page":607,"text":" كَلَّا لَيُنۢ͏ْبَذَنَّ فِي الْحُطَمَةِ ۝٤ؗۖ"},{"key":"104:5","surah":104,"ayah":5,"page":607,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا الْحُطَمَةُ ۝٥ؕ"},{"key":"104:6","surah":104,"ayah":6,"page":607,"text":" نَارُ اللّٰهِ الْمُوْقَدَةُ ۝٦ۙ"},{"key":"104:7","surah":104,"ayah":7,"page":607,"text":" الَّتِيْ تَطَّلِعُ عَلَي الْاَفْـِٕدَةِ ۝٧ؕ"},{"key":"104:8","surah":104,"ayah":8,"page":607,"text":" اِنَّهَا عَلَيْهِمْ مُّو͏ٔ͏ْصَدَةٌ ۝٨ۙ"},{"key":"104:9","surah":104,"ayah":9,"page":607,"text":" فِيْ عَمَدٍ مُّمَدَّدَةٍ ۝٩ࣖ"},{"key":"105:1","surah":105,"ayah":1,"page":607,"text":"اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِاَصْحٰبِ الْفِيْلِ ۝١ؕ"},{"key":"105:2","surah":105,"ayah":2,"page":607,"text":" اَلَمْ يَجْعَلْ كَيْدَهُمْ فِيْ تَضْلِيْلٍ ۝٢ۙ"},{"key":"105:3","surah":105,"ayah":3,"page":607,"text":" وَّاَرْسَلَ عَلَيْهِمْ طَيْرًا اَبَابِيْلَ ۝٣ۙ"},{"key":"105:4","surah":105,"ayah":4,"page":607,"text":"تَرْمِيْهِمْ بِحِجَارَةٍ مِّنْ سِجِّيْلٍ ۝٤ࣕۙ"},{"key":"105:5","surah":105,"ayah":5,"page":607,"text":" فَجَعَلَهُمْ كَعَصْفٍ مَّاْكُوْلٍ ۝٥ࣖ"}]