[{"key":"79:9","surah":79,"ayah":9,"page":588,"text":"اَبْصَارُهَا خَاشِعَةٌ ۝٩ۘ"},{"key":"79:10","surah":79,"ayah":10,"page":588,"text":" يَقُوْلُوْنَ ءَاِنَّا لَمَرْدُوْدُوْنَ فِي الْحَافِرَةِ ۝١٠ؕ"},{"key":"79:11","surah":79,"ayah":11,"page":588,"text":"ءَاِذَا كُنَّا عِظَامًا نَّخِرَةً ۝١١ؕ"},{"key":"79:12","surah":79,"ayah":12,"page":588,"text":" قَالُوْا تِلْكَ اِذًا كَرَّةٌ خَاسِرَةٌ ۝١٢ۘ"},{"key":"79:13","surah":79,"ayah":13,"page":588,"text":"فَاِنَّمَا هِيَ زَجْرَةٌ وَّاحِدَةٌ ۝١٣ۙ"},{"key":"79:14","surah":79,"ayah":14,"page":588,"text":" فَاِذَا هُمْ بِالسَّاهِرَةِ ۝١٤ؕ"},{"key":"79:15","surah":79,"ayah":15,"page":588,"text":" هَلْ اَتٰىكَ حَدِيْثُ مُوْسٰي ۝١٥ۘ"},{"key":"79:16","surah":79,"ayah":16,"page":588,"text":" اِذْ نَادٰىهُ رَبُّهٗ بِالْوَادِ الْمُقَدَّسِ طُوًي ۝١٦ۚ"},{"key":"79:17","surah":79,"ayah":17,"page":588,"text":"اِذْهَبْ اِلٰي فِرْعَوْنَ اِنَّهٗ طَغٰي ۝١٧ؗۖ"},{"key":"79:18","surah":79,"ayah":18,"page":588,"text":" فَقُلْ هَلْ لَّكَ اِلٰٓي اَنْ تَزَكّٰي ۝١٨ۙ"},{"key":"79:19","surah":79,"ayah":19,"page":588,"text":" وَاَهْدِيَكَ اِلٰي رَبِّكَ فَتَخْشٰي ۝١٩ۚ"},{"key":"79:20","surah":79,"ayah":20,"page":588,"text":" فَاَرٰىهُ الْاٰيَةَ الْكُبْرٰي ۝٢٠ؗۖ"},{"key":"79:21","surah":79,"ayah":21,"page":588,"text":" فَكَذَّبَ وَعَصٰي ۝٢١ؗۖ"},{"key":"79:22","surah":79,"ayah":22,"page":588,"text":" ثُمَّ اَدْبَرَ يَسْعٰي ۝٢٢ؗۖ"},{"key":"79:23","surah":79,"ayah":23,"page":588,"text":" فَحَشَرَ فَنَادٰي ۝٢٣ؗۖ"},{"key":"79:24","surah":79,"ayah":24,"page":588,"text":" فَقَالَ اَنَا رَبُّكُمُ الْاَعْلٰي ۝٢٤ؗۖ"},{"key":"79:25","surah":79,"ayah":25,"page":588,"text":" فَاَخَذَهُ اللّٰهُ نَكَالَ الْاٰخِرَةِ وَالْاُوْلٰي ۝٢٥ؕ"},{"key":"79:26","surah":79,"ayah":26,"page":588,"text":" اِنَّ فِيْ ذٰلِكَ لَعِبْرَةً لِّمَنْ يَّخْشٰي ۝٢٦ؕࣖ"},{"key":"79:27","surah":79,"ayah":27,"page":588,"text":" ءَاَنْتُمْ اَشَدُّ خَلْقًا اَمِ السَّمَا࢜ءُؕ بَنٰىهَا ۝٢٧ۙ"},{"key":"79:28","surah":79,"ayah":28,"page":588,"text":" رَفَعَ سَمْكَهَا فَسَوّٰىهَا ۝٢٨ۙ"},{"key":"79:29","surah":79,"ayah":29,"page":588,"text":"وَاَغْطَشَ لَيْلَهَا وَاَخْرَجَ ضُحٰىهَا ۝٢٩ࣕ"},{"key":"79:30","surah":79,"ayah":30,"page":588,"text":" وَالْاَرْضَ بَعْدَ ذٰلِكَ دَحٰىهَا ۝٣٠ؕ"},{"key":"79:31","surah":79,"ayah":31,"page":588,"text":" اَخْرَجَ مِنْهَا مَا࢜ءَهَا وَمَرْعٰىهَا ۝٣١ࣕ"},{"key":"79:32","surah":79,"ayah":32,"page":588,"text":" وَالْجِبَالَ اَرْسٰىهَا ۝٣٢ۙ"},{"key":"79:33","surah":79,"ayah":33,"page":588,"text":"مَتَاعًا لَّكُمْ وَلِاَنْعَامِكُمْ ۝٣٣ؕ"},{"key":"79:34","surah":79,"ayah":34,"page":588,"text":" فَاِذَا جَا࢜ءَتِ الطَّا࢜مَّةُ الْكُبْرٰي ۝٣٤ؗۖ"},{"key":"79:35","surah":79,"ayah":35,"page":588,"text":"يَوْمَ يَتَذَكَّرُ الْاِنْسَانُ مَا سَعٰي ۝٣٥ۙ"},{"key":"79:36","surah":79,"ayah":36,"page":588,"text":" وَبُرِّزَتِ الْجَحِيْمُ لِمَنْ يَّرٰي ۝٣٦"},{"key":"79:37","surah":79,"ayah":37,"page":588,"text":" فَاَمَّا مَنْ طَغٰي ۝٣٧ۙ"},{"key":"79:38","surah":79,"ayah":38,"page":588,"text":" وَاٰثَرَ الْحَيٰوةَ الدُّنْيَا ۝٣٨ۙ"}]