[{"key":"37:4","surah":37,"ayah":4,"page":446,"text":"اِنَّ اِلٰهَكُمْ لَوَاحِدٌ ۝٤ؕ"},{"key":"37:5","surah":37,"ayah":5,"page":446,"text":" رَبُّ السَّمٰوٰتِ وَالْاَرْضِ وَمَا بَيْنَهُمَا وَرَبُّ الْمَشَارِقِ ۝٥ؕ"},{"key":"37:6","surah":37,"ayah":6,"page":446,"text":" اِنَّا زَيَّنَّا السَّمَا࢜ءَ الدُّنْيَا بِزِيْنَةِ اࣙلْكَوَاكِبِ ۝٦ۙ"},{"key":"37:7","surah":37,"ayah":7,"page":446,"text":" وَحِفْظًا مِّنْ كُلِّ شَيْطٰنٍ مَّارِدٍ ۝٧ۚ"},{"key":"37:8","surah":37,"ayah":8,"page":446,"text":" لَا يَسَّمَّعُوْنَ اِلَي الْمَلَاِ الْاَعْلٰي وَيُقْذَفُوْنَ مِنْ كُلِّ جَانِبٍ ۝٨ࣗۖ"},{"key":"37:9","surah":37,"ayah":9,"page":446,"text":" دُحُوْرًا وَّلَهُمْ عَذَابٌ وَّاصِبٌ ۝٩ۙ"},{"key":"37:10","surah":37,"ayah":10,"page":446,"text":" اِلَّا مَنْ خَطِفَ الْخَطْفَةَ فَاَتْبَعَهٗ شِهَابٌ ثَاقِبٌ ۝١٠"},{"key":"37:11","surah":37,"ayah":11,"page":446,"text":" فَاسْتَفْتِهِمْ اَهُمْ اَشَدُّ خَلْقًا اَمْ مَّنْ خَلَقْنَاؕ اِنَّا خَلَقْنٰهُمْ مِّنْ طِيْنٍ لَّازِبٍ ۝١١"},{"key":"37:12","surah":37,"ayah":12,"page":446,"text":" بَلْ عَجِبْتَ وَيَسْخَرُوْنَ ۝١٢ࣕ"},{"key":"37:13","surah":37,"ayah":13,"page":446,"text":" وَاِذَا ذُكِّرُوْا لَا يَذْكُرُوْنَ ۝١٣ࣕ"},{"key":"37:14","surah":37,"ayah":14,"page":446,"text":" وَاِذَا رَاَوْا اٰيَةً يَّسْتَسْخِرُوْنَ ۝١٤ࣕ"},{"key":"37:15","surah":37,"ayah":15,"page":446,"text":" وَقَالُوْٓا اِنْ هٰذَا͏ٓ اِلَّا سِحْرٌ مُّبِيْنٌ ۝١٥ۚۖ"},{"key":"37:16","surah":37,"ayah":16,"page":446,"text":" ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبْعُوْثُوْنَ ۝١٦ۙ"},{"key":"37:17","surah":37,"ayah":17,"page":446,"text":"اَوَاٰبَا࢜و͏ٔ͏ُنَا الْاَوَّلُوْنَ ۝١٧ؕ"},{"key":"37:18","surah":37,"ayah":18,"page":446,"text":" قُلْ نَعَمْ وَاَنْتُمْ دَاخِرُوْنَ ۝١٨ۚ"},{"key":"37:19","surah":37,"ayah":19,"page":446,"text":" فَاِنَّمَا هِيَ زَجْرَةٌ وَّاحِدَةٌ فَاِذَا هُمْ يَنْظُرُوْنَ ۝١٩"},{"key":"37:20","surah":37,"ayah":20,"page":446,"text":" وَقَالُوْا يٰوَيْلَنَا هٰذَا يَوْمُ الدِّيْنِ ۝٢٠"},{"key":"37:21","surah":37,"ayah":21,"page":446,"text":" هٰذَا يَوْمُ الْفَصْلِ الَّذِيْ كُنْتُمْ بِهٖ تُكَذِّبُوْنَ ۝٢١ࣖ"},{"key":"37:22","surah":37,"ayah":22,"page":446,"text":" اُحْشُرُوا الَّذِيْنَ ظَلَمُوْا وَاَزْوَاجَهُمْ وَمَا كَانُوْا يَعْبُدُوْنَ ۝٢٢ۙ"},{"key":"37:23","surah":37,"ayah":23,"page":446,"text":" مِنْ دُوْنِ اللّٰهِ فَاهْدُوْهُمْ اِلٰي صِرَاطِ الْجَحِيْمِ ۝٢٣"},{"key":"37:24","surah":37,"ayah":24,"page":446,"text":"وَقِفُوْهُمْ اِنَّهُمْ مَّسْـٔ͏ُوْلُوْنَ ۝٢٤ۙ"},{"key":"37:25","surah":37,"ayah":25,"page":446,"text":" مَا لَكُمْ لَا تَنَاصَرُوْنَ ۝٢٥"},{"key":"37:26","surah":37,"ayah":26,"page":446,"text":" بَلْ هُمُ الْيَوْمَ مُسْتَسْلِمُوْنَ ۝٢٦"},{"key":"37:27","surah":37,"ayah":27,"page":446,"text":" وَاَقْبَلَ بَعْضُهُمْ عَلٰي بَعْضٍ يَّتَسَا࢜ءَلُوْنَ ۝٢٧"},{"key":"37:28","surah":37,"ayah":28,"page":446,"text":" قَالُوْٓا اِنَّكُمْ كُنْتُمْ تَاْتُوْنَنَا عَنِ الْيَمِيْنِ ۝٢٨"},{"key":"37:29","surah":37,"ayah":29,"page":446,"text":" قَالُوْا بَلْ لَّمْ تَكُوْنُوْا مُو͏ٔ͏ْمِنِيْنَ ۝٢٩ۚ"}]