[{"key":"56:17","surah":56,"ayah":17,"page":535,"text":"يَطُوْفُ عَلَيْهِمْ وِلْدَانٌ مُّخَلَّدُوْنَ ۝١٧ۙ"},{"key":"56:18","surah":56,"ayah":18,"page":535,"text":" بِاَكْوَابٍ وَّاَبَارِيْقَ࣢ۙ وَكَاْسٍ مِّنْ مَّعِيْنٍ ۝١٨ۙ"},{"key":"56:19","surah":56,"ayah":19,"page":535,"text":" لَّا يُصَدَّعُوْنَ عَنْهَا وَلَا يُنْزِفُوْنَ ۝١٩ۙ"},{"key":"56:20","surah":56,"ayah":20,"page":535,"text":" وَفَاكِهَةٍ مِّمَّا يَتَخَيَّرُوْنَ ۝٢٠ۙ"},{"key":"56:21","surah":56,"ayah":21,"page":535,"text":" وَلَحْمِ طَيْرٍ مِّمَّا يَشْتَهُوْنَ ۝٢١ؕ"},{"key":"56:22","surah":56,"ayah":22,"page":535,"text":" وَحُوْرٌ عِيْنٌ ۝٢٢ۙ"},{"key":"56:23","surah":56,"ayah":23,"page":535,"text":" كَاَمْثَالِ اللُّو͏ٔ͏ْلُوءِ الْمَكْنُوْنِ ۝٢٣ۚ"},{"key":"56:24","surah":56,"ayah":24,"page":535,"text":" جَزَا࢜ءًۢ بِمَا كَانُوْا يَعْمَلُوْنَ ۝٢٤"},{"key":"56:25","surah":56,"ayah":25,"page":535,"text":" لَا يَسْمَعُوْنَ فِيْهَا لَغْوًا وَّلَا تَاْثِيْمًا ۝٢٥ۙ"},{"key":"56:26","surah":56,"ayah":26,"page":535,"text":" اِلَّا قِيْلًا سَلٰمًا سَلٰمًا ۝٢٦"},{"key":"56:27","surah":56,"ayah":27,"page":535,"text":" وَاَصْحٰبُ الْيَمِيْنِ࣢ۙ مَا͏ٓ اَصْحٰبُ الْيَمِيْنِ ۝٢٧ؕ"},{"key":"56:28","surah":56,"ayah":28,"page":535,"text":" فِيْ سِدْرٍ مَّخْضُوْدٍ ۝٢٨ۙ"},{"key":"56:29","surah":56,"ayah":29,"page":535,"text":" وَّطَلْحٍ مَّنْضُوْدٍ ۝٢٩ۙ"},{"key":"56:30","surah":56,"ayah":30,"page":535,"text":" وَّظِلٍّ مَّمْدُوْدٍ ۝٣٠ۙ"},{"key":"56:31","surah":56,"ayah":31,"page":535,"text":"وَّمَا࢜ءٍ مَّسْكُوْبٍ ۝٣١ۙ"},{"key":"56:32","surah":56,"ayah":32,"page":535,"text":" وَّفَاكِهَةٍ كَثِيْرَةٍ ۝٣٢ۙ"},{"key":"56:33","surah":56,"ayah":33,"page":535,"text":" لَّا مَقْطُوْعَةٍ وَّلَا مَمْنُوْعَةٍ ۝٣٣ۙ"},{"key":"56:34","surah":56,"ayah":34,"page":535,"text":"وَّفُرُشٍ مَّرْفُوْعَةٍ ۝٣٤ؕ"},{"key":"56:35","surah":56,"ayah":35,"page":535,"text":" اِنَّا͏ٓ اَنْشَاْنٰهُنَّ اِنْشَا࢜ءً ۝٣٥ۙ"},{"key":"56:36","surah":56,"ayah":36,"page":535,"text":" فَجَعَلْنٰهُنَّ اَبْكَارًا ۝٣٦ۙ"},{"key":"56:37","surah":56,"ayah":37,"page":535,"text":"عُرُبًا اَتْرَابًا ۝٣٧ۙ"},{"key":"56:38","surah":56,"ayah":38,"page":535,"text":" لِّاَصْحٰبِ الْيَمِيْنِ ۝٣٨ؕࣖ"},{"key":"56:39","surah":56,"ayah":39,"page":535,"text":" ثُلَّةٌ مِّنَ الْاَوَّلِيْنَ ۝٣٩ۙ"},{"key":"56:40","surah":56,"ayah":40,"page":535,"text":" وَثُلَّةٌ مِّنَ الْاٰخِرِيْنَ ۝٤٠ؕ"},{"key":"56:41","surah":56,"ayah":41,"page":535,"text":" وَاَصْحٰبُ الشِّمَالِ࣢ۙ مَا͏ٓ اَصْحٰبُ الشِّمَالِ ۝٤١ؕ"},{"key":"56:42","surah":56,"ayah":42,"page":535,"text":" فِيْ سَمُوْمٍ وَّحَمِيْمٍ ۝٤٢ۙ"},{"key":"56:43","surah":56,"ayah":43,"page":535,"text":" وَّظِلٍّ مِّنْ يَّحْمُوْمٍ ۝٤٣ۙ"},{"key":"56:44","surah":56,"ayah":44,"page":535,"text":" لَّا بَارِدٍ وَّلَا كَرِيْمٍ ۝٤٤"},{"key":"56:45","surah":56,"ayah":45,"page":535,"text":" اِنَّهُمْ كَانُوْا قَبْلَ ذٰلِكَ مُتْرَفِيْنَ ۝٤٥ۚۖ"},{"key":"56:46","surah":56,"ayah":46,"page":535,"text":" وَكَانُوْا يُصِرُّوْنَ عَلَي الْحِنْثِ الْعَظِيْمِ ۝٤٦ۚ"},{"key":"56:47","surah":56,"ayah":47,"page":535,"text":" وَكَانُوْا يَقُوْلُوْنَ࣢ۙ اَىِٕذَا مِتْنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَبْعُوْثُوْنَ ۝٤٧ۙ"},{"key":"56:48","surah":56,"ayah":48,"page":535,"text":"اَوَاٰبَا࢜و͏ٔ͏ُنَا الْاَوَّلُوْنَ ۝٤٨"},{"key":"56:49","surah":56,"ayah":49,"page":535,"text":" قُلْ اِنَّ الْاَوَّلِيْنَ وَالْاٰخِرِيْنَ ۝٤٩ۙ"},{"key":"56:50","surah":56,"ayah":50,"page":535,"text":" لَمَجْمُوْعُوْنَ࣢ۙ اِلٰي مِيْقَاتِ يَوْمٍ مَّعْلُوْمٍ ۝٥٠"},{"key":"56:51","surah":56,"ayah":51,"page":535,"text":" ثُمَّ اِنَّكُمْ اَيُّهَا الضَّا࢜لُّوْنَ الْمُكَذِّبُوْنَ ۝٥١ۙ"}]