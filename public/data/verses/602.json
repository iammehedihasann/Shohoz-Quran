[{"key":"92:19","surah":92,"ayah":19,"page":602,"text":"وَمَا لِاَحَدٍ عِنْدَهٗ مِنْ نِّعْمَةٍ تُجْزٰٓي ۝١٩ۙ"},{"key":"92:20","surah":92,"ayah":20,"page":602,"text":" اِلَّا ابْتِغَا࢜ءَ وَجْهِ رَبِّهِ الْاَعْلٰي ۝٢٠ۚ"},{"key":"92:21","surah":92,"ayah":21,"page":602,"text":" وَلَسَوْفَ يَرْضٰي ۝٢١ࣖ"},{"key":"93:1","surah":93,"ayah":1,"page":602,"text":"وَالضُّحٰي ۝١ۙ"},{"key":"93:2","surah":93,"ayah":2,"page":602,"text":" وَالَّيْلِ اِذَا سَجٰي ۝٢ۙ"},{"key":"93:3","surah":93,"ayah":3,"page":602,"text":" مَا وَدَّعَكَ رَبُّكَ وَمَا قَلٰي ۝٣ؕ"},{"key":"93:4","surah":93,"ayah":4,"page":602,"text":"وَلَلْاٰخِرَةُ خَيْرٌ لَّكَ مِنَ الْاُوْلٰي ۝٤ؕ"},{"key":"93:5","surah":93,"ayah":5,"page":602,"text":" وَلَسَوْفَ يُعْطِيْكَ رَبُّكَ فَتَرْضٰي ۝٥ؕ"},{"key":"93:6","surah":93,"ayah":6,"page":602,"text":" اَلَمْ يَجِدْكَ يَتِيْمًا فَاٰوٰي ۝٦ࣕ"},{"key":"93:7","surah":93,"ayah":7,"page":602,"text":" وَوَجَدَكَ ضَا࢜لًّا فَهَدٰي ۝٧ࣕ"},{"key":"93:8","surah":93,"ayah":8,"page":602,"text":" وَوَجَدَكَ عَا࢜ىِٕلًا فَاَغْنٰي ۝٨ؕ"},{"key":"93:9","surah":93,"ayah":9,"page":602,"text":" فَاَمَّا الْيَتِيْمَ فَلَا تَقْهَرْ ۝٩ؕ"},{"key":"93:10","surah":93,"ayah":10,"page":602,"text":"وَاَمَّا السَّا࢜ىِٕلَ فَلَا تَنْهَرْ ۝١٠ؕ"},{"key":"93:11","surah":93,"ayah":11,"page":602,"text":" وَاَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ ۝١١ࣖ"},{"key":"94:1","surah":94,"ayah":1,"page":602,"text":"اَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ۝١ۙ"},{"key":"94:2","surah":94,"ayah":2,"page":602,"text":" وَوَضَعْنَا عَنْكَ وِزْرَكَ ۝٢ۙ"},{"key":"94:3","surah":94,"ayah":3,"page":602,"text":"الَّذِيْٓ اَنْقَضَ ظَهْرَكَ ۝٣ۙ"},{"key":"94:4","surah":94,"ayah":4,"page":602,"text":" وَرَفَعْنَا لَكَ ذِكْرَكَ ۝٤ؕ"},{"key":"94:5","surah":94,"ayah":5,"page":602,"text":" فَاِنَّ مَعَ الْعُسْرِ يُسْرًا ۝٥ۙ"},{"key":"94:6","surah":94,"ayah":6,"page":602,"text":" اِنَّ مَعَ الْعُسْرِ يُسْرًا ۝٦ؕ"},{"key":"94:7","surah":94,"ayah":7,"page":602,"text":" فَاِذَا فَرَغْتَ فَانْصَبْ ۝٧ۙ"},{"key":"94:8","surah":94,"ayah":8,"page":602,"text":" وَاِلٰي رَبِّكَ فَارْغَبْ ۝٨ࣖ"}]