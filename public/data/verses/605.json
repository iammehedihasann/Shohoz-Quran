[{"key":"98:7","surah":98,"ayah":7,"page":605,"text":"اِنَّ الَّذِيْنَ اٰمَنُوْا وَعَمِلُوا الصّٰلِحٰتِۙ اُولٰ࢜ىِٕكَ هُمْ خَيْرُ الْبَرِيَّةِ ۝٧ؕ"},{"key":"98:8","surah":98,"ayah":8,"page":605,"text":"جَزَا࢜و͏ٔ͏ُهُمْ عِنْدَ رَبِّهِمْ جَنّٰتُ عَدْنٍ تَجْرِيْ مِنْ تَحْتِهَا الْاَنْهٰرُ خٰلِدِيْنَ فِيْهَا͏ٓ اَبَدًاؕ رَضِيَ اللّٰهُ عَنْهُمْ وَرَضُوْا عَنْهُؕ ذٰلِكَ لِمَنْ خَشِيَ رَبَّهٗ ۝٨ࣖ"},{"key":"99:1","surah":99,"ayah":1,"page":605,"text":"اِذَا زُلْزِلَتِ الْاَرْضُ زِلْزَالَهَا ۝١ۙ"},{"key":"99:2","surah":99,"ayah":2,"page":605,"text":" وَاَخْرَجَتِ الْاَرْضُ اَثْقَالَهَا ۝٢ۙ"},{"key":"99:3","surah":99,"ayah":3,"page":605,"text":"وَقَالَ الْاِنْسَانُ مَا لَهَا ۝٣ۚ"},{"key":"99:4","surah":99,"ayah":4,"page":605,"text":" يَوْمَىِٕذٍ تُحَدِّثُ اَخْبَارَهَا ۝٤ؕ"},{"key":"99:5","surah":99,"ayah":5,"page":605,"text":" بِاَنَّ رَبَّكَ اَوْحٰي لَهَا ۝٥ؕ"},{"key":"99:6","surah":99,"ayah":6,"page":605,"text":" يَوْمَىِٕذٍ يَّصْدُرُ النَّاسُ اَشْتَاتًا࣢ۙ لِّيُرَوْا اَعْمَالَهُمْ ۝٦ؕ"},{"key":"99:7","surah":99,"ayah":7,"page":605,"text":" فَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَّرَهٗ ۝٧ؕ"},{"key":"99:8","surah":99,"ayah":8,"page":605,"text":" وَمَنْ يَّعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَّرَهٗ ۝٨ࣖ"},{"key":"100:1","surah":100,"ayah":1,"page":605,"text":"وَالْعٰدِيٰتِ ضَبْحًا ۝١ۙ"},{"key":"100:2","surah":100,"ayah":2,"page":605,"text":" فَالْمُوْرِيٰتِ قَدْحًا ۝٢ۙ"},{"key":"100:3","surah":100,"ayah":3,"page":605,"text":" فَالْمُغِيْرٰتِ صُبْحًا ۝٣ۙ"},{"key":"100:4","surah":100,"ayah":4,"page":605,"text":"فَاَثَرْنَ بِهٖ نَقْعًا ۝٤ۙ"},{"key":"100:5","surah":100,"ayah":5,"page":605,"text":" فَوَسَطْنَ بِهٖ جَمْعًا ۝٥ۙ"},{"key":"100:6","surah":100,"ayah":6,"page":605,"text":" اِنَّ الْاِنْسَانَ لِرَبِّهٖ لَكَنُوْدٌ ۝٦ۚ"},{"key":"100:7","surah":100,"ayah":7,"page":605,"text":" وَاِنَّهٗ عَلٰي ذٰلِكَ لَشَهِيْدٌ ۝٧ۚ"},{"key":"100:8","surah":100,"ayah":8,"page":605,"text":" وَاِنَّهٗ لِحُبِّ الْخَيْرِ لَشَدِيْدٌ ۝٨ؕ"}]