[{"key":"37:161","surah":37,"ayah":161,"page":452,"text":"فَاِنَّكُمْ وَمَا تَعْبُدُوْنَ ۝١٦١ۙ"},{"key":"37:162","surah":37,"ayah":162,"page":452,"text":" مَا͏ٓ اَنْتُمْ عَلَيْهِ بِفٰتِنِيْنَ ۝١٦٢ۙ"},{"key":"37:163","surah":37,"ayah":163,"page":452,"text":" اِلَّا مَنْ هُوَ صَالِ الْجَحِيْمِ ۝١٦٣"},{"key":"37:164","surah":37,"ayah":164,"page":452,"text":" وَمَا مِنَّا͏ٓ اِلَّا لَهٗ مَقَامٌ مَّعْلُوْمٌ ۝١٦٤ۙ"},{"key":"37:165","surah":37,"ayah":165,"page":452,"text":" وَّاِنَّا لَنَحْنُ الصَّا࢜فُّوْنَ ۝١٦٥ۚ"},{"key":"37:166","surah":37,"ayah":166,"page":452,"text":" وَاِنَّا لَنَحْنُ الْمُسَبِّحُوْنَ ۝١٦٦"},{"key":"37:167","surah":37,"ayah":167,"page":452,"text":" وَاِنْ كَانُوْا لَيَقُوْلُوْنَ ۝١٦٧ۙ"},{"key":"37:168","surah":37,"ayah":168,"page":452,"text":" لَوْ اَنَّ عِنْدَنَا ذِكْرًا مِّنَ الْاَوَّلِيْنَ ۝١٦٨ۙ"},{"key":"37:169","surah":37,"ayah":169,"page":452,"text":" لَكُنَّا عِبَادَ اللّٰهِ الْمُخْلَصِيْنَ ۝١٦٩"},{"key":"37:170","surah":37,"ayah":170,"page":452,"text":" فَكَفَرُوْا بِهٖ فَسَوْفَ يَعْلَمُوْنَ ۝١٧٠"},{"key":"37:171","surah":37,"ayah":171,"page":452,"text":" وَلَقَدْ سَبَقَتْ كَلِمَتُنَا لِعِبَادِنَا الْمُرْسَلِيْنَ ۝١٧١ۚۖ"},{"key":"37:172","surah":37,"ayah":172,"page":452,"text":" اِنَّهُمْ لَهُمُ الْمَنْصُوْرُوْنَ ۝١٧٢ࣕ"},{"key":"37:173","surah":37,"ayah":173,"page":452,"text":" وَاِنَّ جُنْدَنَا لَهُمُ الْغٰلِبُوْنَ ۝١٧٣"},{"key":"37:174","surah":37,"ayah":174,"page":452,"text":" فَتَوَلَّ عَنْهُمْ حَتّٰي حِيْنٍ ۝١٧٤ۙ"},{"key":"37:175","surah":37,"ayah":175,"page":452,"text":" وَّاَبْصِرْهُمْ فَسَوْفَ يُبْصِرُوْنَ ۝١٧٥"},{"key":"37:176","surah":37,"ayah":176,"page":452,"text":" اَفَبِعَذَابِنَا يَسْتَعْجِلُوْنَ ۝١٧٦"},{"key":"37:177","surah":37,"ayah":177,"page":452,"text":" فَاِذَا نَزَلَ بِسَاحَتِهِمْ فَسَا࢜ءَ صَبَاحُ الْمُنْذَرِيْنَ ۝١٧٧"},{"key":"37:178","surah":37,"ayah":178,"page":452,"text":" وَتَوَلَّ عَنْهُمْ حَتّٰي حِيْنٍ ۝١٧٨ۙ"},{"key":"37:179","surah":37,"ayah":179,"page":452,"text":"وَّاَبْصِرْ فَسَوْفَ يُبْصِرُوْنَ ۝١٧٩"},{"key":"37:180","surah":37,"ayah":180,"page":452,"text":" سُبْحٰنَ رَبِّكَ رَبِّ الْعِزَّةِ عَمَّا يَصِفُوْنَ ۝١٨٠ۚ"},{"key":"37:181","surah":37,"ayah":181,"page":452,"text":"وَسَلٰمٌ عَلَي الْمُرْسَلِيْنَ ۝١٨١ۚ"},{"key":"37:182","surah":37,"ayah":182,"page":452,"text":" وَالْحَمْدُ لِلّٰهِ رَبِّ الْعٰلَمِيْنَ ۝١٨٢ࣖ"},{"key":"38:1","surah":38,"ayah":1,"page":452,"text":"ص࢜ وَالْقُرْاٰنِ ذِي الذِّكْرِ ۝١ؕ"},{"key":"38:2","surah":38,"ayah":2,"page":452,"text":" بَلِ الَّذِيْنَ كَفَرُوْا فِيْ عِزَّةٍ وَّشِقَاقٍ ۝٢"},{"key":"38:3","surah":38,"ayah":3,"page":452,"text":"كَمْ اَهْلَكْنَا مِنْ قَبْلِهِمْ مِّنْ قَرْنٍ فَنَادَوْا وَّلَاتَ حِيْنَ مَنَاصٍ ۝٣"}]