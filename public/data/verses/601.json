[{"key":"91:6","surah":91,"ayah":6,"page":601,"text":"وَالْاَرْضِ وَمَا طَحٰىهَا ۝٦ࣕۙ"},{"key":"91:7","surah":91,"ayah":7,"page":601,"text":" وَنَفْسٍ وَّمَا سَوّٰىهَا ۝٧ࣕۙ"},{"key":"91:8","surah":91,"ayah":8,"page":601,"text":" فَاَلْهَمَهَا فُجُوْرَهَا وَتَقْوٰىهَا ۝٨ࣕۙ"},{"key":"91:9","surah":91,"ayah":9,"page":601,"text":" قَدْ اَفْلَحَ مَنْ زَكّٰىهَا ۝٩ࣕۙ"},{"key":"91:10","surah":91,"ayah":10,"page":601,"text":" وَقَدْ خَابَ مَنْ دَسّٰىهَا ۝١٠ؕ"},{"key":"91:11","surah":91,"ayah":11,"page":601,"text":" كَذَّبَتْ ثَمُوْدُ بِطَغْوٰىهَا͏ٓ ۝١١ࣕۙ"},{"key":"91:12","surah":91,"ayah":12,"page":601,"text":" اِذِ انۢ͏ْبَعَثَ اَشْقٰىهَا ۝١٢ࣕۙ"},{"key":"91:13","surah":91,"ayah":13,"page":601,"text":" فَقَالَ لَهُمْ رَسُوْلُ اللّٰهِ نَاقَةَ اللّٰهِ وَسُقْيٰهَا ۝١٣ؕ"},{"key":"91:14","surah":91,"ayah":14,"page":601,"text":" فَكَذَّبُوْهُ فَعَقَرُوْهَا࣢ࣕۙ فَدَمْدَمَ عَلَيْهِمْ رَبُّهُمْ بِذَنۢ͏ْبِهِمْ فَسَوّٰىهَا ۝١٤ࣕۙ"},{"key":"91:15","surah":91,"ayah":15,"page":601,"text":" وَلَا يَخَافُ عُقْبٰهَا ۝١٥ࣖ"},{"key":"92:1","surah":92,"ayah":1,"page":601,"text":"وَالَّيْلِ اِذَا يَغْشٰي ۝١ۙ"},{"key":"92:2","surah":92,"ayah":2,"page":601,"text":" وَالنَّهَارِ اِذَا تَجَلّٰي ۝٢ۙ"},{"key":"92:3","surah":92,"ayah":3,"page":601,"text":" وَمَا خَلَقَ الذَّكَرَ وَالْاُنْثٰٓي ۝٣ۙ"},{"key":"92:4","surah":92,"ayah":4,"page":601,"text":" اِنَّ سَعْيَكُمْ لَشَتّٰي ۝٤ؕ"},{"key":"92:5","surah":92,"ayah":5,"page":601,"text":" فَاَمَّا مَنْ اَعْطٰي وَاتَّقٰي ۝٥ۙ"},{"key":"92:6","surah":92,"ayah":6,"page":601,"text":"وَصَدَّقَ بِالْحُسْنٰي ۝٦ۙ"},{"key":"92:7","surah":92,"ayah":7,"page":601,"text":" فَسَنُيَسِّرُهٗ لِلْيُسْرٰي ۝٧ؕ"},{"key":"92:8","surah":92,"ayah":8,"page":601,"text":" وَاَمَّا مَنْۢ بَخِلَ وَاسْتَغْنٰي ۝٨ۙ"},{"key":"92:9","surah":92,"ayah":9,"page":601,"text":" وَكَذَّبَ بِالْحُسْنٰي ۝٩ۙ"},{"key":"92:10","surah":92,"ayah":10,"page":601,"text":" فَسَنُيَسِّرُهٗ لِلْعُسْرٰي ۝١٠ؕ"},{"key":"92:11","surah":92,"ayah":11,"page":601,"text":" وَمَا يُغْنِيْ عَنْهُ مَالُهٗٓ اِذَا تَرَدّٰي ۝١١ؕ"},{"key":"92:12","surah":92,"ayah":12,"page":601,"text":" اِنَّ عَلَيْنَا لَلْهُدٰي ۝١٢ؗۖ"},{"key":"92:13","surah":92,"ayah":13,"page":601,"text":" وَاِنَّ لَنَا لَلْاٰخِرَةَ وَالْاُوْلٰي ۝١٣"},{"key":"92:14","surah":92,"ayah":14,"page":601,"text":" فَاَنْذَرْتُكُمْ نَارًا تَلَظّٰي ۝١٤ۚ"},{"key":"92:15","surah":92,"ayah":15,"page":601,"text":" لَا يَصْلٰىهَا͏ٓ اِلَّا الْاَشْقَي ۝١٥ۙ"},{"key":"92:16","surah":92,"ayah":16,"page":601,"text":" الَّذِيْ كَذَّبَ وَتَوَلّٰي ۝١٦ؕ"},{"key":"92:17","surah":92,"ayah":17,"page":601,"text":"وَسَيُجَنَّبُهَا الْاَتْقَي ۝١٧ۙ"},{"key":"92:18","surah":92,"ayah":18,"page":601,"text":" الَّذِيْ يُو͏ٔ͏ْتِيْ مَالَهٗ يَتَزَكّٰي ۝١٨ۚ"}]