[{"key":"26:143","surah":26,"ayah":143,"page":373,"text":"اِنِّيْ لَكُمْ رَسُوْلٌ اَمِيْنٌ ۝١٤٣ۙ"},{"key":"26:144","surah":26,"ayah":144,"page":373,"text":" فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١٤٤ۚ"},{"key":"26:145","surah":26,"ayah":145,"page":373,"text":" وَمَا͏ٓ اَسْـٔ͏َلُكُمْ عَلَيْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِيَ اِلَّا عَلٰي رَبِّ الْعٰلَمِيْنَ ۝١٤٥ؕ"},{"key":"26:146","surah":26,"ayah":146,"page":373,"text":" اَتُتْرَكُوْنَ فِيْ مَا هٰهُنَا͏ٓ اٰمِنِيْنَ ۝١٤٦ۙ"},{"key":"26:147","surah":26,"ayah":147,"page":373,"text":" فِيْ جَنّٰتٍ وَّعُيُوْنٍ ۝١٤٧ۙ"},{"key":"26:148","surah":26,"ayah":148,"page":373,"text":" وَّزُرُوْعٍ وَّنَخْلٍ طَلْعُهَا هَضِيْمٌ ۝١٤٨ۚ"},{"key":"26:149","surah":26,"ayah":149,"page":373,"text":"وَتَنْحِتُوْنَ مِنَ الْجِبَالِ بُيُوْتًا فٰرِهِيْنَ ۝١٤٩ۚ"},{"key":"26:150","surah":26,"ayah":150,"page":373,"text":" فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١٥٠ۚ"},{"key":"26:151","surah":26,"ayah":151,"page":373,"text":"وَلَا تُطِيْعُوْٓا اَمْرَ الْمُسْرِفِيْنَ ۝١٥١ۙ"},{"key":"26:152","surah":26,"ayah":152,"page":373,"text":" الَّذِيْنَ يُفْسِدُوْنَ فِي الْاَرْضِ وَلَا يُصْلِحُوْنَ ۝١٥٢"},{"key":"26:153","surah":26,"ayah":153,"page":373,"text":" قَالُوْٓا اِنَّمَا͏ٓ اَنْتَ مِنَ الْمُسَحَّرِيْنَ ۝١٥٣ۚ"},{"key":"26:154","surah":26,"ayah":154,"page":373,"text":" مَا͏ٓ اَنْتَ اِلَّا بَشَرٌ مِّثْلُنَاۚۖ فَاْتِ بِاٰيَةٍ اِنْ كُنْتَ مِنَ الصّٰدِقِيْنَ ۝١٥٤"},{"key":"26:155","surah":26,"ayah":155,"page":373,"text":" قَالَ هٰذِهٖ نَاقَةٌ لَّهَا شِرْبٌ وَّلَكُمْ شِرْبُ يَوْمٍ مَّعْلُوْمٍ ۝١٥٥ۚ"},{"key":"26:156","surah":26,"ayah":156,"page":373,"text":" وَلَا تَمَسُّوْهَا بِسُوْ࢜ءٍ فَيَاْخُذَكُمْ عَذَابُ يَوْمٍ عَظِيْمٍ ۝١٥٦"},{"key":"26:157","surah":26,"ayah":157,"page":373,"text":" فَعَقَرُوْهَا فَاَصْبَحُوْا نٰدِمِيْنَ ۝١٥٧ۙ"},{"key":"26:158","surah":26,"ayah":158,"page":373,"text":" فَاَخَذَهُمُ الْعَذَابُؕ اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝١٥٨"},{"key":"26:159","surah":26,"ayah":159,"page":373,"text":" وَاِنَّ رَبَّكَ لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝١٥٩ࣖ"},{"key":"26:160","surah":26,"ayah":160,"page":373,"text":" كَذَّبَتْ قَوْمُ لُوْطِ اࣙلْمُرْسَلِيْنَ ۝١٦٠ۚۖ"},{"key":"26:161","surah":26,"ayah":161,"page":373,"text":" اِذْ قَالَ لَهُمْ اَخُوْهُمْ لُوْطٌ اَلَا تَتَّقُوْنَ ۝١٦١ۚ"},{"key":"26:162","surah":26,"ayah":162,"page":373,"text":" اِنِّيْ لَكُمْ رَسُوْلٌ اَمِيْنٌ ۝١٦٢ۙ"},{"key":"26:163","surah":26,"ayah":163,"page":373,"text":"فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١٦٣ۚ"},{"key":"26:164","surah":26,"ayah":164,"page":373,"text":" وَمَا͏ٓ اَسْـٔ͏َلُكُمْ عَلَيْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِيَ اِلَّا عَلٰي رَبِّ الْعٰلَمِيْنَ ۝١٦٤ؕ"},{"key":"26:165","surah":26,"ayah":165,"page":373,"text":" اَتَاْتُوْنَ الذُّكْرَانَ مِنَ الْعٰلَمِيْنَ ۝١٦٥ۙ"},{"key":"26:166","surah":26,"ayah":166,"page":373,"text":" وَتَذَرُوْنَ مَا خَلَقَ لَكُمْ رَبُّكُمْ مِّنْ اَزْوَاجِكُمْؕ بَلْ اَنْتُمْ قَوْمٌ عٰدُوْنَ ۝١٦٦"}]