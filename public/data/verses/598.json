[{"key":"88:8","surah":88,"ayah":8,"page":598,"text":"وُجُوْهٌ يَّوْمَىِٕذٍ نَّاعِمَةٌ ۝٨ۙ"},{"key":"88:9","surah":88,"ayah":9,"page":598,"text":" لِّسَعْيِهَا رَاضِيَةٌ ۝٩ۙ"},{"key":"88:10","surah":88,"ayah":10,"page":598,"text":" فِيْ جَنَّةٍ عَالِيَةٍ ۝١٠ۙ"},{"key":"88:11","surah":88,"ayah":11,"page":598,"text":" لَّا تَسْمَعُ فِيْهَا لَاغِيَةً ۝١١ؕ"},{"key":"88:12","surah":88,"ayah":12,"page":598,"text":" فِيْهَا عَيْنٌ جَارِيَةٌ ۝١٢ۘ"},{"key":"88:13","surah":88,"ayah":13,"page":598,"text":"فِيْهَا سُرُرٌ مَّرْفُوْعَةٌ ۝١٣ۙ"},{"key":"88:14","surah":88,"ayah":14,"page":598,"text":" وَّاَكْوَابٌ مَّوْضُوْعَةٌ ۝١٤ۙ"},{"key":"88:15","surah":88,"ayah":15,"page":598,"text":" وَّنَمَارِقُ مَصْفُوْفَةٌ ۝١٥ۙ"},{"key":"88:16","surah":88,"ayah":16,"page":598,"text":" وَّزَرَابِيُّ مَبْثُوْثَةٌ ۝١٦ؕ"},{"key":"88:17","surah":88,"ayah":17,"page":598,"text":" اَفَلَا يَنْظُرُوْنَ اِلَي الْاِبِلِ كَيْفَ خُلِقَتْ ۝١٧ࣟ"},{"key":"88:18","surah":88,"ayah":18,"page":598,"text":" وَاِلَي السَّمَا࢜ءِ كَيْفَ رُفِعَتْ ۝١٨ࣟ"},{"key":"88:19","surah":88,"ayah":19,"page":598,"text":" وَاِلَي الْجِبَالِ كَيْفَ نُصِبَتْ ۝١٩ࣟ"},{"key":"88:20","surah":88,"ayah":20,"page":598,"text":" وَاِلَي الْاَرْضِ كَيْفَ سُطِحَتْ ۝٢٠ࣟ"},{"key":"88:21","surah":88,"ayah":21,"page":598,"text":"فَذَكِّرْࣞؕ اِنَّمَا͏ٓ اَنْتَ مُذَكِّرٌ ۝٢١ؕ"},{"key":"88:22","surah":88,"ayah":22,"page":598,"text":" لَسْتَ عَلَيْهِمْ بِمُصَۜيْطِرٍ ۝٢٢ۙ"},{"key":"88:23","surah":88,"ayah":23,"page":598,"text":"اِلَّا مَنْ تَوَلّٰي وَكَفَرَ ۝٢٣ۙ"},{"key":"88:24","surah":88,"ayah":24,"page":598,"text":" فَيُعَذِّبُهُ اللّٰهُ الْعَذَابَ الْاَكْبَرَ ۝٢٤ؕ"},{"key":"88:25","surah":88,"ayah":25,"page":598,"text":"اِنَّ اِلَيْنَا͏ٓ اِيَابَهُمْ ۝٢٥ۙ"},{"key":"88:26","surah":88,"ayah":26,"page":598,"text":" ثُمَّ اِنَّ عَلَيْنَا حِسَابَهُمْ ۝٢٦ࣖ"},{"key":"89:1","surah":89,"ayah":1,"page":598,"text":"وَالْفَجْرِ ۝١ۙ"},{"key":"89:2","surah":89,"ayah":2,"page":598,"text":" وَلَيَالٍ عَشْرٍ ۝٢ۙ"},{"key":"89:3","surah":89,"ayah":3,"page":598,"text":" وَّالشَّفْعِ وَالْوَتْرِ ۝٣ۙ"},{"key":"89:4","surah":89,"ayah":4,"page":598,"text":" وَالَّيْلِ اِذَا يَسْرِ ۝٤ۚ"},{"key":"89:5","surah":89,"ayah":5,"page":598,"text":" هَلْ فِيْ ذٰلِكَ قَسَمٌ لِّذِيْ حِجْرٍ ۝٥ؕ"},{"key":"89:6","surah":89,"ayah":6,"page":598,"text":" اَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ ۝٦ࣕۙ"},{"key":"89:7","surah":89,"ayah":7,"page":598,"text":" اِرَمَ ذَاتِ الْعِمَادِ ۝٧ࣕۙ"},{"key":"89:8","surah":89,"ayah":8,"page":598,"text":" الَّتِيْ لَمْ يُخْلَقْ مِثْلُهَا فِي الْبِلَادِ ۝٨ࣕۙ"},{"key":"89:9","surah":89,"ayah":9,"page":598,"text":" وَثَمُوْدَ الَّذِيْنَ جَابُوا الصَّخْرَ بِالْوَادِ ۝٩ࣕۙ"}]