[{"key":"87:1","surah":87,"ayah":1,"page":597,"text":"سَبِّحِ اسْمَ رَبِّكَ الْاَعْلَي ۝١ۙ"},{"key":"87:2","surah":87,"ayah":2,"page":597,"text":" الَّذِيْ خَلَقَ فَسَوّٰي ۝٢ࣕۙ"},{"key":"87:3","surah":87,"ayah":3,"page":597,"text":" وَالَّذِيْ قَدَّرَ فَهَدٰي ۝٣ࣕۙ"},{"key":"87:4","surah":87,"ayah":4,"page":597,"text":" وَالَّذِيْٓ اَخْرَجَ الْمَرْعٰي ۝٤ࣕۙ"},{"key":"87:5","surah":87,"ayah":5,"page":597,"text":" فَجَعَلَهٗ غُثَا࢜ءً اَحْوٰي ۝٥ؕ"},{"key":"87:6","surah":87,"ayah":6,"page":597,"text":"سَنُقْرِي͏ٔ͏ُكَ فَلَا تَنْسٰٓي ۝٦ۙ"},{"key":"87:7","surah":87,"ayah":7,"page":597,"text":" اِلَّا مَا شَا࢜ءَ اللّٰهُؕ اِنَّهٗ يَعْلَمُ الْجَهْرَ وَمَا يَخْفٰي ۝٧ؕ"},{"key":"87:8","surah":87,"ayah":8,"page":597,"text":" وَنُيَسِّرُكَ لِلْيُسْرٰي ۝٨ۚۖ"},{"key":"87:9","surah":87,"ayah":9,"page":597,"text":" فَذَكِّرْ اِنْ نَّفَعَتِ الذِّكْرٰي ۝٩ؕ"},{"key":"87:10","surah":87,"ayah":10,"page":597,"text":" سَيَذَّكَّرُ مَنْ يَّخْشٰي ۝١٠ۙ"},{"key":"87:11","surah":87,"ayah":11,"page":597,"text":" وَيَتَجَنَّبُهَا الْاَشْقَي ۝١١ۙ"},{"key":"87:12","surah":87,"ayah":12,"page":597,"text":" الَّذِيْ يَصْلَي النَّارَ الْكُبْرٰي ۝١٢ۚ"},{"key":"87:13","surah":87,"ayah":13,"page":597,"text":"ثُمَّ لَا يَمُوْتُ فِيْهَا وَلَا يَحْيٰي ۝١٣ؕ"},{"key":"87:14","surah":87,"ayah":14,"page":597,"text":" قَدْ اَفْلَحَ مَنْ تَزَكّٰي ۝١٤ۙ"},{"key":"87:15","surah":87,"ayah":15,"page":597,"text":" وَذَكَرَ اسْمَ رَبِّهٖ فَصَلّٰي ۝١٥ؕ"},{"key":"87:16","surah":87,"ayah":16,"page":597,"text":" بَلْ تُو͏ٔ͏ْثِرُوْنَ الْحَيٰوةَ الدُّنْيَا ۝١٦ۚۖ"},{"key":"87:17","surah":87,"ayah":17,"page":597,"text":" وَالْاٰخِرَةُ خَيْرٌ وَّاَبْقٰي ۝١٧ؕ"},{"key":"87:18","surah":87,"ayah":18,"page":597,"text":" اِنَّ هٰذَا لَفِي الصُّحُفِ الْاُوْلٰي ۝١٨ۙ"},{"key":"87:19","surah":87,"ayah":19,"page":597,"text":" صُحُفِ اِبْرٰهِيْمَ وَمُوْسٰي ۝١٩ࣖ"},{"key":"88:1","surah":88,"ayah":1,"page":597,"text":"هَلْ اَتٰىكَ حَدِيْثُ الْغَاشِيَةِ ۝١ؕ"},{"key":"88:2","surah":88,"ayah":2,"page":597,"text":" وُجُوْهٌ يَّوْمَىِٕذٍ خَاشِعَةٌ ۝٢ۙ"},{"key":"88:3","surah":88,"ayah":3,"page":597,"text":" عَامِلَةٌ نَّاصِبَةٌ ۝٣ۙ"},{"key":"88:4","surah":88,"ayah":4,"page":597,"text":" تَصْلٰي نَارًا حَامِيَةً ۝٤ۙ"},{"key":"88:5","surah":88,"ayah":5,"page":597,"text":" تُسْقٰي مِنْ عَيْنٍ اٰنِيَةٍ ۝٥ؕ"},{"key":"88:6","surah":88,"ayah":6,"page":597,"text":" لَيْسَ لَهُمْ طَعَامٌ اِلَّا مِنْ ضَرِيْعٍ ۝٦ۙ"},{"key":"88:7","surah":88,"ayah":7,"page":597,"text":" لَّا يُسْمِنُ وَلَا يُغْنِيْ مِنْ جُوْعٍ ۝٧ؕ"}]