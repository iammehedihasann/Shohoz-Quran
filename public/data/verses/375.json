[{"key":"26:190","surah":26,"ayah":190,"page":375,"text":"اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝١٩٠"},{"key":"26:191","surah":26,"ayah":191,"page":375,"text":" وَاِنَّ رَبَّكَ لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝١٩١ࣖ"},{"key":"26:192","surah":26,"ayah":192,"page":375,"text":" وَاِنَّهٗ لَتَنْزِيْلُ رَبِّ الْعٰلَمِيْنَ ۝١٩٢ؕ"},{"key":"26:193","surah":26,"ayah":193,"page":375,"text":" نَزَلَ بِهِ الرُّوْحُ الْاَمِيْنُ ۝١٩٣ۙ"},{"key":"26:194","surah":26,"ayah":194,"page":375,"text":" عَلٰي قَلْبِكَ لِتَكُوْنَ مِنَ الْمُنْذِرِيْنَ ۝١٩٤ۙ"},{"key":"26:195","surah":26,"ayah":195,"page":375,"text":" بِلِسَانٍ عَرَبِيٍّ مُّبِيْنٍ ۝١٩٥ؕ"},{"key":"26:196","surah":26,"ayah":196,"page":375,"text":" وَاِنَّهٗ لَفِيْ زُبُرِ الْاَوَّلِيْنَ ۝١٩٦"},{"key":"26:197","surah":26,"ayah":197,"page":375,"text":" اَوَلَمْ يَكُنْ لَّهُمْ اٰيَةً اَنْ يَّعْلَمَهٗ عُلَمٰ࢜و͏ٔ͏ُا بَنِيْٓ اِسْرَا࢜ءِيْلَ ۝١٩٧ؕ"},{"key":"26:198","surah":26,"ayah":198,"page":375,"text":" وَلَوْ نَزَّلْنٰهُ عَلٰي بَعْضِ الْاَعْجَمِيْنَ ۝١٩٨ۙ"},{"key":"26:199","surah":26,"ayah":199,"page":375,"text":" فَقَرَاَهٗ عَلَيْهِمْ مَّا كَانُوْا بِهٖ مُو͏ٔ͏ْمِنِيْنَ ۝١٩٩ؕ"},{"key":"26:200","surah":26,"ayah":200,"page":375,"text":" كَذٰلِكَ سَلَكْنٰهُ فِيْ قُلُوْبِ الْمُجْرِمِيْنَ ۝٢٠٠ؕ"},{"key":"26:201","surah":26,"ayah":201,"page":375,"text":" لَا يُو͏ٔ͏ْمِنُوْنَ بِهٖ حَتّٰي يَرَوُا الْعَذَابَ الْاَلِيْمَ ۝٢٠١ۙ"},{"key":"26:202","surah":26,"ayah":202,"page":375,"text":" فَيَاْتِيَهُمْ بَغْتَةً وَّهُمْ لَا يَشْعُرُوْنَ ۝٢٠٢ۙ"},{"key":"26:203","surah":26,"ayah":203,"page":375,"text":" فَيَقُوْلُوْا هَلْ نَحْنُ مُنْظَرُوْنَ ۝٢٠٣ؕ"},{"key":"26:204","surah":26,"ayah":204,"page":375,"text":" اَفَبِعَذَابِنَا يَسْتَعْجِلُوْنَ ۝٢٠٤"},{"key":"26:205","surah":26,"ayah":205,"page":375,"text":" اَفَرَءَيْتَ اِنْ مَّتَّعْنٰهُمْ سِنِيْنَ ۝٢٠٥ۙ"},{"key":"26:206","surah":26,"ayah":206,"page":375,"text":" ثُمَّ جَا࢜ءَهُمْ مَّا كَانُوْا يُوْعَدُوْنَ ۝٢٠٦ۙ"},{"key":"26:207","surah":26,"ayah":207,"page":375,"text":" مَا͏ٓ اَغْنٰي عَنْهُمْ مَّا كَانُوْا يُمَتَّعُوْنَ ۝٢٠٧ؕ"},{"key":"26:208","surah":26,"ayah":208,"page":375,"text":" وَمَا͏ٓ اَهْلَكْنَا مِنْ قَرْيَةٍ اِلَّا لَهَا مُنْذِرُوْنَ ۝٢٠٨ࣗۖۛ"},{"key":"26:209","surah":26,"ayah":209,"page":375,"text":"ذِكْرٰيࣞۛ وَمَا كُنَّا ظٰلِمِيْنَ ۝٢٠٩"},{"key":"26:210","surah":26,"ayah":210,"page":375,"text":" وَمَا تَنَزَّلَتْ بِهِ الشَّيٰطِيْنُ ۝٢١٠"},{"key":"26:211","surah":26,"ayah":211,"page":375,"text":" وَمَا يَنۢ͏ْبَغِيْ لَهُمْ وَمَا يَسْتَطِيْعُوْنَ ۝٢١١ؕ"},{"key":"26:212","surah":26,"ayah":212,"page":375,"text":" اِنَّهُمْ عَنِ السَّمْعِ لَمَعْزُوْلُوْنَ ۝٢١٢ؕ"},{"key":"26:213","surah":26,"ayah":213,"page":375,"text":" فَلَا تَدْعُ مَعَ اللّٰهِ اِلٰهًا اٰخَرَ فَتَكُوْنَ مِنَ الْمُعَذَّبِيْنَ ۝٢١٣ۚ"},{"key":"26:214","surah":26,"ayah":214,"page":375,"text":" وَاَنْذِرْ عَشِيْرَتَكَ الْاَقْرَبِيْنَ ۝٢١٤ۙ"},{"key":"26:215","surah":26,"ayah":215,"page":375,"text":" وَاخْفِضْ جَنَاحَكَ لِمَنِ اتَّبَعَكَ مِنَ الْمُو͏ٔ͏ْمِنِيْنَ ۝٢١٥ۚ"}]