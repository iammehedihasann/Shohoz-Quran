[{"key":"82:6","surah":82,"ayah":6,"page":592,"text":"يٰٓاَيُّهَا الْاِنْسَانُ مَا غَرَّكَ بِرَبِّكَ الْكَرِيْمِ ۝٦ۙ"},{"key":"82:7","surah":82,"ayah":7,"page":592,"text":" الَّذِيْ خَلَقَكَ فَسَوّٰىكَ فَعَدَلَكَ ۝٧ۙ"},{"key":"82:8","surah":82,"ayah":8,"page":592,"text":" فِيْٓ اَيِّ صُوْرَةٍ مَّا شَا࢜ءَ رَكَّبَكَ ۝٨ؕ"},{"key":"82:9","surah":82,"ayah":9,"page":592,"text":" كَلَّا بَلْ تُكَذِّبُوْنَ بِالدِّيْنِ ۝٩ۙ"},{"key":"82:10","surah":82,"ayah":10,"page":592,"text":" وَاِنَّ عَلَيْكُمْ لَحٰفِظِيْنَ ۝١٠ۙ"},{"key":"82:11","surah":82,"ayah":11,"page":592,"text":" كِرَامًا كَاتِبِيْنَ ۝١١ۙ"},{"key":"82:12","surah":82,"ayah":12,"page":592,"text":" يَعْلَمُوْنَ مَا تَفْعَلُوْنَ ۝١٢"},{"key":"82:13","surah":82,"ayah":13,"page":592,"text":" اِنَّ الْاَبْرَارَ لَفِيْ نَعِيْمٍ ۝١٣ۙ"},{"key":"82:14","surah":82,"ayah":14,"page":592,"text":"وَاِنَّ الْفُجَّارَ لَفِيْ جَحِيْمٍ ۝١٤ۚۖ"},{"key":"82:15","surah":82,"ayah":15,"page":592,"text":" يَّصْلَوْنَهَا يَوْمَ الدِّيْنِ ۝١٥"},{"key":"82:16","surah":82,"ayah":16,"page":592,"text":" وَمَا هُمْ عَنْهَا بِغَا࢜ىِٕبِيْنَ ۝١٦ؕ"},{"key":"82:17","surah":82,"ayah":17,"page":592,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا يَوْمُ الدِّيْنِ ۝١٧ۙ"},{"key":"82:18","surah":82,"ayah":18,"page":592,"text":"ثُمَّ مَا͏ٓ اَدْرٰىكَ مَا يَوْمُ الدِّيْنِ ۝١٨ؕ"},{"key":"82:19","surah":82,"ayah":19,"page":592,"text":" يَوْمَ لَا تَمْلِكُ نَفْسٌ لِّنَفْسٍ شَيْـٔ͏ًاؕ وَالْاَمْرُ يَوْمَىِٕذٍ لِّلّٰهِ ۝١٩ࣖ"},{"key":"83:1","surah":83,"ayah":1,"page":592,"text":"وَيْلٌ لِّلْمُطَفِّفِيْنَ ۝١ۙ"},{"key":"83:2","surah":83,"ayah":2,"page":592,"text":" الَّذِيْنَ اِذَا اكْتَالُوْا عَلَي النَّاسِ يَسْتَوْفُوْنَ ۝٢ؗۖ"},{"key":"83:3","surah":83,"ayah":3,"page":592,"text":"وَاِذَا كَالُوْهُمْ اَوْ وَّزَنُوْهُمْ يُخْسِرُوْنَ ۝٣ؕ"},{"key":"83:4","surah":83,"ayah":4,"page":592,"text":" اَلَا يَظُنُّ اُولٰ࢜ىِٕكَ اَنَّهُمْ مَّبْعُوْثُوْنَ ۝٤ۙ"},{"key":"83:5","surah":83,"ayah":5,"page":592,"text":" لِيَوْمٍ عَظِيْمٍ ۝٥ۙ"},{"key":"83:6","surah":83,"ayah":6,"page":592,"text":" يَّوْمَ يَقُوْمُ النَّاسُ لِرَبِّ الْعٰلَمِيْنَ ۝٦ؕ"},{"key":"83:7","surah":83,"ayah":7,"page":592,"text":" كَلَّا͏ٓ اِنَّ كِتٰبَ الْفُجَّارِ لَفِيْ سِجِّيْنٍ ۝٧ؕ"},{"key":"83:8","surah":83,"ayah":8,"page":592,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا سِجِّيْنٌ ۝٨ؕ"},{"key":"83:9","surah":83,"ayah":9,"page":592,"text":" كِتٰبٌ مَّرْقُوْمٌ ۝٩ؕ"},{"key":"83:10","surah":83,"ayah":10,"page":592,"text":" وَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝١٠ۙ"}]