[{"key":"20:13","surah":20,"ayah":13,"page":313,"text":"وَاَنَا اخْتَرْتُكَ فَاسْتَمِعْ لِمَا يُوْحٰي ۝١٣"},{"key":"20:14","surah":20,"ayah":14,"page":313,"text":" اِنَّنِيْٓ اَنَا اللّٰهُ لَا͏ٓ اِلٰهَ اِلَّا͏ٓ اَنَا فَاعْبُدْنِيْۙ وَاَقِمِ الصَّلٰوةَ لِذِكْرِيْ ۝١٤"},{"key":"20:15","surah":20,"ayah":15,"page":313,"text":" اِنَّ السَّاعَةَ اٰتِيَةٌ اَكَادُ اُخْفِيْهَا لِتُجْزٰي كُلُّ نَفْسٍۭ بِمَا تَسْعٰي ۝١٥"},{"key":"20:16","surah":20,"ayah":16,"page":313,"text":" فَلَا يَصُدَّنَّكَ عَنْهَا مَنْ لَّا يُو͏ٔ͏ْمِنُ بِهَا وَاتَّبَعَ هَوٰىهُ فَتَرْدٰي ۝١٦"},{"key":"20:17","surah":20,"ayah":17,"page":313,"text":" وَمَا تِلْكَ بِيَمِيْنِكَ يٰمُوْسٰي ۝١٧"},{"key":"20:18","surah":20,"ayah":18,"page":313,"text":"قَالَ هِيَ عَصَايَۚ اَتَوَكَّو͏ٔ͏ُا عَلَيْهَا وَاَهُشُّ بِهَا عَلٰي غَنَمِيْ وَلِيَ فِيْهَا مَاٰرِبُ اُخْرٰي ۝١٨"},{"key":"20:19","surah":20,"ayah":19,"page":313,"text":" قَالَ اَلْقِهَا يٰمُوْسٰي ۝١٩"},{"key":"20:20","surah":20,"ayah":20,"page":313,"text":" فَاَلْقٰىهَا فَاِذَا هِيَ حَيَّةٌ تَسْعٰي ۝٢٠"},{"key":"20:21","surah":20,"ayah":21,"page":313,"text":" قَالَ خُذْهَا وَلَا تَخَفْࣟ سَنُعِيْدُهَا سِيْرَتَهَا الْاُوْلٰي ۝٢١"},{"key":"20:22","surah":20,"ayah":22,"page":313,"text":"وَاضْمُمْ يَدَكَ اِلٰي جَنَاحِكَ تَخْرُجْ بَيْضَا࢜ءَ مِنْ غَيْرِ سُوْ࢜ءٍ اٰيَةً اُخْرٰي ۝٢٢ۙ"},{"key":"20:23","surah":20,"ayah":23,"page":313,"text":" لِنُرِيَكَ مِنْ اٰيٰتِنَا الْكُبْرٰي ۝٢٣ۚ"},{"key":"20:24","surah":20,"ayah":24,"page":313,"text":" اِذْهَبْ اِلٰي فِرْعَوْنَ اِنَّهٗ طَغٰي ۝٢٤ࣖ"},{"key":"20:25","surah":20,"ayah":25,"page":313,"text":" قَالَ رَبِّ اشْرَحْ لِيْ صَدْرِيْ ۝٢٥ۙ"},{"key":"20:26","surah":20,"ayah":26,"page":313,"text":" وَيَسِّرْ لِيْٓ اَمْرِيْ ۝٢٦ۙ"},{"key":"20:27","surah":20,"ayah":27,"page":313,"text":"وَاحْلُلْ عُقْدَةً مِّنْ لِّسَانِيْ ۝٢٧ۙ"},{"key":"20:28","surah":20,"ayah":28,"page":313,"text":" يَفْقَهُوْا قَوْلِيْ ۝٢٨ࣕ"},{"key":"20:29","surah":20,"ayah":29,"page":313,"text":" وَاجْعَلْ لِّيْ وَزِيْرًا مِّنْ اَهْلِيْ ۝٢٩ۙ"},{"key":"20:30","surah":20,"ayah":30,"page":313,"text":" هٰرُوْنَ اَخِي ۝٣٠ۙ"},{"key":"20:31","surah":20,"ayah":31,"page":313,"text":" اشْدُدْ بِهٖٓ اَزْرِيْ ۝٣١ۙ"},{"key":"20:32","surah":20,"ayah":32,"page":313,"text":" وَاَشْرِكْهُ فِيْٓ اَمْرِيْ ۝٣٢ۙ"},{"key":"20:33","surah":20,"ayah":33,"page":313,"text":" كَيْ نُسَبِّحَكَ كَثِيْرًا ۝٣٣ۙ"},{"key":"20:34","surah":20,"ayah":34,"page":313,"text":" وَّنَذْكُرَكَ كَثِيْرًا ۝٣٤ؕ"},{"key":"20:35","surah":20,"ayah":35,"page":313,"text":" اِنَّكَ كُنْتَ بِنَا بَصِيْرًا ۝٣٥"},{"key":"20:36","surah":20,"ayah":36,"page":313,"text":" قَالَ قَدْ اُوْتِيْتَ سُو͏ٔ͏ْلَكَ يٰمُوْسٰي ۝٣٦"},{"key":"20:37","surah":20,"ayah":37,"page":313,"text":" وَلَقَدْ مَنَنَّا عَلَيْكَ مَرَّةً اُخْرٰٓي ۝٣٧ۙ"},{"key":"20:38","surah":20,"ayah":38,"page":313,"text":" اِذْ اَوْحَيْنَا͏ٓ اِلٰٓي اُمِّكَ مَا يُوْحٰٓي ۝٣٨ۙ"}]