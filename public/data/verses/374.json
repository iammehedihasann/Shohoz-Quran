[{"key":"26:167","surah":26,"ayah":167,"page":374,"text":"قَالُوْا لَىِٕنْ لَّمْ تَنْتَهِ يٰلُوْطُ لَتَكُوْنَنَّ مِنَ الْمُخْرَجِيْنَ ۝١٦٧"},{"key":"26:168","surah":26,"ayah":168,"page":374,"text":" قَالَ اِنِّيْ لِعَمَلِكُمْ مِّنَ الْقَالِيْنَ ۝١٦٨ؕ"},{"key":"26:169","surah":26,"ayah":169,"page":374,"text":" رَبِّ نَجِّنِيْ وَاَهْلِيْ مِمَّا يَعْمَلُوْنَ ۝١٦٩"},{"key":"26:170","surah":26,"ayah":170,"page":374,"text":" فَنَجَّيْنٰهُ وَاَهْلَهٗٓ اَجْمَعِيْنَ ۝١٧٠ۙ"},{"key":"26:171","surah":26,"ayah":171,"page":374,"text":" اِلَّا عَجُوْزًا فِي الْغٰبِرِيْنَ ۝١٧١ۚ"},{"key":"26:172","surah":26,"ayah":172,"page":374,"text":" ثُمَّ دَمَّرْنَا الْاٰخَرِيْنَ ۝١٧٢ۚ"},{"key":"26:173","surah":26,"ayah":173,"page":374,"text":"وَاَمْطَرْنَا عَلَيْهِمْ مَّطَرًاۚ فَسَا࢜ءَ مَطَرُ الْمُنْذَرِيْنَ ۝١٧٣"},{"key":"26:174","surah":26,"ayah":174,"page":374,"text":" اِنَّ فِيْ ذٰلِكَ لَاٰيَةًؕ وَمَا كَانَ اَكْثَرُهُمْ مُّو͏ٔ͏ْمِنِيْنَ ۝١٧٤"},{"key":"26:175","surah":26,"ayah":175,"page":374,"text":" وَاِنَّ رَبَّكَ لَهُوَ الْعَزِيْزُ الرَّحِيْمُ ۝١٧٥ࣖ"},{"key":"26:176","surah":26,"ayah":176,"page":374,"text":"كَذَّبَ اَصْحٰبُ لْـٔ͏َيْكَةِ الْمُرْسَلِيْنَ ۝١٧٦ۚۖ"},{"key":"26:177","surah":26,"ayah":177,"page":374,"text":" اِذْ قَالَ لَهُمْ شُعَيْبٌ اَلَا تَتَّقُوْنَ ۝١٧٧ۚ"},{"key":"26:178","surah":26,"ayah":178,"page":374,"text":" اِنِّيْ لَكُمْ رَسُوْلٌ اَمِيْنٌ ۝١٧٨ۙ"},{"key":"26:179","surah":26,"ayah":179,"page":374,"text":" فَاتَّقُوا اللّٰهَ وَاَطِيْعُوْنِ ۝١٧٩ۚ"},{"key":"26:180","surah":26,"ayah":180,"page":374,"text":"وَمَا͏ٓ اَسْـٔ͏َلُكُمْ عَلَيْهِ مِنْ اَجْرٍۚ اِنْ اَجْرِيَ اِلَّا عَلٰي رَبِّ الْعٰلَمِيْنَ ۝١٨٠ؕ"},{"key":"26:181","surah":26,"ayah":181,"page":374,"text":"اَوْفُوا الْكَيْلَ وَلَا تَكُوْنُوْا مِنَ الْمُخْسِرِيْنَ ۝١٨١ۚ"},{"key":"26:182","surah":26,"ayah":182,"page":374,"text":" وَزِنُوْا بِالْقِسْطَاسِ الْمُسْتَقِيْمِ ۝١٨٢ۚ"},{"key":"26:183","surah":26,"ayah":183,"page":374,"text":" وَلَا تَبْخَسُوا النَّاسَ اَشْيَا࢜ءَهُمْ وَلَا تَعْثَوْا فِي الْاَرْضِ مُفْسِدِيْنَ ۝١٨٣ۚ"},{"key":"26:184","surah":26,"ayah":184,"page":374,"text":" وَاتَّقُوا الَّذِيْ خَلَقَكُمْ وَالْجِبِلَّةَ الْاَوَّلِيْنَ ۝١٨٤ؕ"},{"key":"26:185","surah":26,"ayah":185,"page":374,"text":" قَالُوْٓا اِنَّمَا͏ٓ اَنْتَ مِنَ الْمُسَحَّرِيْنَ ۝١٨٥ۙ"},{"key":"26:186","surah":26,"ayah":186,"page":374,"text":" وَمَا͏ٓ اَنْتَ اِلَّا بَشَرٌ مِّثْلُنَا وَاِنْ نَّظُنُّكَ لَمِنَ الْكٰذِبِيْنَ ۝١٨٦ۚ"},{"key":"26:187","surah":26,"ayah":187,"page":374,"text":" فَاَسْقِطْ عَلَيْنَا كِسَفًا مِّنَ السَّمَا࢜ءِ اِنْ كُنْتَ مِنَ الصّٰدِقِيْنَ ۝١٨٧ؕ"},{"key":"26:188","surah":26,"ayah":188,"page":374,"text":" قَالَ رَبِّيْٓ اَعْلَمُ بِمَا تَعْمَلُوْنَ ۝١٨٨"},{"key":"26:189","surah":26,"ayah":189,"page":374,"text":" فَكَذَّبُوْهُ فَاَخَذَهُمْ عَذَابُ يَوْمِ الظُّلَّةِؕ اِنَّهٗ كَانَ عَذَابَ يَوْمٍ عَظِيْمٍ ۝١٨٩"}]