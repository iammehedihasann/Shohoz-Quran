[{"key":"56:77","surah":56,"ayah":77,"page":537,"text":"اِنَّهٗ لَقُرْاٰنٌ كَرِيْمٌ ۝٧٧ۙ"},{"key":"56:78","surah":56,"ayah":78,"page":537,"text":" فِيْ كِتٰبٍ مَّكْنُوْنٍ ۝٧٨ۙ"},{"key":"56:79","surah":56,"ayah":79,"page":537,"text":" لَّا يَمَسُّهٗٓ اِلَّا الْمُطَهَّرُوْنَ ۝٧٩ؕ"},{"key":"56:80","surah":56,"ayah":80,"page":537,"text":" تَنْزِيْلٌ مِّنْ رَّبِّ الْعٰلَمِيْنَ ۝٨٠"},{"key":"56:81","surah":56,"ayah":81,"page":537,"text":" اَفَبِهٰذَا الْحَدِيْثِ اَنْتُمْ مُّدْهِنُوْنَ ۝٨١ۙ"},{"key":"56:82","surah":56,"ayah":82,"page":537,"text":" وَتَجْعَلُوْنَ رِزْقَكُمْ اَنَّكُمْ تُكَذِّبُوْنَ ۝٨٢"},{"key":"56:83","surah":56,"ayah":83,"page":537,"text":" فَلَوْلَا͏ٓ اِذَا بَلَغَتِ الْحُلْقُوْمَ ۝٨٣ۙ"},{"key":"56:84","surah":56,"ayah":84,"page":537,"text":" وَاَنْتُمْ حِيْنَىِٕذٍ تَنْظُرُوْنَ ۝٨٤ۙ"},{"key":"56:85","surah":56,"ayah":85,"page":537,"text":" وَنَحْنُ اَقْرَبُ اِلَيْهِ مِنْكُمْ وَلٰكِنْ لَّا تُبْصِرُوْنَ ۝٨٥"},{"key":"56:86","surah":56,"ayah":86,"page":537,"text":" فَلَوْلَا͏ٓ اِنْ كُنْتُمْ غَيْرَ مَدِيْنِيْنَ ۝٨٦ۙ"},{"key":"56:87","surah":56,"ayah":87,"page":537,"text":"تَرْجِعُوْنَهَا͏ٓ اِنْ كُنْتُمْ صٰدِقِيْنَ ۝٨٧"},{"key":"56:88","surah":56,"ayah":88,"page":537,"text":" فَاَمَّا͏ٓ اِنْ كَانَ مِنَ الْمُقَرَّبِيْنَ ۝٨٨ۙ"},{"key":"56:89","surah":56,"ayah":89,"page":537,"text":"فَرَوْحٌ وَّرَيْحَانٌ࣢ۙ وَّجَنَّتُ نَعِيْمٍ ۝٨٩"},{"key":"56:90","surah":56,"ayah":90,"page":537,"text":" وَاَمَّا͏ٓ اِنْ كَانَ مِنْ اَصْحٰبِ الْيَمِيْنِ ۝٩٠ۙ"},{"key":"56:91","surah":56,"ayah":91,"page":537,"text":" فَسَلٰمٌ لَّكَ مِنْ اَصْحٰبِ الْيَمِيْنِ ۝٩١ؕ"},{"key":"56:92","surah":56,"ayah":92,"page":537,"text":" وَاَمَّا͏ٓ اِنْ كَانَ مِنَ الْمُكَذِّبِيْنَ الضَّا࢜لِّيْنَ ۝٩٢ۙ"},{"key":"56:93","surah":56,"ayah":93,"page":537,"text":" فَنُزُلٌ مِّنْ حَمِيْمٍ ۝٩٣ۙ"},{"key":"56:94","surah":56,"ayah":94,"page":537,"text":" وَّتَصْلِيَةُ جَحِيْمٍ ۝٩٤"},{"key":"56:95","surah":56,"ayah":95,"page":537,"text":"اِنَّ هٰذَا لَهُوَ حَقُّ الْيَقِيْنِ ۝٩٥ۚ"},{"key":"56:96","surah":56,"ayah":96,"page":537,"text":" فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيْمِ ۝٩٦ࣖ"},{"key":"57:1","surah":57,"ayah":1,"page":537,"text":"سَبَّحَ لِلّٰهِ مَا فِي السَّمٰوٰتِ وَالْاَرْضِۚ وَهُوَ الْعَزِيْزُ الْحَكِيْمُ ۝١"},{"key":"57:2","surah":57,"ayah":2,"page":537,"text":" لَهٗ مُلْكُ السَّمٰوٰتِ وَالْاَرْضِۚ يُحْيٖ وَيُمِيْتُۚ وَهُوَ عَلٰي كُلِّ شَيْءٍ قَدِيْرٌ ۝٢"},{"key":"57:3","surah":57,"ayah":3,"page":537,"text":"هُوَ الْاَوَّلُ وَالْاٰخِرُ وَالظَّاهِرُ وَالْبَاطِنُۚ وَهُوَ بِكُلِّ شَيْءٍ عَلِيْمٌ ۝٣"}]