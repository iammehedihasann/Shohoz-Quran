[{"key":"74:50","surah":74,"ayah":50,"page":580,"text":"كَاَنَّهُمْ حُمُرٌ مُّسْتَنْفِرَةٌ ۝٥٠ۙ"},{"key":"74:51","surah":74,"ayah":51,"page":580,"text":" فَرَّتْ مِنْ قَسْوَرَةٍ ۝٥١ؕ"},{"key":"74:52","surah":74,"ayah":52,"page":580,"text":" بَلْ يُرِيْدُ كُلُّ امْرِي͏ٔ͏ٍ مِّنْهُمْ اَنْ يُّو͏ٔ͏ْتٰي صُحُفًا مُّنَشَّرَةً ۝٥٢ۙ"},{"key":"74:53","surah":74,"ayah":53,"page":580,"text":"كَلَّاؕ بَلْ لَّا يَخَافُوْنَ الْاٰخِرَةَ ۝٥٣ؕ"},{"key":"74:54","surah":74,"ayah":54,"page":580,"text":" كَلَّا͏ٓ اِنَّهٗ تَذْكِرَةٌ ۝٥٤ۚ"},{"key":"74:55","surah":74,"ayah":55,"page":580,"text":"فَمَنْ شَا࢜ءَ ذَكَرَهٗ ۝٥٥ؕ"},{"key":"74:56","surah":74,"ayah":56,"page":580,"text":" وَمَا يَذْكُرُوْنَ اِلَّا͏ٓ اَنْ يَّشَا࢜ءَ اللّٰهُؕ هُوَ اَهْلُ التَّقْوٰي وَاَهْلُ الْمَغْفِرَةِ ۝٥٦ࣖ"},{"key":"75:1","surah":75,"ayah":1,"page":580,"text":"لَا͏ٓ اُقْسِمُ بِيَوْمِ الْقِيٰمَةِ ۝١ۙ"},{"key":"75:2","surah":75,"ayah":2,"page":580,"text":" وَلَا͏ٓ اُقْسِمُ بِالنَّفْسِ اللَّوَّامَةِ ۝٢ؕ"},{"key":"75:3","surah":75,"ayah":3,"page":580,"text":"اَيَحْسَبُ الْاِنْسَانُ اَلَّنْ نَّجْمَعَ عِظَامَهٗ ۝٣ؕ"},{"key":"75:4","surah":75,"ayah":4,"page":580,"text":" بَلٰى قٰدِرِيْنَ عَلٰٓي اَنْ نُّسَوِّيَ بَنَانَهٗ ۝٤"},{"key":"75:5","surah":75,"ayah":5,"page":580,"text":" بَلْ يُرِيْدُ الْاِنْسَانُ لِيَفْجُرَ اَمَامَهٗ ۝٥ۚ"},{"key":"75:6","surah":75,"ayah":6,"page":580,"text":" يَسْـٔ͏َلُ اَيَّانَ يَوْمُ الْقِيٰمَةِ ۝٦ؕ"},{"key":"75:7","surah":75,"ayah":7,"page":580,"text":" فَاِذَا بَرِقَ الْبَصَرُ ۝٧ۙ"},{"key":"75:8","surah":75,"ayah":8,"page":580,"text":" وَخَسَفَ الْقَمَرُ ۝٨ۙ"},{"key":"75:9","surah":75,"ayah":9,"page":580,"text":" وَجُمِعَ الشَّمْسُ وَالْقَمَرُ ۝٩ۙ"},{"key":"75:10","surah":75,"ayah":10,"page":580,"text":"يَقُوْلُ الْاِنْسَانُ يَوْمَىِٕذٍ اَيْنَ الْمَفَرُّ ۝١٠ۚ"},{"key":"75:11","surah":75,"ayah":11,"page":580,"text":" كَلَّا لَا وَزَرَ ۝١١ؕ"},{"key":"75:12","surah":75,"ayah":12,"page":580,"text":" اِلٰى رَبِّكَ يَوْمَىِٕذِ اࣙلْمُسْتَقَرُّ ۝١٢ؕ"},{"key":"75:13","surah":75,"ayah":13,"page":580,"text":" يُنَبَّو͏ٔ͏ُا الْاِنْسَانُ يَوْمَىِٕذٍۭ بِمَا قَدَّمَ وَاَخَّرَ ۝١٣ؕ"},{"key":"75:14","surah":75,"ayah":14,"page":580,"text":" بَلِ الْاِنْسَانُ عَلٰي نَفْسِهٖ بَصِيْرَةٌ ۝١٤ۙ"}]