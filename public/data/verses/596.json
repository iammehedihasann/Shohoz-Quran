[{"key":"85:14","surah":85,"ayah":14,"page":596,"text":"وَهُوَ الْغَفُوْرُ الْوَدُوْدُ ۝١٤ۙ"},{"key":"85:15","surah":85,"ayah":15,"page":596,"text":" ذُو الْعَرْشِ الْمَجِيْدُ ۝١٥ۙ"},{"key":"85:16","surah":85,"ayah":16,"page":596,"text":" فَعَّالٌ لِّمَا يُرِيْدُ ۝١٦ؕ"},{"key":"85:17","surah":85,"ayah":17,"page":596,"text":" هَلْ اَتٰىكَ حَدِيْثُ الْجُنُوْدِ ۝١٧ۙ"},{"key":"85:18","surah":85,"ayah":18,"page":596,"text":" فِرْعَوْنَ وَثَمُوْدَ ۝١٨ؕ"},{"key":"85:19","surah":85,"ayah":19,"page":596,"text":" بَلِ الَّذِيْنَ كَفَرُوْا فِيْ تَكْذِيْبٍ ۝١٩ۙ"},{"key":"85:20","surah":85,"ayah":20,"page":596,"text":" وَّاللّٰهُ مِنْ وَّرَا࢜ىِٕهِمْ مُّحِيْطٌ ۝٢٠ۚ"},{"key":"85:21","surah":85,"ayah":21,"page":596,"text":"بَلْ هُوَ قُرْاٰنٌ مَّجِيْدٌ ۝٢١ۙ"},{"key":"85:22","surah":85,"ayah":22,"page":596,"text":" فِيْ لَوْحٍ مَّحْفُوْظٍ ۝٢٢ࣖ"},{"key":"86:1","surah":86,"ayah":1,"page":596,"text":"وَالسَّمَا࢜ءِ وَالطَّارِقِ ۝١ۙ"},{"key":"86:2","surah":86,"ayah":2,"page":596,"text":" وَمَا͏ٓ اَدْرٰىكَ مَا الطَّارِقُ ۝٢ۙ"},{"key":"86:3","surah":86,"ayah":3,"page":596,"text":"النَّجْمُ الثَّاقِبُ ۝٣ۙ"},{"key":"86:4","surah":86,"ayah":4,"page":596,"text":" اِنْ كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ ۝٤ؕ"},{"key":"86:5","surah":86,"ayah":5,"page":596,"text":"فَلْيَنْظُرِ الْاِنْسَانُ مِمَّ خُلِقَ ۝٥ؕ"},{"key":"86:6","surah":86,"ayah":6,"page":596,"text":" خُلِقَ مِنْ مَّا࢜ءٍ دَافِقٍ ۝٦ۙ"},{"key":"86:7","surah":86,"ayah":7,"page":596,"text":"يَّخْرُجُ مِنْۢ بَيْنِ الصُّلْبِ وَالتَّرَا࢜ىِٕبِ ۝٧ؕ"},{"key":"86:8","surah":86,"ayah":8,"page":596,"text":" اِنَّهٗ عَلٰي رَجْعِهٖ لَقَادِرٌ ۝٨ؕ"},{"key":"86:9","surah":86,"ayah":9,"page":596,"text":" يَوْمَ تُبْلَي السَّرَا࢜ىِٕرُ ۝٩ۙ"},{"key":"86:10","surah":86,"ayah":10,"page":596,"text":" فَمَا لَهٗ مِنْ قُوَّةٍ وَّلَا نَاصِرٍ ۝١٠ؕ"},{"key":"86:11","surah":86,"ayah":11,"page":596,"text":" وَالسَّمَا࢜ءِ ذَاتِ الرَّجْعِ ۝١١ۙ"},{"key":"86:12","surah":86,"ayah":12,"page":596,"text":" وَالْاَرْضِ ذَاتِ الصَّدْعِ ۝١٢ۙ"},{"key":"86:13","surah":86,"ayah":13,"page":596,"text":" اِنَّهٗ لَقَوْلٌ فَصْلٌ ۝١٣ۙ"},{"key":"86:14","surah":86,"ayah":14,"page":596,"text":" وَّمَا هُوَ بِالْهَزْلِ ۝١٤ؕ"},{"key":"86:15","surah":86,"ayah":15,"page":596,"text":"اِنَّهُمْ يَكِيْدُوْنَ كَيْدًا ۝١٥ۙ"},{"key":"86:16","surah":86,"ayah":16,"page":596,"text":" وَّاَكِيْدُ كَيْدًا ۝١٦ۚۖ"},{"key":"86:17","surah":86,"ayah":17,"page":596,"text":" فَمَهِّلِ الْكٰفِرِيْنَ اَمْهِلْهُمْ رُوَيْدًا ۝١٧ࣖ"}]