[{"key":"37:30","surah":37,"ayah":30,"page":447,"text":"وَمَا كَانَ لَنَا عَلَيْكُمْ مِّنْ سُلْطٰنٍۚ بَلْ كُنْتُمْ قَوْمًا طٰغِيْنَ ۝٣٠"},{"key":"37:31","surah":37,"ayah":31,"page":447,"text":" فَحَقَّ عَلَيْنَا قَوْلُ رَبِّنَا͏ٓࣗۖ اِنَّا لَذَا࢜ىِٕقُوْنَ ۝٣١"},{"key":"37:32","surah":37,"ayah":32,"page":447,"text":" فَاَغْوَيْنٰكُمْ اِنَّا كُنَّا غٰوِيْنَ ۝٣٢"},{"key":"37:33","surah":37,"ayah":33,"page":447,"text":"فَاِنَّهُمْ يَوْمَىِٕذٍ فِي الْعَذَابِ مُشْتَرِكُوْنَ ۝٣٣"},{"key":"37:34","surah":37,"ayah":34,"page":447,"text":" اِنَّا كَذٰلِكَ نَفْعَلُ بِالْمُجْرِمِيْنَ ۝٣٤"},{"key":"37:35","surah":37,"ayah":35,"page":447,"text":" اِنَّهُمْ كَانُوْٓا اِذَا قِيْلَ لَهُمْ لَا͏ٓ اِلٰهَ اِلَّا اللّٰهُۙ يَسْتَكْبِرُوْنَ ۝٣٥ۙ"},{"key":"37:36","surah":37,"ayah":36,"page":447,"text":"وَيَقُوْلُوْنَ اَىِٕنَّا لَتَارِكُوْٓا اٰلِهَتِنَا لِشَاعِرٍ مَّجْنُوْنٍ ۝٣٦ؕ"},{"key":"37:37","surah":37,"ayah":37,"page":447,"text":" بَلْ جَا࢜ءَ بِالْحَقِّ وَصَدَّقَ الْمُرْسَلِيْنَ ۝٣٧"},{"key":"37:38","surah":37,"ayah":38,"page":447,"text":" اِنَّكُمْ لَذَا࢜ىِٕقُوا الْعَذَابِ الْاَلِيْمِ ۝٣٨ۚ"},{"key":"37:39","surah":37,"ayah":39,"page":447,"text":" وَمَا تُجْزَوْنَ اِلَّا مَا كُنْتُمْ تَعْمَلُوْنَ ۝٣٩ۙ"},{"key":"37:40","surah":37,"ayah":40,"page":447,"text":" اِلَّا عِبَادَ اللّٰهِ الْمُخْلَصِيْنَ ۝٤٠"},{"key":"37:41","surah":37,"ayah":41,"page":447,"text":" اُولٰ࢜ىِٕكَ لَهُمْ رِزْقٌ مَّعْلُوْمٌ ۝٤١ۙ"},{"key":"37:42","surah":37,"ayah":42,"page":447,"text":" فَوَاكِهُۚ وَهُمْ مُّكْرَمُوْنَ ۝٤٢ۙ"},{"key":"37:43","surah":37,"ayah":43,"page":447,"text":" فِيْ جَنّٰتِ النَّعِيْمِ ۝٤٣ۙ"},{"key":"37:44","surah":37,"ayah":44,"page":447,"text":"عَلٰي سُرُرٍ مُّتَقٰبِلِيْنَ ۝٤٤"},{"key":"37:45","surah":37,"ayah":45,"page":447,"text":" يُطَافُ عَلَيْهِمْ بِكَاْسٍ مِّنْ مَّعِيْنٍۭ ۝٤٥ۙ"},{"key":"37:46","surah":37,"ayah":46,"page":447,"text":" بَيْضَا࢜ءَ لَذَّةٍ لِّلشّٰرِبِيْنَ ۝٤٦ۚۖ"},{"key":"37:47","surah":37,"ayah":47,"page":447,"text":" لَا فِيْهَا غَوْلٌ وَّلَا هُمْ عَنْهَا يُنْزَفُوْنَ ۝٤٧"},{"key":"37:48","surah":37,"ayah":48,"page":447,"text":" وَعِنْدَهُمْ قٰصِرٰتُ الطَّرْفِ عِيْنٌ ۝٤٨ۙ"},{"key":"37:49","surah":37,"ayah":49,"page":447,"text":" كَاَنَّهُنَّ بَيْضٌ مَّكْنُوْنٌ ۝٤٩"},{"key":"37:50","surah":37,"ayah":50,"page":447,"text":" فَاَقْبَلَ بَعْضُهُمْ عَلٰي بَعْضٍ يَّتَسَا࢜ءَلُوْنَ ۝٥٠"},{"key":"37:51","surah":37,"ayah":51,"page":447,"text":" قَالَ قَا࢜ىِٕلٌ مِّنْهُمْ اِنِّيْ كَانَ لِيْ قَرِيْنٌ ۝٥١ۙ"},{"key":"37:52","surah":37,"ayah":52,"page":447,"text":"يَّقُوْلُ اَىِٕنَّكَ لَمِنَ الْمُصَدِّقِيْنَ ۝٥٢"},{"key":"37:53","surah":37,"ayah":53,"page":447,"text":" ءَاِذَا مِتْنَا وَكُنَّا تُرَابًا وَّعِظَامًا ءَاِنَّا لَمَدِيْنُوْنَ ۝٥٣"},{"key":"37:54","surah":37,"ayah":54,"page":447,"text":" قَالَ هَلْ اَنْتُمْ مُّطَّلِعُوْنَ ۝٥٤"},{"key":"37:55","surah":37,"ayah":55,"page":447,"text":" فَاطَّلَعَ فَرَاٰهُ فِيْ سَوَا࢜ءِ الْجَحِيْمِ ۝٥٥"},{"key":"37:56","surah":37,"ayah":56,"page":447,"text":" قَالَ تَاللّٰهِ اِنْ كِدْتَّ لَتُرْدِيْنِ ۝٥٦ۙ"}]