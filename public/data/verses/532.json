[{"key":"55:14","surah":55,"ayah":14,"page":532,"text":"خَلَقَ الْاِنْسَانَ مِنْ صَلْصَالٍ كَالْفَخَّارِ ۝١٤ۙ"},{"key":"55:15","surah":55,"ayah":15,"page":532,"text":" وَخَلَقَ الْجَا࢜نَّ مِنْ مَّارِجٍ مِّنْ نَّارٍ ۝١٥ۚ"},{"key":"55:16","surah":55,"ayah":16,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝١٦"},{"key":"55:17","surah":55,"ayah":17,"page":532,"text":" رَبُّ الْمَشْرِقَيْنِ وَرَبُّ الْمَغْرِبَيْنِ ۝١٧ۚ"},{"key":"55:18","surah":55,"ayah":18,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝١٨"},{"key":"55:19","surah":55,"ayah":19,"page":532,"text":" مَرَجَ الْبَحْرَيْنِ يَلْتَقِيٰنِ ۝١٩ۙ"},{"key":"55:20","surah":55,"ayah":20,"page":532,"text":" بَيْنَهُمَا بَرْزَخٌ لَّا يَبْغِيٰنِ ۝٢٠ۚ"},{"key":"55:21","surah":55,"ayah":21,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٢١"},{"key":"55:22","surah":55,"ayah":22,"page":532,"text":"يَخْرُجُ مِنْهُمَا اللُّو͏ٔ͏ْلُو͏ٔ͏ُ وَالْمَرْجَانُ ۝٢٢ۚ"},{"key":"55:23","surah":55,"ayah":23,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٢٣"},{"key":"55:24","surah":55,"ayah":24,"page":532,"text":"وَلَهُ الْجَوَارِ الْمُنْشَـٔ͏ٰتُ فِي الْبَحْرِ كَالْاَعْلَامِ ۝٢٤ۚ"},{"key":"55:25","surah":55,"ayah":25,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٢٥ࣖ"},{"key":"55:26","surah":55,"ayah":26,"page":532,"text":" كُلُّ مَنْ عَلَيْهَا فَانٍ ۝٢٦ۚۖ"},{"key":"55:27","surah":55,"ayah":27,"page":532,"text":" وَّيَبْقٰي وَجْهُ رَبِّكَ ذُو الْجَلٰلِ وَالْاِكْرَامِ ۝٢٧ۚ"},{"key":"55:28","surah":55,"ayah":28,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٢٨"},{"key":"55:29","surah":55,"ayah":29,"page":532,"text":" يَسْـٔ͏َلُهٗ مَنْ فِي السَّمٰوٰتِ وَالْاَرْضِؕ كُلَّ يَوْمٍ هُوَ فِيْ شَاْنٍ ۝٢٩ۚ"},{"key":"55:30","surah":55,"ayah":30,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٣٠"},{"key":"55:31","surah":55,"ayah":31,"page":532,"text":"سَنَفْرُغُ لَكُمْ اَيُّهَ الثَّقَلٰنِ ۝٣١ۚ"},{"key":"55:32","surah":55,"ayah":32,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٣٢"},{"key":"55:33","surah":55,"ayah":33,"page":532,"text":" يٰمَعْشَرَ الْجِنِّ وَالْاِنْسِ اِنِ اسْتَطَعْتُمْ اَنْ تَنْفُذُوْا مِنْ اَقْطَارِ السَّمٰوٰتِ وَالْاَرْضِ فَانْفُذُوْاؕ لَا تَنْفُذُوْنَ اِلَّا بِسُلْطٰنٍ ۝٣٣ۚ"},{"key":"55:34","surah":55,"ayah":34,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٣٤"},{"key":"55:35","surah":55,"ayah":35,"page":532,"text":" يُرْسَلُ عَلَيْكُمَا شُوَاظٌ مِّنْ نَّارٍ࣢ۙ وَّنُحَاسٌ فَلَا تَنْتَصِرٰنِ ۝٣٥ۚ"},{"key":"55:36","surah":55,"ayah":36,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٣٦"},{"key":"55:37","surah":55,"ayah":37,"page":532,"text":" فَاِذَا انْشَقَّتِ السَّمَا࢜ءُ فَكَانَتْ وَرْدَةً كَالدِّهَانِ ۝٣٧ۚ"},{"key":"55:38","surah":55,"ayah":38,"page":532,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٣٨"}]