[{"key":"69:35","surah":69,"ayah":35,"page":569,"text":"فَلَيْسَ لَهُ الْيَوْمَ هٰهُنَا حَمِيْمٌ ۝٣٥ۙ"},{"key":"69:36","surah":69,"ayah":36,"page":569,"text":" وَّلَا طَعَامٌ اِلَّا مِنْ غِسْلِيْنٍ ۝٣٦ۙ"},{"key":"69:37","surah":69,"ayah":37,"page":569,"text":"لَّا يَاْكُلُهٗٓ اِلَّا الْخَاطِـٔ͏ُوْنَ ۝٣٧ࣖ"},{"key":"69:38","surah":69,"ayah":38,"page":569,"text":" فَلَا͏ٓ اُقْسِمُ بِمَا تُبْصِرُوْنَ ۝٣٨ۙ"},{"key":"69:39","surah":69,"ayah":39,"page":569,"text":"وَمَا لَا تُبْصِرُوْنَ ۝٣٩ۙ"},{"key":"69:40","surah":69,"ayah":40,"page":569,"text":" اِنَّهٗ لَقَوْلُ رَسُوْلٍ كَرِيْمٍ ۝٤٠ۚۙ"},{"key":"69:41","surah":69,"ayah":41,"page":569,"text":" وَّمَا هُوَ بِقَوْلِ شَاعِرٍؕ قَلِيْلًا مَّا تُو͏ٔ͏ْمِنُوْنَ ۝٤١ۙ"},{"key":"69:42","surah":69,"ayah":42,"page":569,"text":" وَلَا بِقَوْلِ كَاهِنٍؕ قَلِيْلًا مَّا تَذَكَّرُوْنَ ۝٤٢ؕ"},{"key":"69:43","surah":69,"ayah":43,"page":569,"text":" تَنْزِيْلٌ مِّنْ رَّبِّ الْعٰلَمِيْنَ ۝٤٣"},{"key":"69:44","surah":69,"ayah":44,"page":569,"text":" وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ الْاَقَاوِيْلِ ۝٤٤ۙ"},{"key":"69:45","surah":69,"ayah":45,"page":569,"text":" لَاَخَذْنَا مِنْهُ بِالْيَمِيْنِ ۝٤٥ۙ"},{"key":"69:46","surah":69,"ayah":46,"page":569,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ الْوَتِيْنَ ۝٤٦ؗۖ"},{"key":"69:47","surah":69,"ayah":47,"page":569,"text":" فَمَا مِنْكُمْ مِّنْ اَحَدٍ عَنْهُ حٰجِزِيْنَ ۝٤٧"},{"key":"69:48","surah":69,"ayah":48,"page":569,"text":" وَاِنَّهٗ لَتَذْكِرَةٌ لِّلْمُتَّقِيْنَ ۝٤٨"},{"key":"69:49","surah":69,"ayah":49,"page":569,"text":" وَاِنَّا لَنَعْلَمُ اَنَّ مِنْكُمْ مُّكَذِّبِيْنَ ۝٤٩"},{"key":"69:50","surah":69,"ayah":50,"page":569,"text":" وَاِنَّهٗ لَحَسْرَةٌ عَلَي الْكٰفِرِيْنَ ۝٥٠"},{"key":"69:51","surah":69,"ayah":51,"page":569,"text":" وَاِنَّهٗ لَحَقُّ الْيَقِيْنِ ۝٥١"},{"key":"69:52","surah":69,"ayah":52,"page":569,"text":" فَسَبِّحْ بِاسْمِ رَبِّكَ الْعَظِيْمِ ۝٥٢ࣖ"},{"key":"70:1","surah":70,"ayah":1,"page":569,"text":"سَاَلَ سَا࢜ىِٕلٌۢ بِعَذَابٍ وَّاقِعٍ ۝١ۙ"},{"key":"70:2","surah":70,"ayah":2,"page":569,"text":" لِّلْكٰفِرِيْنَ لَيْسَ لَهٗ دَافِعٌ ۝٢ۙ"},{"key":"70:3","surah":70,"ayah":3,"page":569,"text":" مِّنَ اللّٰهِ ذِي الْمَعَارِجِ ۝٣ؕ"},{"key":"70:4","surah":70,"ayah":4,"page":569,"text":" تَعْرُجُ الْمَلٰ࢜ىِٕكَةُ وَالرُّوْحُ اِلَيْهِ فِيْ يَوْمٍ كَانَ مِقْدَارُهٗ خَمْسِيْنَ اَلْفَ سَنَةٍ ۝٤ۚ"}]