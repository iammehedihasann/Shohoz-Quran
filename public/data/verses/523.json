[{"key":"51:51","surah":51,"ayah":51,"page":523,"text":"وَلَا تَجْعَلُوْا مَعَ اللّٰهِ اِلٰهًا اٰخَرَؕ اِنِّيْ لَكُمْ مِّنْهُ نَذِيْرٌ مُّبِيْنٌ ۝٥١"},{"key":"51:52","surah":51,"ayah":52,"page":523,"text":"كَذٰلِكَ مَا͏ٓ اَتَي الَّذِيْنَ مِنْ قَبْلِهِمْ مِّنْ رَّسُوْلٍ اِلَّا قَالُوْا سَاحِرٌ اَوْ مَجْنُوْنٌ ۝٥٢ۚ"},{"key":"51:53","surah":51,"ayah":53,"page":523,"text":" اَتَوَاصَوْا بِهٖۚ بَلْ هُمْ قَوْمٌ طَاغُوْنَ ۝٥٣ۚ"},{"key":"51:54","surah":51,"ayah":54,"page":523,"text":" فَتَوَلَّ عَنْهُمْ فَمَا͏ٓ اَنْتَ بِمَلُوْمٍ ۝٥٤ࣗؗ"},{"key":"51:55","surah":51,"ayah":55,"page":523,"text":" وَّذَكِّرْ فَاِنَّ الذِّكْرٰي تَنْفَعُ الْمُو͏ٔ͏ْمِنِيْنَ ۝٥٥"},{"key":"51:56","surah":51,"ayah":56,"page":523,"text":" وَمَا خَلَقْتُ الْجِنَّ وَالْاِنْسَ اِلَّا لِيَعْبُدُوْنِ ۝٥٦"},{"key":"51:57","surah":51,"ayah":57,"page":523,"text":" مَا͏ٓ اُرِيْدُ مِنْهُمْ مِّنْ رِّزْقٍ وَّمَا͏ٓ اُرِيْدُ اَنْ يُّطْعِمُوْنِ ۝٥٧"},{"key":"51:58","surah":51,"ayah":58,"page":523,"text":" اِنَّ اللّٰهَ هُوَ الرَّزَّاقُ ذُو الْقُوَّةِ الْمَتِيْنُ ۝٥٨"},{"key":"51:59","surah":51,"ayah":59,"page":523,"text":" فَاِنَّ لِلَّذِيْنَ ظَلَمُوْا ذَنُوْبًا مِّثْلَ ذَنُوْبِ اَصْحٰبِهِمْ فَلَا يَسْتَعْجِلُوْنِ ۝٥٩"},{"key":"51:60","surah":51,"ayah":60,"page":523,"text":"فَوَيْلٌ لِّلَّذِيْنَ كَفَرُوْا مِنْ يَّوْمِهِمُ الَّذِيْ يُوْعَدُوْنَ ۝٦٠ࣖ"},{"key":"52:1","surah":52,"ayah":1,"page":523,"text":"وَالطُّوْرِ ۝١ۙ"},{"key":"52:2","surah":52,"ayah":2,"page":523,"text":" وَكِتٰبٍ مَّسْطُوْرٍ ۝٢ۙ"},{"key":"52:3","surah":52,"ayah":3,"page":523,"text":" فِيْ رَقٍّ مَّنْشُوْرٍ ۝٣ۙ"},{"key":"52:4","surah":52,"ayah":4,"page":523,"text":" وَّالْبَيْتِ الْمَعْمُوْرِ ۝٤ۙ"},{"key":"52:5","surah":52,"ayah":5,"page":523,"text":"وَالسَّقْفِ الْمَرْفُوْعِ ۝٥ۙ"},{"key":"52:6","surah":52,"ayah":6,"page":523,"text":" وَالْبَحْرِ الْمَسْجُوْرِ ۝٦ۙ"},{"key":"52:7","surah":52,"ayah":7,"page":523,"text":" اِنَّ عَذَابَ رَبِّكَ لَوَاقِعٌ ۝٧ۙ"},{"key":"52:8","surah":52,"ayah":8,"page":523,"text":" مَّا لَهٗ مِنْ دَافِعٍ ۝٨ۙ"},{"key":"52:9","surah":52,"ayah":9,"page":523,"text":" يَّوْمَ تَمُوْرُ السَّمَا࢜ءُ مَوْرًا ۝٩ۙ"},{"key":"52:10","surah":52,"ayah":10,"page":523,"text":" وَّتَسِيْرُ الْجِبَالُ سَيْرًا ۝١٠ؕ"},{"key":"52:11","surah":52,"ayah":11,"page":523,"text":" فَوَيْلٌ يَّوْمَىِٕذٍ لِّلْمُكَذِّبِيْنَ ۝١١ۙ"},{"key":"52:12","surah":52,"ayah":12,"page":523,"text":" الَّذِيْنَ هُمْ فِيْ خَوْضٍ يَّلْعَبُوْنَ ۝١٢ۘ"},{"key":"52:13","surah":52,"ayah":13,"page":523,"text":" يَوْمَ يُدَعُّوْنَ اِلٰي نَارِ جَهَنَّمَ دَعًّا ۝١٣ؕ"},{"key":"52:14","surah":52,"ayah":14,"page":523,"text":" هٰذِهِ النَّارُ الَّتِيْ كُنْتُمْ بِهَا تُكَذِّبُوْنَ ۝١٤"}]