[{"key":"55:67","surah":55,"ayah":67,"page":534,"text":"فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٦٧"},{"key":"55:68","surah":55,"ayah":68,"page":534,"text":" فِيْهِمَا فَاكِهَةٌ وَّنَخْلٌ وَّرُمَّانٌ ۝٦٨ۚ"},{"key":"55:69","surah":55,"ayah":69,"page":534,"text":"فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٦٩ۚ"},{"key":"55:70","surah":55,"ayah":70,"page":534,"text":" فِيْهِنَّ خَيْرٰتٌ حِسَانٌ ۝٧٠ۚ"},{"key":"55:71","surah":55,"ayah":71,"page":534,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٧١ۚ"},{"key":"55:72","surah":55,"ayah":72,"page":534,"text":" حُوْرٌ مَّقْصُوْرٰتٌ فِي الْخِيَامِ ۝٧٢ۚ"},{"key":"55:73","surah":55,"ayah":73,"page":534,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٧٣ۚ"},{"key":"55:74","surah":55,"ayah":74,"page":534,"text":" لَمْ يَطْمِثْهُنَّ اِنْسٌ قَبْلَهُمْ وَلَا جَا࢜نٌّ ۝٧٤ۚ"},{"key":"55:75","surah":55,"ayah":75,"page":534,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٧٥"},{"key":"55:76","surah":55,"ayah":76,"page":534,"text":" مُتَّكِـِٕيْنَ عَلٰي رَفْرَفٍ خُضْرٍ وَّعَبْقَرِيٍّ حِسَانٍ ۝٧٦ۚ"},{"key":"55:77","surah":55,"ayah":77,"page":534,"text":" فَبِاَيِّ اٰلَا࢜ءِ رَبِّكُمَا تُكَذِّبٰنِ ۝٧٧"},{"key":"55:78","surah":55,"ayah":78,"page":534,"text":" تَبٰرَكَ اسْمُ رَبِّكَ ذِي الْجَلٰلِ وَالْاِكْرَامِ ۝٧٨ࣖ"},{"key":"56:1","surah":56,"ayah":1,"page":534,"text":"اِذَا وَقَعَتِ الْوَاقِعَةُ ۝١ۙ"},{"key":"56:2","surah":56,"ayah":2,"page":534,"text":" لَيْسَ لِوَقْعَتِهَا كَاذِبَةٌ ۝٢ۘ"},{"key":"56:3","surah":56,"ayah":3,"page":534,"text":" خَافِضَةٌ رَّافِعَةٌ ۝٣ۙ"},{"key":"56:4","surah":56,"ayah":4,"page":534,"text":" اِذَا رُجَّتِ الْاَرْضُ رَجًّا ۝٤ۙ"},{"key":"56:5","surah":56,"ayah":5,"page":534,"text":" وَّبُسَّتِ الْجِبَالُ بَسًّا ۝٥ۙ"},{"key":"56:6","surah":56,"ayah":6,"page":534,"text":"فَكَانَتْ هَبَا࢜ءً مُّنۢ͏ْبَثًّا ۝٦ۙ"},{"key":"56:7","surah":56,"ayah":7,"page":534,"text":" وَّكُنْتُمْ اَزْوَاجًا ثَلٰثَةً ۝٧ؕ"},{"key":"56:8","surah":56,"ayah":8,"page":534,"text":" فَاَصْحٰبُ الْمَيْمَنَةِ࣢ۙ مَا͏ٓ اَصْحٰبُ الْمَيْمَنَةِ ۝٨ؕ"},{"key":"56:9","surah":56,"ayah":9,"page":534,"text":" وَاَصْحٰبُ الْمَشْـٔ͏َمَةِ࣢ۙ مَا͏ٓ اَصْحٰبُ الْمَشْـٔ͏َمَةِ ۝٩ؕ"},{"key":"56:10","surah":56,"ayah":10,"page":534,"text":" وَالسّٰبِقُوْنَ السّٰبِقُوْنَ ۝١٠ۚۙ"},{"key":"56:11","surah":56,"ayah":11,"page":534,"text":" اُولٰ࢜ىِٕكَ الْمُقَرَّبُوْنَ ۝١١ۚ"},{"key":"56:12","surah":56,"ayah":12,"page":534,"text":"فِيْ جَنّٰتِ النَّعِيْمِ ۝١٢"},{"key":"56:13","surah":56,"ayah":13,"page":534,"text":" ثُلَّةٌ مِّنَ الْاَوَّلِيْنَ ۝١٣ۙ"},{"key":"56:14","surah":56,"ayah":14,"page":534,"text":" وَقَلِيْلٌ مِّنَ الْاٰخِرِيْنَ ۝١٤ؕ"},{"key":"56:15","surah":56,"ayah":15,"page":534,"text":" عَلٰي سُرُرٍ مَّوْضُوْنَةٍ ۝١٥ۙ"},{"key":"56:16","surah":56,"ayah":16,"page":534,"text":" مُّتَّكِـِٕيْنَ عَلَيْهَا مُتَقٰبِلِيْنَ ۝١٦"}]