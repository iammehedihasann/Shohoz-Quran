[{"key":"81:8","surah":81,"ayah":8,"page":591,"text":"وَاِذَا الْمَوْءٗدَةُ سُىِٕلَتْ ۝٨ࣕۙ"},{"key":"81:9","surah":81,"ayah":9,"page":591,"text":" بِاَيِّ ذَنۢ͏ْبٍ قُتِلَتْ ۝٩ۚ"},{"key":"81:10","surah":81,"ayah":10,"page":591,"text":" وَاِذَا الصُّحُفُ نُشِرَتْ ۝١٠ࣕۙ"},{"key":"81:11","surah":81,"ayah":11,"page":591,"text":" وَاِذَا السَّمَا࢜ءُ كُشِطَتْ ۝١١ࣕۙ"},{"key":"81:12","surah":81,"ayah":12,"page":591,"text":" وَاِذَا الْجَحِيْمُ سُعِّرَتْ ۝١٢ࣕۙ"},{"key":"81:13","surah":81,"ayah":13,"page":591,"text":"وَاِذَا الْجَنَّةُ اُزْلِفَتْ ۝١٣ࣕۙ"},{"key":"81:14","surah":81,"ayah":14,"page":591,"text":" عَلِمَتْ نَفْسٌ مَّا͏ٓ اَحْضَرَتْ ۝١٤ؕ"},{"key":"81:15","surah":81,"ayah":15,"page":591,"text":" فَلَا͏ٓ اُقْسِمُ بِالْخُنَّسِ ۝١٥ۙ"},{"key":"81:16","surah":81,"ayah":16,"page":591,"text":" الْجَوَارِ الْكُنَّسِ ۝١٦ۙ"},{"key":"81:17","surah":81,"ayah":17,"page":591,"text":" وَالَّيْلِ اِذَا عَسْعَسَ ۝١٧ۙ"},{"key":"81:18","surah":81,"ayah":18,"page":591,"text":"وَالصُّبْحِ اِذَا تَنَفَّسَ ۝١٨ۙ"},{"key":"81:19","surah":81,"ayah":19,"page":591,"text":" اِنَّهٗ لَقَوْلُ رَسُوْلٍ كَرِيْمٍ ۝١٩ۙ"},{"key":"81:20","surah":81,"ayah":20,"page":591,"text":" ذِيْ قُوَّةٍ عِنْدَ ذِي الْعَرْشِ مَكِيْنٍ ۝٢٠ۙ"},{"key":"81:21","surah":81,"ayah":21,"page":591,"text":" مُّطَاعٍ ثَمَّ اَمِيْنٍ ۝٢١ؕ"},{"key":"81:22","surah":81,"ayah":22,"page":591,"text":"وَمَا صَاحِبُكُمْ بِمَجْنُوْنٍ ۝٢٢ۚ"},{"key":"81:23","surah":81,"ayah":23,"page":591,"text":" وَلَقَدْ رَاٰهُ بِالْاُفُقِ الْمُبِيْنِ ۝٢٣ۚ"},{"key":"81:24","surah":81,"ayah":24,"page":591,"text":"وَمَا هُوَ عَلَي الْغَيْبِ بِضَنِيْنٍ ۝٢٤ۚ"},{"key":"81:25","surah":81,"ayah":25,"page":591,"text":" وَمَا هُوَ بِقَوْلِ شَيْطٰنٍ رَّجِيْمٍ ۝٢٥ۙ"},{"key":"81:26","surah":81,"ayah":26,"page":591,"text":" فَاَيْنَ تَذْهَبُوْنَ ۝٢٦ؕ"},{"key":"81:27","surah":81,"ayah":27,"page":591,"text":" اِنْ هُوَ اِلَّا ذِكْرٌ لِّلْعٰلَمِيْنَ ۝٢٧ۙ"},{"key":"81:28","surah":81,"ayah":28,"page":591,"text":"لِمَنْ شَا࢜ءَ مِنْكُمْ اَنْ يَّسْتَقِيْمَ ۝٢٨ؕ"},{"key":"81:29","surah":81,"ayah":29,"page":591,"text":" وَمَا تَشَا࢜ءُوْنَ اِلَّا͏ٓ اَنْ يَّشَا࢜ءَ اللّٰهُ رَبُّ الْعٰلَمِيْنَ ۝٢٩ࣖ"},{"key":"82:1","surah":82,"ayah":1,"page":591,"text":"اِذَا السَّمَا࢜ءُ انْفَطَرَتْ ۝١ۙ"},{"key":"82:2","surah":82,"ayah":2,"page":591,"text":" وَاِذَا الْكَوَاكِبُ انْتَثَرَتْ ۝٢ۙ"},{"key":"82:3","surah":82,"ayah":3,"page":591,"text":" وَاِذَا الْبِحَارُ فُجِّرَتْ ۝٣ۙ"},{"key":"82:4","surah":82,"ayah":4,"page":591,"text":" وَاِذَا الْقُبُوْرُ بُعْثِرَتْ ۝٤ۙ"},{"key":"82:5","surah":82,"ayah":5,"page":591,"text":" عَلِمَتْ نَفْسٌ مَّا قَدَّمَتْ وَاَخَّرَتْ ۝٥ؕ"}]