[{"key":"106:1","surah":106,"ayah":1,"page":608,"text":"لِاِيْلٰفِ قُرَيْشٍ ۝١ۙ"},{"key":"106:2","surah":106,"ayah":2,"page":608,"text":" اٖلٰفِهِمْ رِحْلَةَ الشِّتَا࢜ءِ وَالصَّيْفِ ۝٢ۚ"},{"key":"106:3","surah":106,"ayah":3,"page":608,"text":" فَلْيَعْبُدُوْا رَبَّ هٰذَا الْبَيْتِ ۝٣ۙ"},{"key":"106:4","surah":106,"ayah":4,"page":608,"text":" الَّذِيْٓ اَطْعَمَهُمْ مِّنْ جُوْعٍ࣢ۙ وَّاٰمَنَهُمْ مِّنْ خَوْفٍ ۝٤ࣖ"},{"key":"107:1","surah":107,"ayah":1,"page":608,"text":"اَرَءَيْتَ الَّذِيْ يُكَذِّبُ بِالدِّيْنِ ۝١ؕ"},{"key":"107:2","surah":107,"ayah":2,"page":608,"text":" فَذٰلِكَ الَّذِيْ يَدُعُّ الْيَتِيْمَ ۝٢ۙ"},{"key":"107:3","surah":107,"ayah":3,"page":608,"text":"وَلَا يَحُضُّ عَلٰي طَعَامِ الْمِسْكِيْنِ ۝٣ؕ"},{"key":"107:4","surah":107,"ayah":4,"page":608,"text":" فَوَيْلٌ لِّلْمُصَلِّيْنَ ۝٤ۙ"},{"key":"107:5","surah":107,"ayah":5,"page":608,"text":" الَّذِيْنَ هُمْ عَنْ صَلَاتِهِمْ سَاهُوْنَ ۝٥ۙ"},{"key":"107:6","surah":107,"ayah":6,"page":608,"text":" الَّذِيْنَ هُمْ يُرَا࢜ءُوْنَ ۝٦ۙ"},{"key":"107:7","surah":107,"ayah":7,"page":608,"text":" وَيَمْنَعُوْنَ الْمَاعُوْنَ ۝٧ࣖ"},{"key":"108:1","surah":108,"ayah":1,"page":608,"text":"اِنَّا͏ٓ اَعْطَيْنٰكَ الْكَوْثَرَ ۝١ؕ"},{"key":"108:2","surah":108,"ayah":2,"page":608,"text":" فَصَلِّ لِرَبِّكَ وَانْحَرْ ۝٢ؕ"},{"key":"108:3","surah":108,"ayah":3,"page":608,"text":" اِنَّ شَانِي͏ٔ͏َكَ هُوَ الْاَبْتَرُ ۝٣ࣖ"},{"key":"109:1","surah":109,"ayah":1,"page":608,"text":"قُلْ يٰٓاَيُّهَا الْكٰفِرُوْنَ ۝١ۙ"},{"key":"109:2","surah":109,"ayah":2,"page":608,"text":" لَا͏ٓ اَعْبُدُ مَا تَعْبُدُوْنَ ۝٢ۙ"}]